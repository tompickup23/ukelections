---
/**
 * MiniMap.astro — tiny inline SVG thumbnail showing a single focal area
 * (constituency / council / ward) highlighted in winner colour, with
 * surrounding context features greyed.
 *
 * Server-rendered via d3-geo at build time. Boundaries are pre-loaded
 * from the simplified GeoJSON files in `data/geography/` and indexed
 * by code on first call. Per-build cost: ~2-4 ms per mini-map after
 * the index warms.
 *
 * Props:
 *   focalCode: the ONS code of the focal area (e.g. "E14001063" PCON,
 *              "E07000088" LAD, "E05010000" WD)
 *   focalKind: "pcon" | "lad" | "ward"
 *   focalColour?: CSS colour for the focal fill (defaults to a calm blue)
 *   width / height: SVG viewBox dimensions (default 220x150)
 *   padding: bbox padding multiplier (1.0 = no padding, default 1.18)
 *   ariaLabel: a11y label
 *
 * If the focal code can't be resolved (missing in boundary file), the
 * component returns null gracefully and the calling page just sees no
 * map.
 */
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import { geoMercator, geoPath } from "d3-geo";

// We intentionally don't use d3-geo's `geoBounds` here. ONS simplified
// boundaries ship with clockwise outer-ring winding, which d3-geo's
// spherical bbox calculation interprets as "this polygon covers the
// outside of the planet" — every feature comes back with bbox
// `[[-180,-90],[180,90]]`. A plain coordinate min/max works for our
// neighbour-bbox intersection check.
function flatBbox(feature: any): [number, number, number, number] {
  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
  const visit = (n: any): void => {
    if (typeof n[0] === "number" && typeof n[1] === "number") {
      if (n[0] < x0) x0 = n[0];
      if (n[1] < y0) y0 = n[1];
      if (n[0] > x1) x1 = n[0];
      if (n[1] > y1) y1 = n[1];
      return;
    }
    for (const c of n) visit(c);
  };
  visit(feature.geometry?.coordinates ?? []);
  if (!Number.isFinite(x0)) return [0, 0, 0, 0];
  return [x0, y0, x1, y1];
}

interface Props {
  focalCode?: string;
  focalName?: string;
  focalKind: "pcon" | "lad" | "ward";
  focalColour?: string;
  width?: number;
  height?: number;
  padding?: number;
  ariaLabel?: string;
  /**
   * Optional neighbour delta overlay. When supplied alongside `focalShare`,
   * each neighbour feature is rendered with its own colour band based on
   * `neighbourShares.get(<ons-code>) - focalShare`:
   *   - red band  → neighbour higher (potential opportunity / contagion)
   *   - blue band → neighbour lower (focal is the local high-water mark)
   *   - grey     → no data / within ±neighbourDeltaTolerance of focal
   * Designed for ward maps showing Reform-share differential.
   */
  neighbourShares?: Map<string, number> | Record<string, number> | null;
  focalShare?: number | null;
  neighbourDeltaTolerance?: number;
}

const {
  focalCode,
  focalName,
  focalKind,
  focalColour = "var(--accent-3)",
  width = 220,
  height = 150,
  padding = 1.18,
  ariaLabel,
  neighbourShares = null,
  focalShare = null,
  neighbourDeltaTolerance = 0.02,
} = Astro.props;

function lookupNeighbourShare(code: string): number | undefined {
  if (!neighbourShares) return undefined;
  if (neighbourShares instanceof Map) return neighbourShares.get(code);
  return (neighbourShares as Record<string, number>)[code];
}

// Diverging colour ramp around focalShare. Returns a CSS rgb() string.
// Positive delta (neighbour higher) trends red; negative trends blue;
// within tolerance returns null to keep the neutral grey treatment.
function deltaColour(delta: number, maxAbs: number): string | null {
  if (Math.abs(delta) <= neighbourDeltaTolerance) return null;
  const ratio = Math.min(1, Math.abs(delta) / Math.max(maxAbs, 0.001));
  const eased = Math.pow(ratio, 0.7);
  if (delta > 0) {
    // Red ramp: 245,228,224 -> 193,18,31
    const r = Math.round(245 + (193 - 245) * eased);
    const g = Math.round(228 + (18 - 228) * eased);
    const b = Math.round(224 + (31 - 224) * eased);
    return `rgb(${r}, ${g}, ${b})`;
  }
  // Blue ramp: 224,232,245 -> 29,78,137
  const r = Math.round(224 + (29 - 224) * eased);
  const g = Math.round(232 + (78 - 232) * eased);
  const b = Math.round(245 + (137 - 245) * eased);
  return `rgb(${r}, ${g}, ${b})`;
}

// File registry — code field name + file path per kind
const REGISTRY = {
  pcon: {
    file: "data/geography/pcon24-simplified.geojson",
    codeField: "PCON24CD",
    nameField: "PCON24NM",
  },
  lad: {
    file: "data/geography/lad24-simplified.geojson",
    codeField: "LAD24CD",
    nameField: "LAD24NM",
  },
  ward: {
    file: "data/geography/wd25-simplified.geojson",
    codeField: "WD25CD",
    nameField: "WD25NM",
  },
} as const;

// Module-level cache so the GeoJSON files are loaded + indexed once
// per Astro process, then shared across every per-page invocation.
type GeoCache = {
  features: Array<any>;
  byCode: Map<string, any>;
  byName: Map<string, any>;
};
const _cache = new Map<string, GeoCache>();

function normName(s: string): string {
  return s
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLowerCase()
    .replace(/[,'’]/g, "")
    .replace(/[-‐‑‒–—]/g, " ")
    .replace(/&/g, "and")
    .replace(/\s+/g, " ")
    .trim();
}

function loadCache(kind: keyof typeof REGISTRY): GeoCache | null {
  if (_cache.has(kind)) return _cache.get(kind)!;
  const reg = REGISTRY[kind];
  const p = resolve(process.cwd(), reg.file);
  if (!existsSync(p)) return null;
  const data = JSON.parse(readFileSync(p, "utf8")) as { features: any[] };
  const byCode = new Map<string, any>();
  const byName = new Map<string, any>();
  for (const f of data.features) {
    const code = f?.properties?.[reg.codeField];
    const name = f?.properties?.[reg.nameField];
    if (code) byCode.set(code, f);
    if (name) byName.set(normName(name), f);
  }
  const cache: GeoCache = { features: data.features, byCode, byName };
  _cache.set(kind, cache);
  return cache;
}

const cache = loadCache(focalKind);
let focal: any = null;
if (cache) {
  if (focalCode) focal = cache.byCode.get(focalCode);
  if (!focal && focalName) focal = cache.byName.get(normName(focalName));
}

// If we can't find the focal area, render nothing.
const hasFocal = !!focal;

// Compute focal bbox + expand by `padding` to give the neighbour
// context. Then pick every feature whose bbox intersects.
type Bbox = [number, number, number, number];
function expandBbox(b: Bbox, factor: number): Bbox {
  const [x0, y0, x1, y1] = b;
  const w = x1 - x0;
  const h = y1 - y0;
  const dx = (w * (factor - 1)) / 2;
  const dy = (h * (factor - 1)) / 2;
  return [x0 - dx, y0 - dy, x1 + dx, y1 + dy];
}
function bboxOf(feature: any): Bbox {
  return flatBbox(feature);
}
function bboxIntersects(a: Bbox, b: Bbox): boolean {
  return !(a[2] < b[0] || a[0] > b[2] || a[3] < b[1] || a[1] > b[3]);
}

let pathFocal = "";
let pathContext = "";
type DeltaPath = { d: string; fill: string; code: string };
let deltaPaths: DeltaPath[] = [];
const useDeltaOverlay = !!neighbourShares && typeof focalShare === "number";

if (hasFocal) {
  const focalBbox = expandBbox(bboxOf(focal), padding);

  // Pick context features (excluding focal) whose bbox intersects ours.
  // For ward kind we cap at 80 to keep the SVG svelte.
  const contextFeatures: any[] = [];
  for (const f of cache!.features) {
    if (f === focal) continue;
    const fb = bboxOf(f);
    if (bboxIntersects(focalBbox, fb)) contextFeatures.push(f);
    if (focalKind === "ward" && contextFeatures.length >= 80) break;
  }

  // Fit projection to the expanded bbox.
  const projection = geoMercator().fitExtent(
    [
      [2, 2],
      [width - 2, height - 2],
    ],
    {
      type: "FeatureCollection",
      features: [
        {
          type: "Feature",
          properties: {},
          geometry: {
            type: "Polygon",
            coordinates: [
              [
                [focalBbox[0], focalBbox[1]],
                [focalBbox[2], focalBbox[1]],
                [focalBbox[2], focalBbox[3]],
                [focalBbox[0], focalBbox[3]],
                [focalBbox[0], focalBbox[1]],
              ],
            ],
          },
        },
      ],
    } as any,
  );

  const path = geoPath(projection);
  const kindKey = focalKind as keyof typeof REGISTRY;
  const codeField = REGISTRY[kindKey].codeField;

  if (useDeltaOverlay) {
    // Match a context feature against the neighbour-share map via ONS code
    // first, then fall back to normalised name. Different councils ship
    // identity codes that don't always match the GeoJSON's WD25CD (e.g.
    // councils with no post-2018 review keep older codes in WD25 even
    // though Democracy Club's identity table assigns newer ones).
    const nameField = REGISTRY[kindKey].nameField;
    function resolveShare(f: any): number | undefined {
      const code = f?.properties?.[codeField];
      const direct = code ? lookupNeighbourShare(code) : undefined;
      if (typeof direct === "number") return direct;
      const name = f?.properties?.[nameField];
      if (!name) return undefined;
      return lookupNeighbourShare(`name:${normName(name)}`);
    }

    let maxAbs = 0.05;
    for (const f of contextFeatures) {
      const share = resolveShare(f);
      if (typeof share === "number") {
        const d = share - (focalShare as number);
        if (Math.abs(d) > maxAbs) maxAbs = Math.abs(d);
      }
    }
    for (const f of contextFeatures) {
      const code = f?.properties?.[codeField];
      const d = path(f as any) || "";
      if (!d) continue;
      const share = resolveShare(f);
      const fill =
        typeof share === "number"
          ? (deltaColour(share - (focalShare as number), maxAbs) || "var(--surface-muted)")
          : "var(--surface-muted)";
      deltaPaths.push({ d, fill, code: code || "" });
    }
  } else {
    pathContext = contextFeatures
      .map((f) => path(f as any) || "")
      .filter((d) => d.length > 0)
      .join(" ");
  }

  pathFocal = path(focal as any) || "";
}

const resolvedName = focal?.properties?.[REGISTRY[focalKind as keyof typeof REGISTRY].nameField] || focalCode || focalName;
const a11y = ariaLabel || `Location map showing ${resolvedName} highlighted relative to its neighbours.`;
---

{hasFocal && (
  <figure class="mini-map" aria-label={a11y}>
    <svg
      viewBox={`0 0 ${width} ${height}`}
      preserveAspectRatio="xMidYMid meet"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
    >
      <title>{a11y}</title>
      {useDeltaOverlay
        ? deltaPaths.map((p) => (
            <path
              d={p.d}
              fill={p.fill}
              stroke="var(--border)"
              stroke-width="0.4"
            />
          ))
        : pathContext && (
            <path
              d={pathContext}
              fill="var(--surface-muted)"
              stroke="var(--border)"
              stroke-width="0.4"
            />
          )}
      <path
        d={pathFocal}
        fill={focalColour}
        stroke="rgba(0, 0, 0, 0.5)"
        stroke-width="0.6"
      />
    </svg>
  </figure>
)}
