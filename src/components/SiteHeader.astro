---
import { NAV_GROUPS, type NavGroup } from "../lib/site";
import Search from "./Search.astro";

const pathname = Astro.url.pathname;

function isActiveItem(href: string): boolean {
  return pathname === href || pathname.startsWith(href);
}
function isActiveGroup(group: NavGroup): boolean {
  return group.items.some((item) => isActiveItem(item.href));
}
---

<header class="site-header">
  <div class="site-header-inner">
  <a class="brand" href="/" aria-label="UK Elections home">
    <span class="brand-mark" aria-hidden="true">
      <!-- The estate mark: a marked ballot. A UK ballot is marked with an X,
           not a tick. Parchment on the dark ground, matching the favicon. -->
      <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
        <rect width="64" height="64" rx="12" fill="#0f1317" />
        <rect x="14" y="10" width="36" height="44" rx="5" fill="#e3d9c3" />
        <path d="M24 25l16 16M40 25L24 41" stroke="#0f1317" stroke-width="6.5" stroke-linecap="round" fill="none" />
      </svg>
    </span>
    <span class="brand-copy">
      <span>UK Elections</span>
      <small>Contest data. Forecasts. Backtests.</small>
    </span>
  </a>

  <nav class="site-nav-mega" aria-label="Primary">
    {NAV_GROUPS.map((group) => (
      <details class="mega-group" data-active={isActiveGroup(group) ? "true" : "false"}>
        <summary class="mega-trigger">
          <span>{group.label}</span>
          <span class="mega-caret" aria-hidden="true">
            <svg viewBox="0 0 10 6" width="10" height="6" fill="none">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </summary>
        <div class="mega-panel" role="menu">
          {group.items.map((item) => (
            <a
              href={item.href}
              class="mega-item"
              role="menuitem"
              aria-current={isActiveItem(item.href) ? "page" : undefined}
            >
              <span class="mega-item-label">{item.label}</span>
              <span class="mega-item-desc">{item.desc}</span>
            </a>
          ))}
        </div>
      </details>
    ))}
  </nav>

  <div class="header-extras">
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Switch to light theme"
      title="Toggle light / dark"
    >
      <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
      <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
    <button
      class="mobile-menu-btn"
      type="button"
      data-mobile-menu-toggle
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
    <Search />
  </div>
  </div>
</header>

<div class="mobile-drawer" data-mobile-drawer hidden>
  <div class="mobile-drawer-backdrop" data-mobile-drawer-close></div>
  <nav class="mobile-drawer-panel" aria-label="Mobile navigation">
    <div class="mobile-drawer-head">
      <span class="mobile-drawer-title">Menu</span>
      <button type="button" class="mobile-drawer-close" data-mobile-drawer-close aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
    <div class="mobile-drawer-body">
      {NAV_GROUPS.map((group) => (
        <details class="mobile-group" open={isActiveGroup(group)}>
          <summary class="mobile-group-trigger">
            <span>{group.label}</span>
            <span class="mobile-group-caret" aria-hidden="true">
              <svg viewBox="0 0 10 6" width="10" height="6" fill="none">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <div class="mobile-group-items">
            {group.items.map((item) => (
              <a
                href={item.href}
                class="mobile-group-item"
                aria-current={isActiveItem(item.href) ? "page" : undefined}
              >
                <span class="mobile-item-label">{item.label}</span>
                <span class="mobile-item-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </nav>
</div>

<script>
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>(".site-nav-mega .mega-group"));

  // Close other open mega-menus when one opens.
  groups.forEach((g) => {
    g.addEventListener("toggle", () => {
      if (g.open) {
        groups.forEach((other) => {
          if (other !== g) other.open = false;
        });
      }
    });
  });

  // Close mega-menus on outside click + Escape.
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!groups.some((g) => g.contains(target))) {
      groups.forEach((g) => (g.open = false));
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") groups.forEach((g) => (g.open = false));
  });

  // Mobile drawer toggle.
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
  const drawer = document.querySelector<HTMLDivElement>("[data-mobile-drawer]");
  const closers = document.querySelectorAll<HTMLElement>("[data-mobile-drawer-close]");

  const FOCUSABLE = "a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex='-1'])";

  function openDrawer() {
    if (!drawer) return;
    drawer.removeAttribute("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    drawer.querySelector<HTMLElement>(FOCUSABLE)?.focus();
  }
  function closeDrawer() {
    if (!drawer) return;
    drawer.setAttribute("hidden", "");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    toggle?.focus();
  }

  toggle?.addEventListener("click", openDrawer);
  closers.forEach((c) => c.addEventListener("click", closeDrawer));
  document.addEventListener("keydown", (e) => {
    if (!drawer || drawer.hasAttribute("hidden")) return;
    if (e.key === "Escape") {
      closeDrawer();
      return;
    }
    // Keep Tab inside the open drawer.
    if (e.key === "Tab") {
      const focusables = Array.from(drawer.querySelectorAll<HTMLElement>(FOCUSABLE));
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;
      if (!drawer.contains(active)) {
        e.preventDefault();
        first.focus();
      } else if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Theme toggle (light/dark). Initial value is set pre-paint by the inline
  // script in BaseLayout, so we only handle clicks + persistence here.
  const themeBtns = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  function syncThemeLabel(): void {
    const current = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
    const target = current === "dark" ? "light" : "dark";
    themeBtns.forEach((b) => b.setAttribute("aria-label", `Switch to ${target} theme`));
  }
  syncThemeLabel();
  themeBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const current = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem("uke-theme", next); } catch (_) { /* private mode */ }
      syncThemeLabel();
    });
  });
</script>

<style>
  .site-nav-mega {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .mega-group {
    position: relative;
  }
  .mega-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--muted);
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
    transition: color 180ms, background 180ms;
    user-select: none;
  }
  .mega-trigger::-webkit-details-marker { display: none; }
  .mega-trigger::marker { content: ""; }
  .mega-trigger:hover {
    color: var(--ink);
    background: var(--hover-overlay-soft);
  }
  .mega-group[open] .mega-trigger {
    color: var(--ink);
    background: var(--hover-overlay);
  }
  .mega-group[data-active="true"] .mega-trigger {
    color: var(--ink);
  }
  .mega-group[data-active="true"] .mega-trigger::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0.85rem;
    right: 0.85rem;
    height: 2px;
    border-radius: 1px;
    background: var(--accent);
  }
  .mega-caret {
    display: inline-flex;
    transition: transform 180ms;
    opacity: 0.7;
  }
  .mega-group[open] .mega-caret { transform: rotate(180deg); }

  .mega-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 340px;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem;
    background: var(--panel-bg);
    border: 1px solid var(--panel-border);
    border-radius: 14px;
    box-shadow: var(--panel-shadow);
    z-index: 60;
    animation: megaFadeIn 180ms ease-out;
  }
  /* Right-align the last group's panel so it stays on screen */
  .mega-group:last-of-type .mega-panel {
    left: auto;
    right: 0;
  }

  @keyframes megaFadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mega-item {
    display: block;
    padding: 0.7rem 0.85rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 180ms;
  }
  .mega-item:hover {
    background: var(--hover-overlay-soft);
  }
  .mega-item[aria-current="page"] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .mega-item-label {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink, #111827);
    line-height: 1.2;
  }
  .mega-item[aria-current="page"] .mega-item-label {
    color: var(--accent);
  }
  .mega-item-desc {
    display: block;
    font-size: 0.78rem;
    color: var(--muted, #5b6b80);
    line-height: 1.4;
    margin-top: 0.2rem;
  }

  /* Dark-mode visuals are driven entirely by --hover-overlay / --panel-*
     tokens defined in global.css, which respond to data-theme + system pref. */

  .header-extras {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: nowrap;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: none;
    color: var(--ink-soft, currentColor);
    cursor: pointer;
    border-radius: 10px;
    transition: background 180ms, color 180ms;
  }
  .theme-toggle:hover { background: var(--hover-overlay); color: var(--ink); }
  .theme-toggle .theme-icon { display: none; }
  :root[data-theme="dark"] .theme-toggle .theme-icon--sun { display: inline-block; }
  :root[data-theme="light"] .theme-toggle .theme-icon--moon,
  :root:not([data-theme]) .theme-toggle .theme-icon--moon { display: inline-block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]):not([data-theme="dark"]) .theme-toggle .theme-icon--sun { display: inline-block; }
    :root:not([data-theme="light"]):not([data-theme="dark"]) .theme-toggle .theme-icon--moon { display: none; }
  }
  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: none;
    color: var(--ink-soft, currentColor);
    cursor: pointer;
    border-radius: 10px;
    transition: background 180ms;
  }
  .mobile-menu-btn:hover { background: var(--hover-overlay); }

  @media (max-width: 900px) {
    .site-nav-mega { display: none; }
    .mobile-menu-btn { display: inline-flex; }
  }

  /* Mobile drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;
  }
  .mobile-drawer[hidden] { display: none; }
  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    animation: drawerFadeIn 200ms ease-out;
  }
  .mobile-drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(92vw, 380px);
    background: var(--panel-bg);
    border-left: 1px solid var(--panel-border);
    display: flex;
    flex-direction: column;
    padding: 1rem;
    overflow-y: auto;
    animation: drawerSlideIn 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes drawerFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes drawerSlideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
  .mobile-drawer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border, #e5e7eb);
  }
  .mobile-drawer-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mobile-drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
    border-radius: 8px;
  }
  .mobile-drawer-close:hover { background: var(--hover-overlay); }
  .mobile-drawer-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-group { border-bottom: 1px solid var(--border, #e5e7eb); }
  .mobile-group:last-of-type { border-bottom: none; }
  .mobile-group-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .mobile-group-trigger::-webkit-details-marker { display: none; }
  .mobile-group-caret { transition: transform 180ms; opacity: 0.6; }
  .mobile-group[open] .mobile-group-caret { transform: rotate(180deg); }
  .mobile-group-items {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0 0 0.5rem;
  }
  .mobile-group-item {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
  }
  .mobile-group-item:hover { background: var(--hover-overlay-soft); }
  .mobile-group-item[aria-current="page"] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--accent);
  }
  .mobile-item-label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .mobile-item-desc {
    display: block;
    font-size: 0.76rem;
    color: var(--muted);
    line-height: 1.35;
    margin-top: 0.15rem;
  }
  /* Mobile drawer dark-mode is driven by --panel-bg / --panel-border /
     --hover-overlay tokens above; no separate media query needed. */
</style>
