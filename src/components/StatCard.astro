---
import { ICONS, type IconName } from "../lib/icons";

/**
 * StatCard.astro. a single big-number card with label + optional
 * sparkline / icon / trend annotation. Lucide icon set lives in
 * `src/lib/icons.ts`. keep its list short to bound bundle bytes.
 */
interface Props {
  value: string;
  label: string;
  accent?: string | null;
  trend?: string | null;
  trendDirection?: "up" | "down" | "flat";
  sparkline?: number[] | null;
  sparklineColor?: string | null;
  icon?: IconName | null;
}

const {
  value,
  label,
  accent = null,
  trend = null,
  trendDirection = "flat",
  sparkline = null,
  sparklineColor = "var(--accent-3)",
  icon = null,
} = Astro.props;

const iconSvg = icon ? ICONS[icon] : null;

// Compute sparkline path if data given. Use a fixed viewBox so the
// SVG always sits in a 80×24 box; map data linearly into that range.
function sparklinePath(values: number[]): string {
  if (!values || values.length < 2) return "";
  const W = 80, H = 24, PAD = 2;
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  const innerW = W - PAD * 2;
  const innerH = H - PAD * 2;
  const stepX = innerW / (values.length - 1);
  const points = values.map((v, i) => {
    const x = PAD + i * stepX;
    const y = PAD + innerH - ((v - min) / range) * innerH;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  return `M${points.join(" L")}`;
}

const sparkD = sparkline ? sparklinePath(sparkline) : null;
---

<article class="stat-card">
  {iconSvg && (
    <span
      class="stat-card-icon"
      style={accent ? `color:${accent}` : undefined}
      aria-hidden="true"
      set:html={iconSvg}
    />
  )}
  <span class="stat-card-value" style={accent ? `color:${accent}` : undefined}>
    {value}
  </span>
  {trend && (
    <span
      class={`stat-card-trend ${trendDirection === "up" ? "swing-up" : trendDirection === "down" ? "swing-down" : "swing-flat"}`}
    >
      {trend}
    </span>
  )}
  {sparkD && (
    <svg class="stat-card-spark" viewBox="0 0 80 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d={sparkD} fill="none" stroke={sparklineColor} stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
    </svg>
  )}
  <span class="stat-card-label">{label}</span>
</article>

<style>
  .stat-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    margin-bottom: var(--space-xs, 0.5rem);
    opacity: 0.85;
  }
  .stat-card-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .stat-card-icon :global(svg) path,
  .stat-card-icon :global(svg) circle,
  .stat-card-icon :global(svg) line,
  .stat-card-icon :global(svg) polyline,
  .stat-card-icon :global(svg) rect {
    stroke: currentColor;
  }
</style>
