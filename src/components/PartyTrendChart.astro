---
/**
 * PartyTrendChart.astro. server-rendered SVG line chart of party shares
 * over time, powered by Observable Plot. Renders at build time inside a
 * JSDOM container so the SVG can be inlined into the page (no client JS).
 *
 * Plot earns its keep here: time-proportional X axis for irregular polling
 * ledger snapshots, automatic tick density, and stable margin handling.
 *
 * Props are unchanged from the previous hand-rolled version so callers
 * don't need updates.
 */
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";
import { partyColour } from "../lib/predictions";
import { shortPartyLabel } from "../lib/siteData";

interface Snapshot {
  date: string;
  shares: Record<string, number>;
  polls?: number;
}

interface Props {
  snapshots: Snapshot[];
  parties?: string[];
  width?: number;
  height?: number;
  showAxisLabels?: boolean;
  showLegend?: boolean;
  ariaLabel?: string;
}

const {
  snapshots,
  parties: partiesIn,
  width = 720,
  height = 280,
  showAxisLabels = true,
  showLegend = true,
  ariaLabel = "Line chart of UK Westminster polling shares over time, one line per party",
} = Astro.props;

const latest = snapshots[snapshots.length - 1];
const parties: string[] = partiesIn ??
  Object.entries(latest?.shares || {})
    .sort((a, b) => (b[1] as number) - (a[1] as number))
    .slice(0, 6)
    .map(([party]) => party);

// Long-format rows for Plot.
type Row = { date: Date; party: string; share: number };
const rows: Row[] = [];
for (const s of snapshots) {
  const d = new Date(s.date);
  for (const p of parties) {
    if (typeof s.shares[p] === "number") {
      rows.push({ date: d, party: p, share: s.shares[p] });
    }
  }
}

// Compute ceiling: 5pp above max observed, capped at 50%, snapped to 5pp.
const maxShare = rows.reduce((m, r) => (r.share > m ? r.share : m), 0);
const yCeil = Math.min(0.5, Math.ceil((maxShare + 0.05) * 20) / 20);

// Build a per-party colour map so Plot honours partyColour() exactly.
const colourDomain = parties;
const colourRange = parties.map((p) => partyColour(p));

// Render Plot inside a JSDOM container at build time.
function renderPlotSvg(): string {
  const dom = new JSDOM("<!DOCTYPE html><html><body></body></html>");
  const doc = dom.window.document;
  const chart = Plot.plot({
    document: doc,
    width,
    height,
    marginTop: 14,
    marginRight: 18,
    marginBottom: showAxisLabels ? 38 : 14,
    marginLeft: 50,
    style: { background: "transparent", fontFamily: "Manrope, system-ui, sans-serif", fontSize: "11px" },
    x: {
      type: "time",
      label: null,
      tickFormat: (d: Date) =>
        d.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" }),
      ticks: Math.min(snapshots.length, 8),
    },
    y: {
      domain: [0, yCeil],
      label: null,
      grid: true,
      tickFormat: (v: number) => `${(v * 100).toFixed(0)}%`,
      ticks: Math.round(yCeil / 0.05),
    },
    color: { domain: colourDomain, range: colourRange, legend: false },
    marks: [
      Plot.ruleY([0], { stroke: "currentColor", strokeOpacity: 0.18 }),
      Plot.lineY(rows, {
        x: "date",
        y: "share",
        stroke: "party",
        strokeWidth: 2.4,
        strokeLinejoin: "round",
        strokeLinecap: "round",
        curve: "linear",
      }),
      Plot.dot(rows, {
        x: "date",
        y: "share",
        fill: "party",
        stroke: "var(--surface, #fff)",
        strokeWidth: 1.5,
        r: 3.4,
        title: (r: Row) => `${shortPartyLabel(r.party)} ${(r.share * 100).toFixed(1)}%`,
      }),
    ],
  });
  // Strip any default white background Plot bakes in so the chart inherits the page surface.
  chart.removeAttribute?.("style");
  return chart.outerHTML;
}

const plotSvg = renderPlotSvg();
---

<figure class="party-trend-chart" role="figure" aria-label={ariaLabel}>
  <div class="ptc-plot-wrap" set:html={plotSvg} />

  {showLegend && (
    <figcaption class="party-trend-legend">
      {parties.map((p) => (
        <span class="ptc-legend-item">
          <span class="ptc-legend-swatch" style={`background:${partyColour(p)}`}></span>
          <span class="ptc-legend-name">{shortPartyLabel(p)}</span>
          <span class="ptc-legend-latest">
            {((latest?.shares[p] ?? 0) * 100).toFixed(1)}%
          </span>
        </span>
      ))}
    </figcaption>
  )}
</figure>

<style>
  .party-trend-chart {
    margin: 0;
    color: var(--ink);
  }
  .ptc-plot-wrap :global(svg) {
    width: 100%;
    height: auto;
    color: var(--ink);
    overflow: visible;
  }
  .ptc-plot-wrap :global(text) {
    fill: currentColor;
  }
  .party-trend-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    margin-top: var(--space-sm, 0.75rem);
  }
  .ptc-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-small, 0.88rem);
    color: var(--muted);
  }
  .ptc-legend-swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .ptc-legend-name {
    font-weight: 600;
    color: var(--ink);
  }
  .ptc-legend-latest {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
