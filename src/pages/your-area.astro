---
import lookupCodes from "../../data/identity/parliament-lookup-codes.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadGePredictions, loadIdentity } from "../lib/predictions";
import type { DistrictEntry, LookupEntry } from "../lib/electionLookup";
import { allCouncilRecords, councilNextElection, CALENDAR, NEXT_ELECTIONS_CHECKED_AT, longDate } from "../lib/nextElections";
import { dayLabel } from "../lib/voterJourney";
import type { NationalRow, UpcomingContest } from "../lib/electionLookup";
import { existsSync, readdirSync, readFileSync } from "node:fs";
import path from "node:path";

const identity = loadIdentity();
const ge = loadGePredictions();
type CouncilEntry = LookupEntry & { council_slug: string; tier: string };
const wardIndex: LookupEntry[] = [];
const councils = new Map<string, CouncilEntry>();
for (const w of identity.wards) {
  if (w.tier !== "local" && w.tier !== "mayor") continue;
  if (!w.ward_slug) continue;
  wardIndex.push({
    kind: "ward",
    name: w.ward_name || w.ward_slug,
    secondary: `${w.council_name} ward`,
    href: `/seats/${w.council_slug}/${w.ward_slug}/`,
    code: w.gss_code,
  });
  if (!councils.has(w.council_slug)) {
    councils.set(w.council_slug, {
      kind: "council",
      name: w.council_name,
      secondary: w.tier === "mayor" ? "Mayoralty" : "Local council",
      council_slug: w.council_slug,
      tier: w.tier,
      href: `/seats/${w.council_slug}/`,
    });
  }
}
// Councils with no 7 May 2026 contest have a placeholder page; list them so a
// name search or a postcode in (say) Ribble Valley says what happens next.
const districtIndex: DistrictEntry[] = [];
for (const record of allCouncilRecords()) {
  const next = councilNextElection(record.slug);
  const covered = councils.has(record.slug);
  if (record.lad24cd) {
    districtIndex.push({
      code: record.lad24cd,
      name: record.name,
      href: `/seats/${record.slug}/`,
      covered,
      status: next.status,
      next_label: next.label,
    });
  }
  if (!covered && record.lad24cd) {
    councils.set(record.slug, {
      kind: "council",
      name: record.name,
      secondary: "Council · no forecast yet",
      council_slug: record.slug,
      tier: "none",
      href: `/seats/${record.slug}/`,
    });
  }
}
const councilIndex = [...councils.values()].sort((a, b) => a.name.localeCompare(b.name, "en-GB"));
// Missing boundary codes prevent postcode resolution, not discovery by name.
const constituencyIndex: LookupEntry[] = Object.values(ge.predictions || {})
  .filter((record: any) => Boolean(record?.prediction && record?.slug))
  .map((record: any) => ({
    kind: "constituency" as const,
    name: record.name,
    secondary: "Parliamentary constituency",
    href: `/seats/parliament/${record.slug}/`,
    code: lookupCodes.entries[record.slug as keyof typeof lookupCodes.entries]?.code ?? record.pcon24cd,
  }))
  .sort((a, b) => a.name.localeCompare(b.name, "en-GB"));
// "Is there an election where I live?": upcoming council by-elections by ward
// code, each council's next dated election, and the sourced national calendar.
const contestDir = path.join(process.cwd(), "data/contests/local-byelections");
const buildDay = new Date().toISOString().slice(0, 10);
const byElections: UpcomingContest[] = existsSync(contestDir)
  ? readdirSync(contestDir)
      .filter((f) => f.endsWith(".json") && !f.startsWith("_"))
      .map((f) => JSON.parse(readFileSync(path.join(contestDir, f), "utf8")))
      .filter((d) => d.contest?.ward_gss && d.contest?.polling_day >= buildDay && !d.result?.declared)
      .map((d) => ({
        ward_code: d.contest.ward_gss,
        ward: d.contest.ward_name,
        council: d.contest.council_name,
        date_iso: d.contest.polling_day,
        date_label: dayLabel(d.contest.polling_day),
        href: `/by-elections/local/${d.slug}/`,
      }))
  : [];
const districtDates: Record<string, string | null> = {};
for (const record of allCouncilRecords()) {
  if (record.lad24cd) districtDates[record.lad24cd] = councilNextElection(record.slug).date_iso;
}
const national: Record<string, NationalRow> = {};
for (const row of CALENDAR) {
  if (["general-election", "senedd", "holyrood", "ni-assembly", "london-2028"].includes(row.id)) {
    national[row.id] = { body: row.body, date_iso: row.date_iso, date_label: row.date_label, date_kind: row.date_kind, href: row.href };
  }
}
const indexJson = JSON.stringify({
  byElections,
  districtDates,
  national,
  constituencies: constituencyIndex,
  wards: wardIndex,
  councils: councilIndex,
  districts: districtIndex,
});
---

<BaseLayout title="What is my ward and constituency? UK postcode lookup" description="Enter a UK postcode to find your official council ward and Westminster constituency, or browse all 650 parliamentary seats and the councils we cover without JavaScript.">
  <section class="page-hero">
    <p class="eyebrow">Your Area</p>
    <h1>Find your council ward and constituency</h1>
    <p class="lede">
      Enter a UK postcode to find both your Westminster parliamentary constituency and your local council ward,
      and to see whether there is an election where you live.
      The lookup uses the official area codes returned for that postcode, rather than guessing from a place name.
    </p>
  </section>

  <section class="lookup-shell">
    <form id="lookup-form" autocomplete="off">
      <label for="lookup-input"><strong>Postcode, constituency, council or ward</strong></label>
      <div class="lookup-row">
        <input id="lookup-input" name="lookup" type="search" placeholder="e.g. BB12 6PG, Burnley, or Holborn" autofocus />
        <button type="submit">Find my elections</button>
      </div>
      <p id="lookup-status" class="lookup-status" aria-live="polite"></p>
      <p class="privacy-note">
        Your postcode is sent directly from your browser to <a href="https://postcodes.io/">Postcodes.io</a> to identify the official constituency and ward codes. UK Elections does not store it. <a href="/privacy/">Privacy details</a>.
      </p>
    </form>

    <div id="area-answer" class="area-answer" tabindex="-1" hidden>
      <p class="area-eyebrow">Is there an election where you live?</p>
      <p id="area-headline" class="area-headline"></p>
      <p id="area-detail" class="area-detail"></p>
      <p id="area-action" class="area-action" hidden><a id="area-action-link" href="#"></a></p>
      <h2 class="area-sub">What you vote in here, and when</h2>
      <ol id="area-rows" class="area-rows"></ol>
      <p class="area-foot">
        Dates checked {longDate(NEXT_ELECTIONS_CHECKED_AT)}; each has its source on the <a href="/elections/">election calendar</a>.
        Mayoral, police commissioner and parish elections are not matched to postcodes here yet.
        By-elections are added as they are announced, so this answer can change.
      </p>
    </div>

    <div id="lookup-results" class="lookup-results" hidden>
      <h2 id="lookup-results-heading">Matches</h2>
      <ul id="lookup-results-list"></ul>
      <p id="lookup-results-overflow" hidden></p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">What is my ward?</p>
      <h2>Ward and constituency mean different election areas</h2>
    </div>
    <dl class="area-definitions">
      <div>
        <dt>Council ward</dt>
        <dd>The local area that elects one or more councillors to your local authority. Ward names and boundaries can differ from parliamentary constituencies.</dd>
      </div>
      <div>
        <dt>Parliamentary constituency</dt>
        <dd>The Westminster seat that elects one Member of Parliament. The site uses the current 2024 constituency boundaries.</dd>
      </div>
    </dl>
    <p>
      A postcode may sit near a boundary, so town or council names are not a reliable substitute. The postcode
      tool asks <a href="https://postcodes.io/">Postcodes.io</a> for the official GSS codes and matches those codes
      to this site's election pages. If the service is unavailable, use the static
      <a href="/seats/parliament/"> constituency list</a> or <a href="/councils/">council and ward browser</a>.
    </p>
  </section>

  <section class="section" id="representatives">
    <h2>Who is my MP?</h2>
    <p>Use <a href="https://members.parliament.uk/FindYourMP">Parliament’s official MP finder</a> for the current Member of Parliament and contact details. Forecasts on UK Elections describe possible election outcomes.</p>
    <h2>Who are my councillors?</h2>
    <p><a href="https://www.gov.uk/find-your-local-councillors">Find your local councillors on GOV.UK</a>. The service directs you to your council’s current records.</p>
    <h2>Who is my mayor?</h2>
    <p>Some areas have an elected council or regional mayor; others have a ceremonial mayor. <a href="https://www.gov.uk/find-local-council">Find your council</a> and check its official mayor and combined authority information.</p>
    <h2>When is the next local election?</h2>
    <p>See <a href="/elections/">every body’s next election</a> and <a href="/elections/2027/">the councils voting on 6 May 2027</a>. We give a council’s date only where we have verified it; consult your council’s election notices before making voting plans.</p>
  </section>

  <section class="section browse-paths">
    <div class="section-head">
      <p class="eyebrow">Westminster</p>
      <h2>Browse parliamentary constituencies</h2>
    </div>
    <p>
      All {constituencyIndex.length} constituency pages are available without using the postcode lookup, grouped by nation and region.
    </p>
    <p><a class="button primary" href="/seats/parliament/">Browse all UK constituencies</a></p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Local elections</p>
      <h2>Browse our {councilIndex.length} council and mayoral pages</h2>
    </div>
    <div class="council-grid">
      {councilIndex.map((c) => (
        <a class="council-card" href={c.href}>
          <strong>{c.name}</strong>
          <span class="tier">{c.tier === "mayor" ? "Mayoralty" : "Local council"}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .area-definitions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-md);
    margin: 0 0 var(--space-md);
  }
  .area-definitions div { padding: var(--space-md); border: 1px solid var(--border); border-radius: 10px; }
  .area-definitions dt { font-weight: 700; }
  .area-definitions dd { margin: var(--space-xs) 0 0; color: var(--ink-soft); }
</style>

<script type="application/json" id="search-index" set:html={indexJson} />

<script>
  import { areaAnswer, CERTAINTY_WORD, councilNoticeForPostcode, daysBetween, inDays, resolvePostcodeDestinations, searchElectionLookup } from "../lib/electionLookup";
  import type { AreaAnswer, AreaIndex, LookupEntry, LookupIndex } from "../lib/electionLookup";

  (function () {
    const indexElement = document.getElementById("search-index")!;
    const form = document.getElementById("lookup-form") as HTMLFormElement;
    const input = document.getElementById("lookup-input") as HTMLInputElement;
    const status = document.getElementById("lookup-status")!;
    const resultsRoot = document.getElementById("lookup-results")!;
    const resultsList = document.getElementById("lookup-results-list") as HTMLUListElement;
    const resultsOverflow = document.getElementById("lookup-results-overflow") as HTMLParagraphElement;
    const resultsHeading = document.getElementById("lookup-results-heading")!;
    const data = JSON.parse(indexElement.textContent || "{}") as LookupIndex;

    const answerRoot = document.getElementById("area-answer")!;
    const answerRows = document.getElementById("area-rows") as HTMLOListElement;

    // Today in London, as an ISO date, for "has this polled yet".
    function londonToday(): string {
      return new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/London", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
    }

    function renderAnswer(answer: AreaAnswer | null) {
      answerRoot.hidden = !answer;
      if (!answer) return;
      const today = londonToday();
      answerRoot.dataset.tone = answer.tone;
      document.getElementById("area-headline")!.textContent = answer.headline;
      document.getElementById("area-detail")!.textContent = answer.detail;
      const action = document.getElementById("area-action")!;
      const link = document.getElementById("area-action-link") as HTMLAnchorElement;
      action.hidden = !answer.action;
      if (answer.action) {
        link.href = answer.action.href;
        link.textContent = answer.action.label;
      }
      while (answerRows.firstChild) answerRows.removeChild(answerRows.firstChild);
      answer.rows.forEach(function (row) {
        const li = document.createElement("li");
        li.dataset.certainty = row.certainty;
        const when = document.createElement("span");
        when.className = "area-when";
        when.textContent = row.when;
        const body = document.createElement(row.href ? "a" : "span");
        body.className = "area-body";
        body.textContent = row.body;
        if (row.href) (body as HTMLAnchorElement).href = row.href;
        const tag = document.createElement("span");
        tag.className = "area-tag";
        tag.textContent = CERTAINTY_WORD[row.certainty];
        li.appendChild(when);
        li.appendChild(body);
        li.appendChild(tag);
        // A day count only helps when the date is close.
        if (row.certainty === "fixed" && row.date_iso && row.date_iso >= today && daysBetween(today, row.date_iso) <= 60) {
          const left = document.createElement("span");
          left.className = "area-left";
          left.textContent = inDays(daysBetween(today, row.date_iso));
          li.appendChild(left);
        }
        if (row.note) {
          const note = document.createElement("span");
          note.className = "area-note";
          note.textContent = row.note;
          li.appendChild(note);
        }
        answerRows.appendChild(li);
      });
    }

    const POSTCODE_RE = /^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/i;

    function setStatus(msg: string, isError = false) {
      status.textContent = msg;
      status.className = "lookup-status" + (isError ? " err" : "");
    }

    function renderResults(items: LookupEntry[], heading = "Matches") {
      while (resultsList.firstChild) resultsList.removeChild(resultsList.firstChild);
      resultsRoot.hidden = items.length === 0;
      resultsHeading.textContent = heading;
      const visible = items.slice(0, 12);
      visible.forEach(function (m) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = m.href;
        a.dataset.journey = m.kind === "constituency" ? "your-area-to-constituency" : "your-area-to-local";
        const strong = document.createElement("strong");
        strong.textContent = m.name;
        const detail = document.createElement("span");
        detail.textContent = m.secondary;
        a.appendChild(strong);
        a.appendChild(detail);
        li.appendChild(a);
        resultsList.appendChild(li);
      });
      if (items.length > 12) {
        resultsOverflow.hidden = false;
        resultsOverflow.textContent = "Showing 12 of " + items.length + " matches, refine your search.";
      } else {
        resultsOverflow.hidden = true;
      }
    }

    async function postcodeLookup(postcode: string) {
      setStatus("Looking up postcode " + postcode + "...");
      try {
        const r = await fetch("https://api.postcodes.io/postcodes/" + encodeURIComponent(postcode.replace(/\s+/g, "")));
        if (!r.ok) {
          setStatus("Postcode not found.", true);
          return;
        }
        const body = await r.json();
        const result = body && body.result;
        if (!result) {
          setStatus("Postcode lookup returned no result.", true);
          return;
        }
        const ward = result.admin_ward || "";
        const district = result.admin_district || "";
        renderAnswer(areaAnswer(result, data as unknown as AreaIndex, londonToday()));
        // On a phone the answer lands below the form, so bring it into view
        // and move focus to it for screen reader users.
        answerRoot.focus({ preventScroll: true });
        answerRoot.scrollIntoView({ block: "start", behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        const matches = resolvePostcodeDestinations(result, data);
        const notice = councilNoticeForPostcode(result, data.districts);
        if (notice && !matches.some((m) => m.href.startsWith(notice.entry.href))) matches.push(notice.entry);
        if (matches.length > 0) {
          renderResults(matches, "Your election pages");
          // The answer card above carries the dates; the status line only confirms the match.
          setStatus("Official postcode match: " + [ward, district].filter(Boolean).join(", ") + ".");
        } else {
          renderResults([], "Your election pages");
          setStatus("We found the postcode, but its official constituency and ward codes do not match a page in the current project data.", true);
        }
      } catch {
        setStatus("The postcode service could not be reached. Browse the constituency or council lists below instead.", true);
      }
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const value = (input.value || "").trim();
      if (!value) return;
      if (POSTCODE_RE.test(value)) {
        postcodeLookup(value);
      } else {
        renderAnswer(null);
        const hits = searchElectionLookup(value, data);
        if (hits.length === 1) {
          renderResults(hits, "Match");
          setStatus("1 match");
        } else if (hits.length === 0) {
          setStatus("No matches found. Try a constituency, council, ward or UK postcode.", true);
          renderResults([], "Matches");
        } else {
          setStatus(hits.length + " matches");
          renderResults(hits, "Matches");
        }
      }
    });

    let inputDebounce: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener("input", function () {
      if (inputDebounce) clearTimeout(inputDebounce);
      const value = (input.value || "").trim();
      if (POSTCODE_RE.test(value)) return;
      inputDebounce = setTimeout(function () {
        if (value.length >= 2) {
          const hits = searchElectionLookup(value, data);
          renderResults(hits, "Matches");
          if (hits.length > 0) setStatus(hits.length + " match" + (hits.length === 1 ? "" : "es"));
          else setStatus("");
        } else {
          renderResults([], "Matches");
          setStatus("");
        }
      }, 120);
    });
  })();
</script>

<style>
.lookup-shell { background: var(--surface); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border); margin-top: 1rem; }
.lookup-row { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
.lookup-row input { flex: 1; padding: 0.75rem 1rem; font-size: 1.1rem; border: 1px solid var(--border); border-radius: 6px; }
.lookup-row button { padding: 0.75rem 1.5rem; font-weight: 600; background: var(--accent-3); color: var(--bg); border: 0; border-radius: 6px; cursor: pointer; }
.lookup-row button:hover { background: color-mix(in srgb, var(--accent-3) 85%, #000000); }
.lookup-status { color: var(--muted); margin-top: 0.5rem; min-height: 1.4em; font-size: 0.95rem; }
.lookup-status.err { color: var(--status-bad-text); }
.lookup-results { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); }
/* "Is there an election where I live?" */
.area-answer { margin-top: var(--space-md); padding: var(--space-md); border: 1px solid var(--border); border-radius: 12px; background: var(--accent-wash); }
.area-answer { scroll-margin-top: var(--space-3xl); }
.area-answer:focus { outline: none; }
.area-eyebrow { margin: 0 0 var(--space-xs); font-size: var(--text-eyebrow); letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; color: var(--ink-soft); }
.area-headline { margin: 0; font-size: var(--text-h2); line-height: 1.2; font-weight: 700; }
.area-detail { margin: var(--space-xs) 0 0; font-size: var(--text-h3); line-height: 1.35; }
.area-action { margin: var(--space-sm) 0 0; }
.area-action :global(a) { display: inline-block; padding: var(--space-xs) var(--space-md); border-radius: 8px; background: var(--ink); color: var(--bg); font-weight: 700; text-decoration: none; }
.area-sub { margin: var(--space-lg) 0 var(--space-xs); font-size: var(--text-eyebrow); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); }
.area-rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
.area-rows :global(li) { display: grid; grid-template-columns: 1fr auto; column-gap: var(--space-sm); row-gap: var(--space-2xs); padding: var(--space-sm) 0; border-bottom: 1px solid var(--border); align-items: baseline; }
.area-rows :global(.area-when) { grid-column: 1; font-weight: 700; }
.area-rows :global(.area-left) { grid-column: 2; grid-row: 1; font-size: var(--text-small); font-weight: 700; white-space: nowrap; padding: 0 var(--space-xs); border: 1px solid var(--muted); border-radius: 999px; background: var(--surface); }
.area-rows :global(.area-body) { grid-column: 1 / -1; color: var(--ink); }
.area-rows :global(.area-tag) { grid-column: 1 / -1; width: fit-content; font-size: var(--text-eyebrow); font-weight: 700; padding: 0 var(--space-xs); border: 1.5px solid var(--muted); border-radius: 4px; color: var(--ink-soft); line-height: 1.7; }
.area-rows :global(li[data-certainty="latest"] .area-tag) { border-style: dashed; }
.area-rows :global(li[data-certainty="unverified"] .area-tag),
.area-rows :global(li[data-certainty="none"] .area-tag) { border-style: dotted; }
.area-rows :global(.area-note) { grid-column: 1 / -1; font-size: var(--text-small); color: var(--ink-soft); }
.area-foot { margin: var(--space-sm) 0 0; font-size: var(--text-small); color: var(--ink-soft); }
.lookup-results h2 { font-size: var(--text-h3); }
.lookup-results ul { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.4rem; }
.lookup-results :global(a) { display: block; padding: 0.5rem 0.75rem; border-radius: 6px; background: var(--surface-muted); text-decoration: none; color: var(--ink); }
.lookup-results :global(a:hover) { background: color-mix(in srgb, var(--accent-3) 8%, var(--surface-muted)); }
.lookup-results :global(a strong),
.lookup-results :global(a span) { display: block; }
.lookup-results :global(a span) { margin-top: var(--space-2xs); color: var(--ink-soft); font-size: var(--text-small); }
.privacy-note { margin: var(--space-sm) 0 0; color: var(--ink-soft); font-size: var(--text-small); line-height: 1.5; }
.browse-paths { padding-top: 0; }
.council-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.5rem; margin-top: 0.5rem; }
.council-card { display: block; padding: 0.6rem 0.85rem; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: var(--ink); }
.council-card:hover { border-color: var(--accent-3); }
.council-card .tier { display: block; color: var(--muted); font-size: 0.8rem; margin-top: 0.15rem; }
@media (max-width: 40rem) {
  .lookup-row { flex-direction: column; }
  .lookup-row button { width: 100%; }
}
</style>
