---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadGePredictions, loadIdentity } from "../lib/predictions";
import type { LookupEntry } from "../lib/electionLookup";

const identity = loadIdentity();
const ge = loadGePredictions();
type CouncilEntry = LookupEntry & { council_slug: string; tier: string };
const wardIndex: LookupEntry[] = [];
const councils = new Map<string, CouncilEntry>();
for (const w of identity.wards) {
  if (w.tier !== "local" && w.tier !== "mayor") continue;
  if (!w.ward_slug) continue;
  wardIndex.push({
    kind: "ward",
    name: w.ward_name || w.ward_slug,
    secondary: `${w.council_name} ward`,
    href: `/seats/${w.council_slug}/${w.ward_slug}/`,
    code: w.gss_code,
  });
  if (!councils.has(w.council_slug)) {
    councils.set(w.council_slug, {
      kind: "council",
      name: w.council_name,
      secondary: w.tier === "mayor" ? "Mayoralty" : "Local council",
      council_slug: w.council_slug,
      tier: w.tier,
      href: `/seats/${w.council_slug}/`,
    });
  }
}
const councilIndex = [...councils.values()].sort((a, b) => a.name.localeCompare(b.name, "en-GB"));
const constituencyIndex: LookupEntry[] = Object.values(ge.predictions || {})
  .filter((record: any) => Boolean(record?.prediction && record?.pcon24cd && record?.slug))
  .map((record: any) => ({
    kind: "constituency" as const,
    name: record.name,
    secondary: "Parliamentary constituency",
    href: `/seats/parliament/${record.slug}/`,
    code: record.pcon24cd,
  }))
  .sort((a, b) => a.name.localeCompare(b.name, "en-GB"));
const indexJson = JSON.stringify({
  constituencies: constituencyIndex,
  wards: wardIndex,
  councils: councilIndex,
});
---

<BaseLayout title="What is my ward and constituency? UK postcode lookup" description="Enter a UK postcode to find your official council ward and Westminster constituency, or browse every council and parliamentary seat without JavaScript.">
  <section class="page-hero">
    <p class="eyebrow">Your Area</p>
    <h1>Find your council ward and constituency</h1>
    <p class="lede">
      Enter a UK postcode to find both your Westminster parliamentary constituency and your local council ward.
      The lookup uses the official area codes returned for that postcode, rather than guessing from a place name.
    </p>
  </section>

  <section class="lookup-shell">
    <form id="lookup-form" autocomplete="off">
      <label for="lookup-input"><strong>Postcode, constituency, council or ward</strong></label>
      <div class="lookup-row">
        <input id="lookup-input" name="lookup" type="search" placeholder="e.g. BB12 6PG, Burnley, or Holborn" autofocus />
        <button type="submit">Find my elections</button>
      </div>
      <p id="lookup-status" class="lookup-status" aria-live="polite"></p>
      <p class="privacy-note">
        Your postcode is sent directly from your browser to <a href="https://postcodes.io/">Postcodes.io</a> to identify the official constituency and ward codes. UK Elections does not store it. <a href="/privacy/">Privacy details</a>.
      </p>
    </form>

    <div id="lookup-results" class="lookup-results" hidden>
      <h2 id="lookup-results-heading">Matches</h2>
      <ul id="lookup-results-list"></ul>
      <p id="lookup-results-overflow" hidden></p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">What is my ward?</p>
      <h2>Ward and constituency mean different election areas</h2>
    </div>
    <dl class="area-definitions">
      <div>
        <dt>Council ward</dt>
        <dd>The local area that elects one or more councillors to your local authority. Ward names and boundaries can differ from parliamentary constituencies.</dd>
      </div>
      <div>
        <dt>Parliamentary constituency</dt>
        <dd>The Westminster seat that elects one Member of Parliament. The site uses the current 2024 constituency boundaries.</dd>
      </div>
    </dl>
    <p>
      A postcode may sit near a boundary, so town or council names are not a reliable substitute. The postcode
      tool asks <a href="https://postcodes.io/">Postcodes.io</a> for the official GSS codes and matches those codes
      to this site's election pages. If the service is unavailable, use the static
      <a href="/seats/parliament/"> constituency list</a> or <a href="/councils/">council and ward browser</a>.
    </p>
  </section>

  <section class="section browse-paths">
    <div class="section-head">
      <p class="eyebrow">Westminster</p>
      <h2>Browse parliamentary constituencies</h2>
    </div>
    <p>
      All {constituencyIndex.length} constituency pages are available without using the postcode lookup, grouped by nation and region.
    </p>
    <p><a class="button primary" href="/seats/parliament/">Browse all UK constituencies</a></p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Local elections</p>
      <h2>All {councilIndex.length} councils on the May 7 2026 ballot</h2>
    </div>
    <div class="council-grid">
      {councilIndex.map((c) => (
        <a class="council-card" href={c.href}>
          <strong>{c.name}</strong>
          <span class="tier">{c.tier === "mayor" ? "Mayoralty" : "Local council"}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .area-definitions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-md);
    margin: 0 0 var(--space-md);
  }
  .area-definitions div { padding: var(--space-md); border: 1px solid var(--border); border-radius: 10px; }
  .area-definitions dt { font-weight: 700; }
  .area-definitions dd { margin: var(--space-xs) 0 0; color: var(--ink-soft); }
</style>

<script type="application/json" id="search-index" set:html={indexJson} />

<script>
  import { resolvePostcodeDestinations, searchElectionLookup } from "../lib/electionLookup";
  import type { LookupEntry, LookupIndex } from "../lib/electionLookup";

  (function () {
    const indexElement = document.getElementById("search-index")!;
    const form = document.getElementById("lookup-form") as HTMLFormElement;
    const input = document.getElementById("lookup-input") as HTMLInputElement;
    const status = document.getElementById("lookup-status")!;
    const resultsRoot = document.getElementById("lookup-results")!;
    const resultsList = document.getElementById("lookup-results-list") as HTMLUListElement;
    const resultsOverflow = document.getElementById("lookup-results-overflow") as HTMLParagraphElement;
    const resultsHeading = document.getElementById("lookup-results-heading")!;
    const data = JSON.parse(indexElement.textContent || "{}") as LookupIndex;

    const POSTCODE_RE = /^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/i;

    function setStatus(msg: string, isError = false) {
      status.textContent = msg;
      status.className = "lookup-status" + (isError ? " err" : "");
    }

    function renderResults(items: LookupEntry[], heading = "Matches") {
      while (resultsList.firstChild) resultsList.removeChild(resultsList.firstChild);
      resultsRoot.hidden = items.length === 0;
      resultsHeading.textContent = heading;
      const visible = items.slice(0, 12);
      visible.forEach(function (m) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = m.href;
        a.dataset.journey = m.kind === "constituency" ? "your-area-to-constituency" : "your-area-to-local";
        const strong = document.createElement("strong");
        strong.textContent = m.name;
        const detail = document.createElement("span");
        detail.textContent = m.secondary;
        a.appendChild(strong);
        a.appendChild(detail);
        li.appendChild(a);
        resultsList.appendChild(li);
      });
      if (items.length > 12) {
        resultsOverflow.hidden = false;
        resultsOverflow.textContent = "Showing 12 of " + items.length + " matches, refine your search.";
      } else {
        resultsOverflow.hidden = true;
      }
    }

    async function postcodeLookup(postcode: string) {
      setStatus("Looking up postcode " + postcode + "...");
      try {
        const r = await fetch("https://api.postcodes.io/postcodes/" + encodeURIComponent(postcode.replace(/\s+/g, "")));
        if (!r.ok) {
          setStatus("Postcode not found.", true);
          return;
        }
        const body = await r.json();
        const result = body && body.result;
        if (!result) {
          setStatus("Postcode lookup returned no result.", true);
          return;
        }
        const ward = result.admin_ward || "";
        const district = result.admin_district || "";
        const matches = resolvePostcodeDestinations(result, data);
        if (matches.length > 0) {
          renderResults(matches, "Your election pages");
          setStatus("Official postcode match: " + [ward, district].filter(Boolean).join(", ") + ".");
        } else {
          renderResults([], "Your election pages");
          setStatus("We found the postcode, but its official constituency and ward codes do not match a page in the current project data.", true);
        }
      } catch {
        setStatus("The postcode service could not be reached. Browse the constituency or council lists below instead.", true);
      }
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const value = (input.value || "").trim();
      if (!value) return;
      if (POSTCODE_RE.test(value)) {
        postcodeLookup(value);
      } else {
        const hits = searchElectionLookup(value, data);
        if (hits.length === 1) {
          renderResults(hits, "Match");
          setStatus("1 match");
        } else if (hits.length === 0) {
          setStatus("No matches found. Try a constituency, council, ward or UK postcode.", true);
          renderResults([], "Matches");
        } else {
          setStatus(hits.length + " matches");
          renderResults(hits, "Matches");
        }
      }
    });

    let inputDebounce: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener("input", function () {
      if (inputDebounce) clearTimeout(inputDebounce);
      const value = (input.value || "").trim();
      if (POSTCODE_RE.test(value)) return;
      inputDebounce = setTimeout(function () {
        if (value.length >= 2) {
          const hits = searchElectionLookup(value, data);
          renderResults(hits, "Matches");
          if (hits.length > 0) setStatus(hits.length + " match" + (hits.length === 1 ? "" : "es"));
          else setStatus("");
        } else {
          renderResults([], "Matches");
          setStatus("");
        }
      }, 120);
    });
  })();
</script>

<style>
.lookup-shell { background: var(--surface); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border); margin-top: 1rem; }
.lookup-row { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
.lookup-row input { flex: 1; padding: 0.75rem 1rem; font-size: 1.1rem; border: 1px solid var(--border); border-radius: 6px; }
.lookup-row button { padding: 0.75rem 1.5rem; font-weight: 600; background: var(--accent-3); color: var(--bg); border: 0; border-radius: 6px; cursor: pointer; }
.lookup-row button:hover { background: color-mix(in srgb, var(--accent-3) 85%, #000000); }
.lookup-status { color: var(--muted); margin-top: 0.5rem; min-height: 1.4em; font-size: 0.95rem; }
.lookup-status.err { color: var(--status-bad-text); }
.lookup-results { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); }
.lookup-results h2 { font-size: var(--text-h3); }
.lookup-results ul { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.4rem; }
.lookup-results :global(a) { display: block; padding: 0.5rem 0.75rem; border-radius: 6px; background: var(--surface-muted); text-decoration: none; color: var(--ink); }
.lookup-results :global(a:hover) { background: color-mix(in srgb, var(--accent-3) 8%, var(--surface-muted)); }
.lookup-results :global(a strong),
.lookup-results :global(a span) { display: block; }
.lookup-results :global(a span) { margin-top: var(--space-2xs); color: var(--ink-soft); font-size: var(--text-small); }
.privacy-note { margin: var(--space-sm) 0 0; color: var(--ink-soft); font-size: var(--text-small); line-height: 1.5; }
.browse-paths { padding-top: 0; }
.council-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.5rem; margin-top: 0.5rem; }
.council-card { display: block; padding: 0.6rem 0.85rem; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: var(--ink); }
.council-card:hover { border-color: var(--accent-3); }
.council-card .tier { display: block; color: var(--muted); font-size: 0.8rem; margin-top: 0.15rem; }
@media (max-width: 40rem) {
  .lookup-row { flex-direction: column; }
  .lookup-row button { width: 100%; }
}
</style>
