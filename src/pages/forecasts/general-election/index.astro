---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { buildDataset, type Crumb } from "../../../lib/seo";
import { SITE_URL } from "../../../lib/site";
import CommonsHorseshoe from "../../../components/CommonsHorseshoe.astro";
import ConstituencyChoropleth from "../../../components/ConstituencyChoropleth.astro";
import { loadGePredictions, loadGeSummary, partyColour } from "../../../lib/predictions";
import { loadGeHeadline, shortPartyLabel, forecastStamp } from "../../../lib/siteData";
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const ge = loadGePredictions();
const geSummary = loadGeSummary();
const headline = loadGeHeadline();
const pollingSnapshot = JSON.parse(
  readFileSync(resolve(process.cwd(), "data/polling/override.json"), "utf8"),
);
const pollingMeta = pollingSnapshot.sources?.uk_westminster || {};
const pollingWindow = pollingMeta.fieldwork_window
  ? `${pollingMeta.fieldwork_window.earliest} to ${pollingMeta.fieldwork_window.latest}`
  : headline.polling_window;

const predictions = ge.predictions || {};
const evaluated = Object.values(predictions).filter((p: any) => p?.prediction);
const marginals = evaluated
  .filter((p: any) => p?.majority_pct != null)
  .sort((a: any, b: any) => Math.abs(a.majority_pct) - Math.abs(b.majority_pct))
  .slice(0, 50);

const top = headline.seat_tallies[0];
const second = headline.seat_tallies[1];
const HALFWAY = 326;

// CommonsHorseshoe wants a flat {party: seats} map. Feed it the raw
// summary tallies (includes every party, even those below the top-6
// shown in the bar chart).
const seatTallies = (geSummary.seat_tallies_by_party || {}) as Record<string, number>;
// The per-constituency JSON is served by the published-data allowlist, so the
// Dataset distribution below points at a real, build-verified download.
const breadcrumbs: Crumb[] = [
  { name: "Forecasts", href: "/forecasts/" },
  { name: "General election", href: "/forecasts/general-election/" }
];
const structuredData = [
  buildDataset({
    name: "UK general election seat projection, all 650 constituencies",
    description: `Projected winner, vote share and majority for every one of the ${headline.total_seats} UK parliamentary constituencies, produced from the current named-pollster Westminster average and the 2024 result, and refreshed as new polling lands.`,
    url: `${SITE_URL}/forecasts/general-election/`,
    spatialCoverage: "United Kingdom",
    variableMeasured: [
      "Projected winning party",
      "Projected vote share by party",
      "Projected majority",
      "Forecast confidence band"
    ],
    distributionUrl: `${SITE_URL}/data/predictions/ge-next/constituencies.json`,
    keywords: ["UK general election", "constituency forecast", "opinion polling", "seat projection"]
  })
];
---
<BaseLayout
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
  title="Latest UK opinion polls and general election seat forecast"
  description={`UK general election projection from the latest published polling snapshot: ${top ? `${shortPartyLabel(top.party)} ${top.seats} seats` : "no clear lead"}, with vote shares and all ${headline.total_seats} constituencies.`}
>
  <section class="page-hero">
    <p class="eyebrow">UK opinion polls and seat prediction</p>
    <h1>{top ? `${shortPartyLabel(top.party)} projected to win ${top.seats} seats` : "UK general election seat forecast"}</h1>
    <p class="lede">
      This is a modelled seat projection, not an election result or a poll. It covers all
      {" "}{headline.total_seats.toLocaleString()} UK parliamentary constituencies and was generated
      {" "}<strong>{forecastStamp(headline.generated_at)}</strong>{pollingWindow ? ` from polling fieldwork ${pollingWindow}` : ""}.
      A majority needs <strong>{HALFWAY}</strong> seats. {top && top.seats >= HALFWAY ? `${shortPartyLabel(top.party)} clears the line; ${(top.seats - HALFWAY).toLocaleString()} seats above the majority threshold.` : `${top ? shortPartyLabel(top.party) : "The leading party"} is ${top ? Math.abs(HALFWAY - top.seats).toLocaleString() : "n/a"} short of an overall majority.`}
    </p>
    <p class="meta-row">
      The table below ranks the closest seats. <a href="/seats/parliament/">Browse all {headline.total_seats} constituencies</a>.
    </p>
  </section>

  <section class="section forecast-summary" aria-labelledby="forecast-summary-heading">
    <div class="section-head">
      <p class="eyebrow">Answer first</p>
      <h2 id="forecast-summary-heading">From the latest polls to a 650-seat projection</h2>
    </div>
    <dl>
      <div>
        <dt>Polling evidence</dt>
        <dd>{pollingMeta.polls_used || "n/a"} named-pollster Westminster polls, fieldwork {pollingWindow || "window unavailable"}. <a href="/polling/">Inspect every polling input</a>.</dd>
      </div>
      <div>
        <dt>National vote share</dt>
        <dd>{headline.national_vote_share.slice(0, 3).map((row) => `${shortPartyLabel(row.party)} ${(row.share * 100).toFixed(1)}%`).join(" · ")}. These are modelled national shares.</dd>
      </div>
      <div>
        <dt>Seat projection</dt>
        <dd>{headline.seat_tallies.slice(0, 4).map((row) => `${shortPartyLabel(row.party)} ${row.seats}`).join(" · ")}. Seats are allocated constituency by constituency.</dd>
      </div>
      <div>
        <dt>Constituency forecasts</dt>
        <dd><a href="/seats/parliament/">Browse all {headline.total_seats} seats</a> or <a href="/your-area/">find yours by postcode</a>.</dd>
      </div>
    </dl>
    <p class="muted-row">
      Polling input retrieved {forecastStamp(pollingSnapshot.generated_at)} · Forecast generated {forecastStamp(headline.generated_at)}.
    </p>
  </section>

  <aside class="lookup-cta" aria-labelledby="find-constituency-heading">
    <div>
      <p class="eyebrow">Your seat</p>
      <h2 id="find-constituency-heading">Find your parliamentary constituency</h2>
      <p>Enter a postcode to open the matching Westminster forecast, using the official constituency code.</p>
    </div>
    <a class="button primary" href="/your-area/" data-journey="ge-forecast-to-constituency-lookup">Find my constituency</a>
  </aside>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Every seat coloured by predicted winner</p>
      <h2>The UK political map in this forecast snapshot</h2>
    </div>
    <ConstituencyChoropleth />
    <p class="caption">
      Hover a constituency for its predicted winner and margin. Click to read the full seat forecast.
      Northern Irish coastline and Highland sea-lochs are simplified to keep the file under 250 KB.
      Boundary data sourced from the ONS Open Geography Portal (PCS24 BUC, simplified with mapshaper).
    </p>
  </section>

  <section class="section" id="marginals">
    <div class="section-head">
      <p class="eyebrow">Seats projection</p>
      <h2>How the new House of Commons would look</h2>
    </div>
    <CommonsHorseshoe seats={seatTallies} total={650} majority={HALFWAY} />
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Seat tally, full breakdown</p>
      <h2>Every party with a projected seat</h2>
    </div>
    <div class="party-bars party-bars-large">
      {headline.seat_tallies.map((t) => (
        <div class="bar-row">
          <span class="bar-label">{shortPartyLabel(t.party)}</span>
          <div class="bar-track">
            <div class="bar-fill" style={`width:${(t.share * 100).toFixed(1)}%; background:${partyColour(t.party)}`}></div>
          </div>
          <span class="bar-value">{t.seats.toLocaleString()} <span class="bar-share">({(t.share * 100).toFixed(1)}%)</span></span>
        </div>
      ))}
    </div>
    {top && second && (
      <p class="caption">
        That's a {(top.seats - second.seats).toLocaleString()}-seat lead for {shortPartyLabel(top.party)} over {shortPartyLabel(second.party)}.
      </p>
    )}
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Vote share</p>
      <h2>What share of the national vote each party would get</h2>
    </div>
    <div class="party-bars">
      {headline.national_vote_share.slice(0, 8).map((t) => (
        <div class="bar-row">
          <span class="bar-label">{shortPartyLabel(t.party)}</span>
          <div class="bar-track">
            <div class="bar-fill" style={`width:${(t.share * 100).toFixed(1)}%; background:${partyColour(t.party)}`}></div>
          </div>
          <span class="bar-value">{(t.share * 100).toFixed(1)}%</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Tightest contests</p>
      <h2>Top 50 marginals</h2>
    </div>
    <p class="caption">
      The closest predicted contests on this forecast. These are the seats most likely to flip if the polling moves.
    </p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Top 50 marginal constituencies">
      <table class="seat-table">
        <thead><tr><th>Constituency</th><th>Predicted winner</th><th>Margin</th><th>Country</th></tr></thead>
        <tbody>
          {marginals.map((m: any) => (
            <tr>
              <td><a href={`/seats/parliament/${m.slug}/`}>{m.name}</a></td>
              <td><span class="party-swatch" style={`background:${partyColour(m.winner)}`}></span> {shortPartyLabel(m.winner)}</td>
              <td class="num">{((m.majority_pct ?? 0) * 100).toFixed(1)}pp</td>
              <td>{m.country?.replace(/_/g, " ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="post-data-action">
      <a class="button" href="/your-area/" data-journey="ge-marginals-to-constituency-lookup">Find your seat by postcode</a>
      <a href="/seats/parliament/">Browse all {headline.total_seats} constituencies</a>
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">How accurate</p>
      <h2>Tested against the actual 2024 general election</h2>
    </div>
    <p>
      We replayed the same model against the real 2024 general election using only what a forecaster running the model
      in May 2024 would have known. The model called the winner correctly in
      <strong>{(headline.backtest_winner_accuracy * 100).toFixed(1)}%</strong> of constituencies, with an average gap of
      <strong>{(headline.backtest_major_party_mae * 100).toFixed(2)}pp</strong> between predicted and actual party share.
    </p>
    <p>
      <a href="/data-quality/ge-backtest/">Full accuracy record →</a>
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Caveats</p>
      <h2>What this forecast does and doesn't try to do</h2>
    </div>
    <ul class="plain-list">
      <li><strong>It assumes a notional election held this week</strong>, using current Westminster polling. The next general election may be months or years away; the forecast will move with the polls.</li>
      <li><strong>It does not predict turnout swings</strong> or campaign effects beyond what's already reflected in the polls. Late-campaign movement can be substantial.</li>
      <li><strong>It does not assume tactical voting beyond the pattern observed in 2024.</strong> A formal pact between Labour and the Liberal Democrats, for example, is not modelled.</li>
      <li><strong>Confidence intervals are not yet shown per seat.</strong> A future release will publish a high/low band on each constituency.</li>
    </ul>
    <p class="caption">
      Read the <a href="/methodology/general-election/">general election methodology</a>, see <a href="/polling/">the exact polling numbers feeding the forecast</a>, or <a href="/your-area/">find your parliamentary constituency</a>.
    </p>
    <p class="muted-row">
      Download: <a href="/data/predictions/ge-next/summary.json">national summary JSON</a> ·
      {" "}<a href="/data/predictions/ge-next/constituencies.json">all 650 constituency forecasts</a> ·
      {" "}<a href="/data/predictions/ge-next/assumptions.json">model assumptions</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .lookup-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
    padding: var(--space-lg);
    border-top: 3px solid var(--accent);
    border-bottom: 1px solid var(--border);
    background: var(--surface-muted);
  }

  .lookup-cta h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 600;
  }

  .lookup-cta p:not(.eyebrow) {
    margin: var(--space-xs) 0 0;
    color: var(--ink-soft);
  }

  .lookup-cta .button { flex: 0 0 auto; }

  .post-data-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .forecast-summary dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-md);
    margin: 0;
  }

  .forecast-summary dl div { padding: var(--space-md); border: 1px solid var(--border); border-radius: 10px; }
  .forecast-summary dt { font-weight: 700; }
  .forecast-summary dd { margin: var(--space-xs) 0 0; color: var(--ink-soft); }

  .table-scroll {
    max-width: 100%;
    overflow-x: auto;
  }

  @media (max-width: 40rem) {
    .lookup-cta { align-items: stretch; flex-direction: column; }
    .lookup-cta .button { width: 100%; }
  }
</style>
