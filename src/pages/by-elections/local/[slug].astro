---
import "../../../styles/by-election-details.css";
/**
 * One page per council by-election.
 *
 * Contest files are built by scripts/build-local-byelections.mjs. Every
 * scheduled contest gets a page whether or not it gets a projection: where the
 * baseline will not support a number the page says so and shows the structure
 * instead, which is the precedent set by the Clacton page.
 */
import { localMetadata, isDeclared } from "../../../lib/byElections";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import MiniMap from "../../../components/MiniMap.astro";
import PartyBars from "../../../components/PartyBars.astro";
import ExploreNext from "../../../components/ExploreNext.astro";
import { partyColour } from "../../../lib/predictions";
import { shortPartyLabel } from "../../../lib/siteData";
import { buildLocalContestJourneyLinks } from "../../../lib/electionJourneys";
import { externalHref, buildElectionEvent, type Crumb } from "../../../lib/seo";
import { byElectionResultSummary } from "../../../lib/pageSummaries";
import { SITE_URL } from "../../../lib/site";
import { readdirSync, readFileSync, existsSync } from "node:fs";
import path from "node:path";

const DIR = "data/contests/local-byelections";

export async function getStaticPaths() {
  const dirAbs = path.join(process.cwd(), "data/contests/local-byelections");
  if (!existsSync(dirAbs)) return [];
  const contests = readdirSync(dirAbs)
    .filter((f) => f.endsWith(".json") && !f.startsWith("_"))
    .map((f) => JSON.parse(readFileSync(path.join(dirAbs, f), "utf8")));
  const identityPath = path.join(process.cwd(), "data/identity/wards-may-2026.json");
  const identity = existsSync(identityPath)
    ? JSON.parse(readFileSync(identityPath, "utf8"))
    : { wards: [] };
  const wardHrefByGss = new Map<string, string>();
  for (const ward of identity.wards || []) {
    if (ward.gss_code && ward.council_slug && ward.ward_slug) {
      wardHrefByGss.set(
        ward.gss_code,
        `/seats/${ward.council_slug}/${ward.ward_slug}/`,
      );
    }
  }
  const today = new Date().toISOString().slice(0, 10);
  return contests.map((d) => {
    const wardHref = d.contest?.ward_gss
      ? wardHrefByGss.get(d.contest.ward_gss) || null
      : null;
    return {
      params: { slug: d.slug },
      props: {
        contest: d,
        wardHref,
        relatedLinks: buildLocalContestJourneyLinks(d, contests, today, wardHref),
      },
    };
  });
}

const { contest: d, wardHref, relatedLinks } = Astro.props;
const c = d.contest;
const f = d.field;
const forecast = d.forecast;
const prior = d.prior_result;
const profile = d.ward_profile;
const holder = d.previous_holder;
const result = d.result;

const metaPath = path.join(process.cwd(), DIR, "_meta.json");
const meta = existsSync(metaPath) ? JSON.parse(readFileSync(metaPath, "utf8")) : null;
const bt = meta?.backtest ?? null;

const pct1 = (x: number | null | undefined) => (typeof x === "number" ? (x * 100).toFixed(1) : null);
const pp1 = (x: number | null | undefined) => (typeof x === "number" ? x.toFixed(1) : null);
const prettyDate = (iso: string) =>
  iso ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }) : "";

const { title, description, status: statusLabel } = localMetadata(d);
const declared = isDeclared(d);

const rows = (shares: Record<string, number>) =>
  Object.entries(shares || {})
    .filter(([, v]) => v > 0.0005)
    .sort((a, b) => b[1] - a[1])
    .map(([party, pct]) => ({ party, pct }));

const forecastRows = forecast
  ? rows(forecast.central).map((r) => ({
      ...r,
      annotation:
        forecast.win_probability?.[r.party] !== undefined
          ? `${Math.round(forecast.win_probability[r.party] * 100)}% to win`
          : null,
    }))
  : [];

// The leader is named only where the calibrated probability supports it.
const leader = forecast?.winner ?? null;
const leaderProb = forecast?.leader_probability ?? null;
const tooClose = Boolean(forecast?.too_close_to_call);

// The stratum key is machine-readable; this is the human sentence for it.
function stratumLabel(stratum: string): string {
  const [era, entry] = String(stratum).split("|");
  const eras: Record<string, string> = {
    pre_realignment: "wards last fought before the realignment",
    ge2024_era: "wards last fought around the 2024 general election",
    post_may_2025: "wards last fought since May 2025",
    pooled: "all recent by-elections",
  };
  const base = eras[era] ?? era.replace(/_/g, " ");
  if (!entry) return base;
  return entry === "reform_entering" ? `${base}, Reform standing for the first time` : `${base}, Reform already standing`;
}

// Use the contest's own card as the link preview, but only if it was actually
// rendered. Advertising a card that does not exist is the bug that left every
// page on this site pointing at a missing image, so the check is not optional.
const cardPath = `/cards/by-elections/${d.slug}.png`;
// These are pre-election forecast cards. A declared result must not advertise
// an old forecast as its social preview.
const cardExists = !d.result?.declared && !d.declaration?.declared && existsSync(path.join(process.cwd(), "public", cardPath));

// Composed as one string rather than interleaved JSX expressions, which were
// inserting a space before the comma and before the full stop: "held by
// Independent (Gareth Slater) , who was elected as Labour".
const esc = (x: string) => String(x).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const holderSentence = holder?.established
  ? `The seat was held by <strong>${esc(shortPartyLabel(holder.party))}</strong>` +
    (holder.member ? ` (${esc(holder.member)})` : "") +
    "."
  : "";

// A contest whose winner our source records but whose counts it does not
// publish is declared, not awaited. Saying "result awaited" for three months
// while the winner sits in this page's own candidate list is the version of
// this page that was live until 10 September 2026.
const declaration = d.declaration;
// Who won, by how much, how the shares moved and where the result comes
// from, ahead of the tables: the first thing a reader searching
// "<ward> by-election result" the morning after needs.
const resultSummary = byElectionResultSummary(d);
// Status alone is not enough: a contest file can still read "upcoming" after
// polling day if the overnight refresh missed it.
const pollStillToCome = new Date().toISOString().slice(0, 10) <= c.polling_day;
const structuredData = d.status === "upcoming" && pollStillToCome
  ? [buildElectionEvent({
      name: `${c.ward_name} by-election, ${c.council_name}`,
      description: `Council by-election for ${c.ward_name} ward, ${c.council_name}, on ${prettyDate(c.polling_day)}.`,
      url: `${SITE_URL}/by-elections/local/${d.slug}/`,
      pollingDay: c.polling_day,
      area: c.ward_name,
      authority: c.council_name,
    })]
  : [];

// These generated contest records remain ordinary election information pages.
const breadcrumbs: Crumb[] = [
  { name: "By-elections", href: "/by-elections/" },
  { name: "Council by-elections", href: "/by-elections/local/" },
  { name: `${c.ward_name}, ${c.council_name}`, href: `/by-elections/local/${d.slug}/` }
];
---

<BaseLayout title={title} description={description} image={cardExists ? cardPath : undefined} breadcrumbs={breadcrumbs} structuredData={structuredData}>
  <section class="page-hero compact-hero">
    {c.ward_gss && (
      <div class="mini-map-side">
        <MiniMap
          focalCode={c.ward_gss}
          focalKind="ward"
          focalColour={result?.winner_party ? partyColour(result.winner_party) : leader && !tooClose ? partyColour(leader) : undefined}
          ariaLabel={`Location of ${c.ward_name} ward`}
        />
      </div>
    )}
    <p class="eyebrow">Council by-election, {c.council_name}</p>
    <h1>{c.ward_name} by-election{declared ? " result" : ""}</h1>
    <p class="lede">
      Polling day {prettyDate(c.polling_day)}.
      {!declared && (c.vacancy_reason ? ` The seat is vacant because ${c.vacancy_reason}.` : " The vacancy reason was not published.")}
      {!declared && c.seats_total && c.seats_total > 1 ? ` ${c.ward_name} elects ${c.seats_total} councillors; one seat is being filled.` : ""}
    </p>
    <p class="status-pill">{statusLabel}</p>
    {resultSummary.length > 0 && <p class="result-summary">{resultSummary[0]}</p>}
    <p class="meta-row journey-shortcuts">
      <a href="/by-elections/local/">All council by-elections</a>
      {wardHref && <><span aria-hidden="true"> · </span><a href={wardHref}>Open the {c.ward_name} ward page</a></>}
    </p>
  </section>

  <nav class="detail-nav" aria-label="On this page">
    {declared && <a href="#result">Result</a>}
    <a href="#candidates">Candidates{result?.declared ? " and votes" : ""}</a>
    {!declared && forecast && <a href="#projection">Projection</a>}
    {prior && <a href="#previous-result">Previous result</a>}
    <a href="#sources">Sources</a>
  </nav>

  {declaration?.declared && (
    <section class="card result-card" id="result">
      <h2>The result</h2>
      <p class="result-headline">
        <strong>{declaration.winner_candidate || shortPartyLabel(declaration.winner_party)}</strong>{` elected for ${shortPartyLabel(declaration.winner_party)}.`}
        {declaration.turnout_votes != null && ` Turnout ${declaration.turnout_votes.toLocaleString("en-GB")}${declaration.turnout_pct != null ? ` (${declaration.turnout_pct}%)` : ""}.`}
      </p>
      <p class="note">{declaration.note}</p>
      <p class="note">
        <a href={declaration.source} rel="noopener">The declaration this is taken from</a>.
      </p>
    </section>
  )}

  {result?.declared && (
    <section class="card result-card" id="result">
      <h2>The result</h2>
      {result.outcome && <p class="outcome-line">{result.outcome}</p>}
      <p class="result-headline">
        <strong>{result.winner_candidate || shortPartyLabel(result.winner_party)}</strong>{` elected for ${shortPartyLabel(result.winner_party)}${result.majority_votes != null ? `, a majority of ${result.majority_votes.toLocaleString("en-GB")} over ${shortPartyLabel(result.runner_up_party)}` : ""}.`}
      </p>
      <PartyBars rows={rows(result.shares)} large={true} />
      <p class="note">{result.total_votes.toLocaleString("en-GB")} valid votes across {f.candidate_count} candidates.</p>
      {resultSummary.length > 1 && <p class="note">{resultSummary.slice(1).join(" ")}</p>}
      {result.grading && (
        <p class="grading">
          {result.grading.graded_against === "forecast_as_published" ? "The saved pre-poll forecast said" : "The retrospective model reconstruction selected"} <strong>{shortPartyLabel(result.grading.projected_winner)}</strong>.
          {result.grading.call_correct ? " That matched the winner." : " That did not match the winner."}
          {result.grading.graded_against !== "forecast_as_published" && " No saved pre-poll forecast is available; this is not a published forecast score."}
          {" "}Mean absolute error across the parties standing: {pp1(result.grading.mae_pp)}pp.
        </p>
      )}
    </section>
  )}

  <section class="card" id="candidates">
    <h2>{declared ? "Candidates and results" : "Candidates"}</h2>
    <p class="note">
      {f.locked
        ? `Nominations closed${c.nominations_close ? ` on ${prettyDate(c.nominations_close)}` : ""}. ${f.candidate_count} candidate${f.candidate_count === 1 ? "" : "s"} ${declared ? "stood" : "standing"}.`
        : f.candidate_count === 0
          ? `No candidates have been published yet${c.nominations_close ? `; nominations close on ${prettyDate(c.nominations_close)}` : ""}. This page fills in as they are.`
          : `${f.candidate_count} candidate${f.candidate_count === 1 ? " is" : "s are"} known so far and the field can still change${c.nominations_close ? `, up to ${prettyDate(c.nominations_close)}` : ""}.`}
    </p>
    {f.candidate_count > 0 && (
    <div class="by-election-scroll" role="region" aria-label="Candidate votes and parties" tabindex="0"><table>
      <caption>{declared ? "Declared candidate results" : "Candidates on the ballot"}</caption>
      <thead><tr><th scope="col">Candidate</th><th scope="col">Party</th>{result?.declared && <><th scope="col">Votes</th><th scope="col">Share of valid votes</th></>}</tr></thead>
      <tbody>
        {f.candidates
          .slice()
          .sort((a: any, b: any) => (result?.declared ? (b.votes || 0) - (a.votes || 0) : String(a.name).localeCompare(String(b.name))))
          .map((cand: any) => (
            <tr>
              <td>{cand.name}{declared && cand.elected && <strong class="elected-label"> · Elected</strong>}</td>
              <td><span class="party-chip" style={`--chip:${partyColour(cand.party)}`}>{cand.party_name}</span></td>
              {result?.declared && <><td>{cand.votes?.toLocaleString("en-GB") ?? "Not reported"}</td><td>{typeof cand.votes === "number" && result.total_votes > 0 ? `${pct1(cand.votes / result.total_votes)}%` : "Not reported"}</td></>}
            </tr>
          ))}
      </tbody>
    </table></div>
    )}
    {f.sopn_url && (
      <p class="note"><a href={f.sopn_url} rel="nofollow">Statement of persons nominated</a></p>
    )}
  </section>

  <section class="card holder">
    <h2>{declared ? "Who held the seat before the by-election" : "Who is defending it"}</h2>
    {declared && <p>{c.vacancy_reason ? `The vacancy arose because ${c.vacancy_reason}.` : "The vacancy reason was not published."}{c.seats_total > 1 ? ` ${c.ward_name} elects ${c.seats_total} councillors; one seat was filled.` : ""}</p>}
    {holder?.established ? (
      <>
        <p set:html={holderSentence} />
        {holder.note && <p class="note">{holder.note}</p>}
        {holder.sources?.length > 0 && (
          <p class="note">
            Verified against{" "}
            {holder.sources.map((s: any, i: number) => (
              <>
                {i > 0 ? " and " : ""}
                <a href={s.url} rel="nofollow">{s.label}</a>
              </>
            ))}<span>.</span>
          </p>
        )}
      </>
    ) : (
      <p class="note">{holder?.note}</p>
    )}
  </section>

  {forecast && !declared && (
    <section class="card" id="projection">
      <h2>{tooClose ? "Too close to call" : `${shortPartyLabel(leader)} favoured`}</h2>
      <p class="lede">
        {tooClose
          ? `No party is clearly ahead. The strongest lane is ${shortPartyLabel(leader)} on ${Math.round((leaderProb ?? 0) * 100)}%, which is not enough to name a favourite in a contest this volatile.`
          : `${shortPartyLabel(leader)} wins in ${Math.round((leaderProb ?? 0) * 100)}% of runs, on a projected ${pct1(forecast.central[leader])}%.`}
      </p>
      <PartyBars rows={forecastRows} large={true} />

      <div class="band-detail">
        <h3>Ranges, not point estimates</h3>
        <div class="by-election-scroll" role="region" aria-label="Projected share ranges and winning probabilities" tabindex="0"><table>
<caption>Projected share ranges and winning probabilities</caption>
          <thead>
            <tr><th scope="col">Party</th><th scope="col">Low</th><th scope="col">Central</th><th scope="col">High</th><th scope="col">Wins</th></tr>
          </thead>
          <tbody>
            {forecastRows.map((r) => (
              <tr>
                <td>{shortPartyLabel(r.party)}</td>
                <td>{pct1(forecast.bands?.[r.party]?.p10)}%</td>
                <td>{pct1(forecast.central[r.party])}%</td>
                <td>{pct1(forecast.bands?.[r.party]?.p90)}%</td>
                <td>{Math.round((forecast.win_probability?.[r.party] ?? 0) * 100)}%</td>
              </tr>
            ))}
          </tbody>
        </table></div>
        <p class="note">Low and high are the 10th and 90th percentiles of 4,000 simulated contests.</p>
      </div>

      {bt?.recent && (
        <p class="track-record">
          In the retrospective backtest since May 2025, the method called{" "}
          <strong>{bt.recent.winner_called} of {bt.recent.n}</strong> council by-elections right
          ({Math.round((bt.recent.winner_called_pct ?? 0) * 100)}%), and where the backtest assigned 70% or better
          the backtest was correct about {meta?.calibration_table?.length ? Math.round((meta.calibration_table.at(-1).observed) * 100) : 79}% of the time.
          The full record is <a href="#method">below</a>.
        </p>
      )}

      <h3>What this cannot see</h3>
      <ul class="plain">
        {forecast.cannot_see.map((x: string) => <li>{x}</li>)}
        {forecast.caveats.map((x: string) => <li>{x}</li>)}
      </ul>
    </section>
  )}

  {!forecast && (
    <section class="card no-forecast">
      <h2>{declared ? "No pre-election projection" : "No projection for this contest"}</h2>
      <p>We publish a number when the ward gives us something honest to project from. Here it does not:</p>
      <ul class="plain">
        {(d.no_forecast_reason || []).map((x: string) => <li>{x}</li>)}
      </ul>
      <p class="note">
        The candidates, the vacancy and the ward's history are all below. A missing forecast is a
        statement about the evidence, not about the contest.
      </p>
    </section>
  )}

  {prior && (
    <section class="card" id="previous-result">
      <h2>Last time in this ward</h2>
      <p class="note">
        Ordinary election, {prettyDate(prior.election_date)}.
        {prior.seats_contested && prior.seats_contested > 1
          ? ` ${prior.seats_contested} seats were filled, so shares below are the notional single-seat contest: each party's strongest candidate, normalised.`
          : ""}
        {!prior.usable_as_baseline
          ? " The ward boundary has changed since, so this is context rather than a baseline."
          : ""}
      </p>
      <PartyBars rows={rows(prior.shares)} />
      <p class="note">
        Source: {externalHref(prior.source)
          ? <a href={externalHref(prior.source)} rel="nofollow">{prior.source_label}</a>
          : prior.source_label}
      </p>
    </section>
  )}

  {profile && (
    <section class="card">
      <h2>The ward in numbers</h2>
      <p class="note">
        Census 2021, aggregated from small areas assigned to this ward, with deprivation from IMD 2019. These are best-fit area estimates, not exact ward counts.
        {profile.total_residents ? ` ${profile.total_residents.toLocaleString("en-GB")} residents in the matched Census areas.` : ""}
        {profile.lookup_year && ` Geography lookup: ${profile.lookup_year}.`}
        {" "}Each figure is shown against the median in our England and Wales ward dataset, which includes the boundary versions covered by the source lookups.
      </p>
      <div class="by-election-scroll" role="region" aria-label="Ward demographic comparison" tabindex="0"><table>
<caption>Ward demographic comparison</caption>
        <thead><tr><th scope="col">Measure</th><th scope="col">This ward</th><th scope="col">Median ward</th></tr></thead>
        <tbody>
          {profile.fields.map((row: any) => (
            <tr>
              <td>{row.label}</td>
              <td><strong>{row.is_decile ? row.value.toFixed(1) : `${(row.value * 100).toFixed(1)}%`}</strong></td>
              <td class="muted">
                {row.median === null ? "" : row.is_decile ? row.median.toFixed(1) : `${(row.median * 100).toFixed(1)}%`}
              </td>
            </tr>
          ))}
        </tbody>
      </table></div>
      <p class="note">
        The deprivation decile runs 1 (most deprived tenth of neighbourhoods) to 10 (least), averaged
        across the ward. These figures describe the ward; they are not an input to the projection
        above, which works from votes. <a href="https://www.ons.gov.uk/datasets/TS021/editions/2021/versions/3">ONS Census 2021 population source</a>.
      </p>
    </section>
  )}

  {forecast && (
    <section class="card method" id="method">
      <h2>Method</h2>
      <p>
        One method, never blended. The ward's own last ordinary result, moved by the median swing
        measured across recent council by-elections where we hold the same paired baseline, and
        applied only to the parties actually on this ballot. A party that is not standing scores
        nothing; a party standing here for the first time starts from the share first-time entrants
        actually achieve, which is measured from the same corpus rather than borrowed from national
        polling.
      </p>
      <dl class="method-grid">
        <div><dt>Baseline</dt><dd>{prettyDate(forecast.baseline.election_date)}</dd></div>
        <div><dt>Swing measured from</dt><dd>{forecast.swing.contests_used} by-elections</dd></div>
        <div><dt>Comparison group</dt><dd>{stratumLabel(forecast.swing.stratum)}</dd></div>
        <div><dt>Window</dt><dd>{forecast.swing.window_days} days</dd></div>
      </dl>
      <p>
        The full design, including why the comparison groups are built this way, how the
        probabilities were calibrated against the record, and the evidence the stratification
        beats pooling: <a href="/methodology/local-by-elections/">the council by-election
        methodology</a>.
      </p>

      {bt && (
        <>
          <h3>Retrospective backtest</h3>
          <p>
            Retrospectively tested against council by-elections since {prettyDate(bt.recent_since ?? "2025-05-01")} from
            inputs dated before each poll. These are reconstructed predictions, not a record of forecasts published at the time. Across {bt.recent?.n} contests it called the winner{" "}
            <strong>{bt.recent?.winner_called} times ({Math.round((bt.recent?.winner_called_pct ?? 0) * 100)}%)</strong>{" "}
            with a mean absolute error of <strong>{pp1(bt.recent?.mae_pp)}pp</strong> per party.
            {bt.recent?.confident_n
              ? ` Restricted to the contests it did not call too close, it was right ${bt.recent.confident_called} times out of ${bt.recent.confident_n}.`
              : ""}
          </p>
          <p class="note">
            Council by-elections are the hardest thing on this site to project: small electorates,
            turnout under a quarter, and candidate effects that swamp any national swing. We publish
            the record so the probability on this page can be read for what it is worth.
          </p>
          {meta?.calibration_table?.length > 0 && (
            <div class="by-election-scroll" role="region" aria-label="Retrospective probability calibration" tabindex="0"><table class="calibration">
<caption>Retrospective probability calibration</caption>
              <thead><tr><th scope="col">Backtest probability</th><th scope="col">Contests</th><th scope="col">Average claim</th><th scope="col">We were right</th></tr></thead>
              <tbody>
                {meta.calibration_table.map((b: any) => (
                  <tr>
                    <td>{Math.round(b.from * 100)} to {Math.round(Math.min(b.to, 1) * 100)}%</td>
                    <td>{b.n}</td>
                    <td>{Math.round(b.mean_stated * 100)}%</td>
                    <td>{Math.round(b.observed * 100)}%</td>
                  </tr>
                ))}
              </tbody>
            </table></div>
          )}
        </>
      )}
    </section>
  )}

  <ExploreNext links={relatedLinks} title="Where to go next" eyebrow="Related election pages" />

  <section class="card sources" id="sources">
    <h2>Sources</h2>
    {result?.note && <p class="note"><strong>Result source review, {prettyDate(result.checked_at)}:</strong> {result.note}</p>}
    <ul class="plain">
      {d.sources.map((s: any) => (
        <li><a href={s.url} rel="nofollow">{s.label}</a></li>
      ))}
    </ul>
    <p class="note">
      Contest data from Democracy Club, used under their open licence. Historic ward results from
      Democracy Club and the Local Elections Archive Project.
      <span data-discovery-ignore>Data pipeline run {new Date(d.generated_at).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}.</span>
    </p>
    <p><a href="/by-elections/local/">All council by-elections</a></p>
  </section>
</BaseLayout>

<style>
  .compact-hero { max-width:none; padding-block:var(--space-xl) var(--space-lg); }
  .compact-hero h1 { font-size:var(--text-h1); }
  .compact-hero .lede { font-size:var(--text-body); }
  .detail-nav { display:flex; flex-wrap:wrap; gap:var(--space-md); margin-block:var(--space-lg); }
