---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { partyColour } from "../../lib/predictions";
import { shortPartyLabel } from "../../lib/siteData";
import { readdirSync, readFileSync } from "node:fs";
import path from "node:path";

// Auto-discover every by-election data file (skip the .analysis sidecars).
const dirRel = "data/predictions/by-elections";
const dirAbs = path.join(process.cwd(), dirRel);
const files = readdirSync(dirAbs).filter((f) => f.endsWith(".json") && !f.endsWith(".analysis.json"));

type Card = {
  slug: string;
  name: string;
  pollingDay: string;
  region: string;
  concluded: boolean;
  outcome: string | null;
  winnerParty: string | null;
  winnerCandidate: string | null;
  majorityVotes: number | null;
  marginPp: number | null;
  turnoutPct: number | null;
  predictedWinner: string | null;
  callCorrect: boolean | null;
  forecastHeadline: string | null;
  href: string;
};

const contests: Card[] = files
  .map((f): Card | null => {
    const d = JSON.parse(readFileSync(path.join(dirAbs, f), "utf8"));
    const slug = f.replace(/-\d{4}-\d{2}-\d{2}\.json$/, "");
    const r = d.result || null;
    const predictedWinner = d.forecast?.winner ?? null;
    const winnerParty = r?.winner ?? r?.winner_party ?? null;
    return {
      slug,
      name: d.contest?.constituency_name ?? slug,
      pollingDay: d.contest?.polling_day ?? "",
      region: d.contest?.region ?? d.contest?.region_label ?? "United Kingdom",
      concluded: d.status === "concluded",
      outcome: r?.outcome ?? null,
      winnerParty,
      winnerCandidate: r?.winner_candidate ?? null,
      majorityVotes: r?.majority_votes ?? null,
      marginPp: (r?.margin_pp ?? r?.majority_pp) ?? null,
      turnoutPct: r?.turnout_pct ?? null,
      predictedWinner,
      callCorrect: predictedWinner && winnerParty ? predictedWinner === winnerParty : null,
      forecastHeadline: d.forecast?.headline ?? null,
      href: `/by-elections/${slug}/`,
    };
  })
  .filter((c): c is Card => c !== null)
  .sort((a, b) => b.pollingDay.localeCompare(a.pollingDay));

const concluded = contests.filter((c) => c.concluded);
const upcoming = contests.filter((c) => !c.concluded);

// Local council by-elections roundup (hand-curated, sourced per polling date).
const localData = JSON.parse(
  readFileSync(path.join(process.cwd(), "data/results/local-byelections.json"), "utf8"),
);
type LocalContest = { ward: string; council: string; winner: string; previous: string; share_pct?: number; note?: string };
const localDates: Array<{ date: string; sources: Array<{ label: string; url: string }>; contests: LocalContest[] }> =
  localData.dates || [];
const localAll: LocalContest[] = localDates.flatMap((d) => d.contests);
// Reform scorecard derived from the rows themselves so the numbers always
// match the table.
const refWins = localAll.filter((c) => c.winner.includes("Reform"));
const refGains = refWins.filter((c) => !c.previous.includes("Reform")).length;
const refHolds = refWins.filter((c) => c.previous.includes("Reform")).length;
const refLossRows = localAll.filter((c) => c.previous.includes("Reform") && !c.winner.includes("Reform"));
const refLosses = refLossRows.length;
// Named in the prose from the rows themselves, so the list cannot drift from
// the table underneath it as new rounds land.
const refLossList = refLossRows
  .map((c) => `${c.ward} (${c.council}) to ${shortPartyLabel(c.winner)}`)
  .join(", ");
function prettyDate(iso: string): string {
  return iso ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }) : "";
}

// Cross-seat forecaster leaderboard, computed from each seat's graded benchmarks.
const benchBySlug: Record<string, any[]> = {};
for (const f of files) {
  const d = JSON.parse(readFileSync(path.join(dirAbs, f), "utf8"));
  benchBySlug[f.replace(/-\d{4}-\d{2}-\d{2}\.json$/, "")] = d.benchmarks?.graded || [];
}
const lookup = (slug: string, id: string) => (benchBySlug[slug] || []).find((b) => b.id === id) || null;

// Collapse the 5 Makerfield polls into one seat-level entry (1 seat, mean MAE),
// then add Clacton's single constituency poll as a second seat.
const makPolls = (benchBySlug["makerfield"] || []).filter((b) => b.type === "poll");
const pollsSeat = [
  ...(makPolls.length
    ? [{ winner_correct: makPolls.every((p) => p.winner_correct), mae_pp: makPolls.reduce((a, b) => a + b.mae_pp, 0) / makPolls.length }]
    : []),
  lookup("clacton", "survation_poll"),
].filter(Boolean);

type Lead = { name: string; hits: number; total: number; avgMae: number | null; note: string };
const leaderboard: Lead[] = [
  { name: "Constituency polls", picks: pollsSeat, note: "Makerfield (5 polls, all agreed) and Clacton (1)" },
  { name: "UK Elections (best call)", picks: [lookup("makerfield", "uke_poll_of_polls"), lookup("aberdeen-south", "uke_signal"), lookup("arbroath-and-broughty-ferry", "uke_signal"), lookup("clacton", "uke_call")], note: "poll-of-polls, Holyrood signal, Clacton structural call" },
  { name: "UK Elections (GE model)", picks: [lookup("makerfield", "uke_ge_model"), lookup("aberdeen-south", "uke_ge_model"), lookup("arbroath-and-broughty-ferry", "uke_ge_model")], note: "650-seat GE model, like Electoral Calculus" },
  { name: "Betting markets", picks: [lookup("makerfield", "betting_markets"), lookup("aberdeen-south", "betting_markets"), lookup("arbroath-and-broughty-ferry", "betting_markets")], note: "odds-implied favourite" },
  { name: "Electoral Calculus", picks: [lookup("makerfield", "electoral_calculus"), lookup("aberdeen-south", "electoral_calculus"), lookup("arbroath-and-broughty-ferry", "electoral_calculus")], note: "GE seat model, not bespoke" },
  { name: "Ballot Box Scotland", picks: [lookup("aberdeen-south", "ballot_box_scotland"), lookup("arbroath-and-broughty-ferry", "ballot_box_scotland")], note: "Scottish seats, qualitative" },
  { name: "UK Elections (published forecast)", picks: [lookup("makerfield", "uke_published"), lookup("clacton", "uke_call")], note: "the call we actually shipped" },
].map((row) => {
  const picks = row.picks.filter(Boolean);
  const maes = picks.filter((p) => p.mae_pp != null).map((p) => p.mae_pp);
  return {
    name: row.name,
    hits: picks.filter((p) => p.winner_correct).length,
    total: picks.length,
    avgMae: maes.length ? maes.reduce((a: number, b: number) => a + b, 0) / maes.length : null,
    note: row.note,
  };
}).sort((a, b) => (b.hits / Math.max(b.total, 1)) - (a.hits / Math.max(a.total, 1)) || (a.avgMae ?? 9) - (b.avgMae ?? 9));
---

<BaseLayout
  title="UK parliamentary by-elections. Results, forecasts and what's next"
  description="UK Westminster by-election results and how our forecasts compared. Clacton on 13 August 2026: Reform hold, Farage returned on 63.3% with turnout at 44.4%. Plus the 18 June 2026 round and a rolling local council by-election scorecard."
>
  <section class="hero">
    <p class="eyebrow">By-elections</p>
    <h1>Westminster by-elections</h1>
    <p class="lede">
      Every by-election we track, the declared result, and how the pre-election forecast or
      signal compared. {concluded.length} concluded contest{concluded.length === 1 ? "" : "s"}{upcoming.length > 0 ? `, ${upcoming.length} upcoming` : ""}.
    </p>
  </section>

  <section class="section">
    <div class="byelection-grid">
      {contests.map((c) => (
        <a class="byelection-card" href={c.href}>
          <div class="byelection-card-head">
            <span class="byelection-date">{prettyDate(c.pollingDay)}</span>
            {c.callCorrect !== null && (
              <span class={c.callCorrect ? "call-tag call-tag--ok" : "call-tag call-tag--miss"}>
                {c.callCorrect ? "forecast ✓" : "forecast ✗"}
              </span>
            )}
          </div>
          <h2>{c.name}</h2>
          <p class="byelection-region">{c.region}</p>
          {c.concluded && c.winnerParty ? (
            <div class="byelection-result">
              <span class="party-pill" style={`background:${partyColour(c.winnerParty)}`}></span>
              <span class="byelection-outcome">{c.outcome}</span>
              <span class="byelection-meta">
                {c.winnerCandidate}{c.marginPp != null ? ` · +${(c.marginPp * 100).toFixed(1)}pp` : ""}{c.turnoutPct != null ? ` · turnout ${(c.turnoutPct * 100).toFixed(1)}%` : ""}
              </span>
            </div>
          ) : (
            <p class="byelection-meta">{c.forecastHeadline || "Forecast pending"}</p>
          )}
          {c.predictedWinner && c.callCorrect === false && (
            <p class="byelection-call">Pre-election call: <strong>{shortPartyLabel(c.predictedWinner)}</strong> · the result went the other way.</p>
          )}
          {c.predictedWinner && c.callCorrect === true && (
            <p class="byelection-call">Pre-election call: <strong>{shortPartyLabel(c.predictedWinner)}</strong> · called correctly.</p>
          )}
          <span class="byelection-link">{c.concluded ? "Read the result and scorecard →" : "Read the contest briefing →"}</span>
        </a>
      ))}
    </div>
    <p class="caption">
      Clacton, on 13 August 2026, went as called: Nigel Farage resigned, re-contested his own seat
      against a five-party boycott and was returned on 63.3% of the vote, with turnout down to
      44.4%. The 18 June 2026 round was a split verdict: Labour held Makerfield (Andy Burnham) against a UKE forecast that wrongly
      called Reform; the Conservatives gained Aberdeen South in an upset no area signal saw
      coming; and the SNP held Arbroath and Broughty Ferry exactly as the Holyrood signal
      predicted.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Leaderboard · who called it best</p>
      <h2>Forecaster accuracy, 18 June 2026</h2>
    </div>
    <table class="seat-table">
      <thead>
        <tr>
          <th>Forecaster</th>
          <th class="num">Winners right</th>
          <th class="num">Avg share MAE</th>
          <th>Coverage</th>
        </tr>
      </thead>
      <tbody>
        {leaderboard.map((row) => (
          <tr>
            <td>{row.name}</td>
            <td class="num"><strong>{row.hits}/{row.total}</strong></td>
            <td class="num">{row.avgMae != null ? (row.avgMae * 100).toFixed(1) + "pp" : <span class="muted">n/a</span>}</td>
            <td class="muted">{row.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="caption">
      Where real constituency polls existed (Makerfield only), they beat every model. The two seat
      models that ignore polls (our published forecast and Electoral Calculus) called Makerfield for
      Reform, wrongly. On the two Scottish seats no one polled, and Aberdeen South's Conservative gain
      beat the entire field. Avg share MAE is across the seats each forecaster issued a numeric call on
      (markets and Ballot Box Scotland gave winners only). Electoral Calculus's figures are its
      standard general-election seat model, not bespoke by-election forecasts.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Local council by-elections · {localData.window.from} to {localData.window.to}</p>
      <h2>The weekly ward scorecard</h2>
    </div>
    <p class="local-pointer">
      Every scheduled council by-election now has its own page, with the candidates, the ward's last
      result and a projection where the ward supports one:
      <a href="/by-elections/local/">council by-elections</a>.
    </p>
    <p>
      Westminster by-elections are rare; council by-elections happen most Thursdays and are the
      highest-frequency real-vote signal between general elections. Across the
      {localAll.length} ward contests since {prettyDate(localData.window.from)}, Reform UK made
      <strong>{refGains} gain{refGains === 1 ? "" : "s"}</strong>, held
      <strong>{refHolds}</strong> of its own seats and lost
      <strong>{refLosses}</strong>: {refLossList}. Three of those losses came in the four weeks to
      13 August: both Grays seats in Thurrock, on a night Labour took back seats that Reform
      councillors elected in May had vacated within weeks, and Almondbury in Kirklees, where the
      Liberal Democrats won back one of the three seats Reform had swept three months earlier.
      Reform is still gaining, mostly from the Conservatives, and it is now also losing what it
      defends. That mean-reversion is exactly why our Lancashire unitary model swings each ward off
      the 2025 county result rather than freezing it. The gains came off Labour, the Conservatives
      and independents across England, Wales and, notably, Scotland (Larkhall, South Lanarkshire,
      under STV).
    </p>
    {localData.pending_note && <p class="muted">{localData.pending_note}</p>}
    {localDates.map((d) => (
      <details class="local-date">
        <summary>
          <strong>{prettyDate(d.date)}</strong> · {d.contests.length} contest{d.contests.length === 1 ? "" : "s"}
          · Reform {d.contests.filter((c) => c.winner.includes("Reform")).length} win{d.contests.filter((c) => c.winner.includes("Reform")).length === 1 ? "" : "s"}
        </summary>
        <table class="seat-table">
          <thead><tr><th>Ward</th><th>Council</th><th>Winner</th><th>Previously</th><th>Notes</th></tr></thead>
          <tbody>
            {d.contests.map((c) => (
              <tr>
                <td>{c.ward}</td>
                <td class="muted">{c.council}</td>
                <td>
                  <span class="party-pill" style={`background:${partyColour(c.winner.split(" / ")[0])}`}></span>
                  {c.winner}{c.share_pct != null ? ` (${c.share_pct.toFixed(1)}%)` : ""}
                </td>
                <td class="muted">{c.previous}</td>
                <td class="muted">{c.note || ""}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="caption">
          Sources: {d.sources.map((s, i) => (
            <>{i > 0 ? " · " : ""}<a href={s.url} rel="external">{s.label}</a></>
          ))}
        </p>
      </details>
    ))}
    <p class="caption">{localData.method_note}</p>
  </section>

  <style>
    .byelection-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap:1.25rem; }
    .byelection-card { display:block; padding:1.25rem 1.4rem; border:1px solid var(--border); border-radius:16px; background:var(--panel-bg); text-decoration:none; color:inherit; transition: border-color .15s, transform .15s; }
    .byelection-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    .byelection-card-head { display:flex; justify-content:space-between; align-items:center; gap:0.5rem; }
    .byelection-date { font-size:0.78rem; color:var(--muted); letter-spacing:0.02em; }
    .byelection-card h2 { margin:0.5rem 0 0.1rem; font-size:1.3rem; }
    .byelection-region { margin:0; color:var(--muted); font-size:0.85rem; }
    .byelection-result { display:flex; align-items:center; flex-wrap:wrap; gap:0.4rem; margin:0.75rem 0 0.25rem; }
    .byelection-outcome { font-weight:600; }
    .byelection-meta { color:var(--muted); font-size:0.85rem; }
    .byelection-call { margin:0.4rem 0 0; font-size:0.85rem; }
    .local-date { margin:0.75rem 0; border:1px solid var(--border); border-radius:12px; padding:0.6rem 1rem; background:var(--panel-bg); }
    .local-date summary { cursor:pointer; padding:0.35rem 0; }
    .local-date[open] summary { border-bottom:1px solid var(--border); margin-bottom:0.6rem; }
    .local-date .seat-table { margin-top:0.5rem; }
    .byelection-link { display:inline-block; margin-top:0.75rem; color:var(--accent); font-weight:600; font-size:0.9rem; }
    .call-tag { font-size:0.7rem; font-weight:600; padding:0.15rem 0.5rem; border-radius:999px; }
    .call-tag--ok { color:var(--accent-2); background: color-mix(in srgb, var(--accent-2) 12%, transparent); }
    .call-tag--miss { color:var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  </style>
</BaseLayout>
