---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { partyColour } from "../../lib/predictions";
import { shortPartyLabel } from "../../lib/siteData";
import { readdirSync, readFileSync } from "node:fs";
import path from "node:path";

// Auto-discover every by-election data file (skip the .analysis sidecars).
const dirRel = "data/predictions/by-elections";
const dirAbs = path.join(process.cwd(), dirRel);
const files = readdirSync(dirAbs).filter((f) => f.endsWith(".json") && !f.endsWith(".analysis.json"));

type Card = {
  slug: string;
  name: string;
  pollingDay: string;
  region: string;
  concluded: boolean;
  outcome: string | null;
  winnerParty: string | null;
  winnerCandidate: string | null;
  majorityVotes: number | null;
  marginPp: number | null;
  turnoutPct: number | null;
  predictedWinner: string | null;
  callCorrect: boolean | null;
  href: string;
};

const contests: Card[] = files
  .map((f): Card | null => {
    const d = JSON.parse(readFileSync(path.join(dirAbs, f), "utf8"));
    const slug = f.replace(/-\d{4}-\d{2}-\d{2}\.json$/, "");
    const r = d.result || null;
    const predictedWinner = d.forecast?.winner ?? null;
    const winnerParty = r?.winner ?? r?.winner_party ?? null;
    return {
      slug,
      name: d.contest?.constituency_name ?? slug,
      pollingDay: d.contest?.polling_day ?? "",
      region: d.contest?.region ?? d.contest?.region_label ?? "United Kingdom",
      concluded: d.status === "concluded",
      outcome: r?.outcome ?? null,
      winnerParty,
      winnerCandidate: r?.winner_candidate ?? null,
      majorityVotes: r?.majority_votes ?? null,
      marginPp: (r?.margin_pp ?? r?.majority_pp) ?? null,
      turnoutPct: r?.turnout_pct ?? null,
      predictedWinner,
      callCorrect: predictedWinner && winnerParty ? predictedWinner === winnerParty : null,
      href: `/by-elections/${slug}/`,
    };
  })
  .filter((c): c is Card => c !== null)
  .sort((a, b) => b.pollingDay.localeCompare(a.pollingDay));

const concluded = contests.filter((c) => c.concluded);
function prettyDate(iso: string): string {
  return iso ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }) : "";
}
---

<BaseLayout
  title="UK parliamentary by-elections. Results and forecasts"
  description="UK Westminster by-election results and how our forecasts compared. Covers the three 18 June 2026 by-elections: Makerfield (Labour hold, Burnham), Aberdeen South (Conservative gain) and Arbroath and Broughty Ferry (SNP hold)."
>
  <section class="hero">
    <p class="eyebrow">By-elections</p>
    <h1>Westminster by-elections</h1>
    <p class="lede">
      Every by-election we have tracked, the declared result, and how the pre-election forecast or
      signal compared. {concluded.length} concluded contest{concluded.length === 1 ? "" : "s"}.
    </p>
  </section>

  <section class="section">
    <div class="byelection-grid">
      {contests.map((c) => (
        <a class="byelection-card" href={c.href}>
          <div class="byelection-card-head">
            <span class="byelection-date">{prettyDate(c.pollingDay)}</span>
            {c.callCorrect !== null && (
              <span class={c.callCorrect ? "call-tag call-tag--ok" : "call-tag call-tag--miss"}>
                {c.callCorrect ? "forecast ✓" : "forecast ✗"}
              </span>
            )}
          </div>
          <h2>{c.name}</h2>
          <p class="byelection-region">{c.region}</p>
          {c.concluded && c.winnerParty ? (
            <div class="byelection-result">
              <span class="party-pill" style={`background:${partyColour(c.winnerParty)}`}></span>
              <span class="byelection-outcome">{c.outcome}</span>
              <span class="byelection-meta">
                {c.winnerCandidate}{c.marginPp != null ? ` · +${(c.marginPp * 100).toFixed(1)}pp` : ""}{c.turnoutPct != null ? ` · turnout ${(c.turnoutPct * 100).toFixed(1)}%` : ""}
              </span>
            </div>
          ) : (
            <p class="byelection-meta">Forecast pending</p>
          )}
          {c.predictedWinner && c.callCorrect === false && (
            <p class="byelection-call">Pre-election call: <strong>{shortPartyLabel(c.predictedWinner)}</strong> · the result went the other way.</p>
          )}
          {c.predictedWinner && c.callCorrect === true && (
            <p class="byelection-call">Pre-election call: <strong>{shortPartyLabel(c.predictedWinner)}</strong> · called correctly.</p>
          )}
          <span class="byelection-link">Read the result and scorecard →</span>
        </a>
      ))}
    </div>
    <p class="caption">
      The 18 June 2026 round was a split verdict: Labour held Makerfield (Andy Burnham) against a
      UKE forecast that wrongly called Reform; the Conservatives gained Aberdeen South in an upset no
      area signal saw coming; and the SNP held Arbroath and Broughty Ferry exactly as the Holyrood
      signal predicted.
    </p>
  </section>

  <style>
    .byelection-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap:1.25rem; }
    .byelection-card { display:block; padding:1.25rem 1.4rem; border:1px solid var(--border); border-radius:16px; background:var(--panel-bg); text-decoration:none; color:inherit; transition: border-color .15s, transform .15s; }
    .byelection-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    .byelection-card-head { display:flex; justify-content:space-between; align-items:center; gap:0.5rem; }
    .byelection-date { font-size:0.78rem; color:var(--muted); letter-spacing:0.02em; }
    .byelection-card h2 { margin:0.5rem 0 0.1rem; font-size:1.3rem; }
    .byelection-region { margin:0; color:var(--muted); font-size:0.85rem; }
    .byelection-result { display:flex; align-items:center; flex-wrap:wrap; gap:0.4rem; margin:0.75rem 0 0.25rem; }
    .byelection-outcome { font-weight:700; }
    .byelection-meta { color:var(--muted); font-size:0.85rem; }
    .byelection-call { margin:0.4rem 0 0; font-size:0.85rem; }
    .byelection-link { display:inline-block; margin-top:0.75rem; color:var(--accent); font-weight:600; font-size:0.9rem; }
    .call-tag { font-size:0.7rem; font-weight:700; padding:0.15rem 0.5rem; border-radius:999px; }
    .call-tag--ok { color:var(--accent-2); background: color-mix(in srgb, var(--accent-2) 12%, transparent); }
    .call-tag--miss { color:var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  </style>
</BaseLayout>
