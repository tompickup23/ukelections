---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { archiveYears } from "../../../lib/byElections";
const years = archiveYears();
---
<BaseLayout title="UK by-election results archive by year" description="Browse the UK Elections archive of parliamentary and council by-election results by polling year, with declared winners, sources and the pre-election record."
 breadcrumbs={[{name:"By-elections",href:"/by-elections/"},{name:"Results archive",href:"/by-elections/archive/"}]}>
  <section class="page-hero compact-hero"><h1>By-election results archive</h1><p class="lede">Parliamentary and council contests covered by UK Elections, organised by polling year. This is our coverage archive, not a complete historical register of every UK by-election.</p></section>
  <section class="section"><h2>Browse by year</h2><ul>{years.map(year=><li><a href={`/by-elections/archive/${year}/`}>{year} by-election results</a></li>)}</ul></section>
  <p><a href="/by-elections/local/">Latest council results and upcoming polls</a> · <a href="/by-elections/">Parliamentary by-elections</a></p>
</BaseLayout>

<style>
  .compact-hero { max-width:none; padding-block:var(--space-xl) var(--space-lg); }
  .compact-hero h1 { font-size:var(--text-h1); }
  .compact-hero .lede { font-size:var(--text-body); max-width:none; margin-top:var(--space-md); }
</style>
