---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ByElectionResult from "../../../components/ByElectionResult.astro";
import { readFileSync } from "node:fs";
import path from "node:path";

const data = JSON.parse(
  readFileSync(
    path.join(process.cwd(), "data/predictions/by-elections/arbroath-and-broughty-ferry-2026-06-18.json"),
    "utf8",
  ),
);
---

<BaseLayout
  breadcrumbs={[{name:"By-elections",href:"/by-elections/"},{name:"Arbroath and Broughty Ferry",href:"/by-elections/arbroath-and-broughty-ferry/"}]}
  title="Arbroath and Broughty Ferry by-election 2026. Result"
  description="Arbroath and Broughty Ferry result, 18 June 2026: Lara Bird holds for the SNP with a 5,278-vote majority. Results and pre-election comparisons."
>
  <ByElectionResult data={data} />
</BaseLayout>
