---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HeroClock from "../../../components/HeroClock.astro";
import PartyBars from "../../../components/PartyBars.astro";
import RaceBar from "../../../components/RaceBar.astro";
import { partyColour } from "../../../lib/predictions";
import { shortPartyLabel } from "../../../lib/siteData";
import { readFileSync } from "node:fs";
import path from "node:path";

const forecast = JSON.parse(
  readFileSync(
    path.join(process.cwd(), "data/predictions/by-elections/makerfield-2026-06-18.json"),
    "utf8",
  ),
);

const analysis = JSON.parse(
  readFileSync(
    path.join(process.cwd(), "data/predictions/by-elections/makerfield-2026-06-18.analysis.json"),
    "utf8",
  ),
);

const wardDossier = analysis.ward_dossier as Array<any>;
const regression = analysis.regression as any;
const comparators = analysis.comparators as Array<any>;
const indicators = analysis.indicators as any;
const comparatorsWithData = comparators.filter((c: any) => c.council_2026);
const compAvgLead = indicators.comparator_average_reform_lead_pp;
const makerfieldLead = indicators.makerfield_reform_lead_pp;

// Pull Abram 2024 → 2026 figures live from the dossier rather than
// hardcoding them in prose. If the dossier shape ever changes upstream,
// the narrative falls back to a neutral mention instead of leaking
// undefined / NaN into the page.
const abram = wardDossier.find((w: any) => w?.name === "Abram") || null;
const abramInd2024 = abram?.result_2024_council?.shares?.["Independent"];
const abramRef2026 = abram?.result_2026_council?.shares?.["Reform UK"];
const abramHasData = typeof abramInd2024 === "number" && typeof abramRef2026 === "number";
const abramInd2024Pct = abramHasData ? (abramInd2024 * 100).toFixed(1) : null;
const abramRef2026Pct = abramHasData ? (abramRef2026 * 100).toFixed(1) : null;
const abramSwingPp = abramHasData ? ((abramRef2026 - abramInd2024) * 100).toFixed(1) : null;

const central = forecast.forecast.central_shares as Record<string, number>;
const ranked = (forecast.forecast.ranked || []) as Array<{ party: string; pct: number }>;
const winner = forecast.forecast.winner as string;
const runnerUp = forecast.forecast.runner_up as string;
const marginPp = (forecast.forecast.margin_pp * 100).toFixed(1);
const winnerPct = (forecast.forecast.central_shares[winner] * 100).toFixed(1);
const runnerUpPct = (forecast.forecast.central_shares[runnerUp] * 100).toFixed(1);
const classification = forecast.forecast.classification as string;

const ge2024 = forecast.inputs.ge2024_baseline;
const ge2024Shares = ge2024.vote_shares as Record<string, number>;
const wardSignal = forecast.inputs.ward_signal_2026_05_07;
const wardAgg = wardSignal.aggregate_shares as Record<string, number>;
const reformLead = (forecast.inputs.ward_aggregate_reform_lead_pp * 100).toFixed(1);
const turnoutPct = (wardSignal.average_turnout_pct * 100).toFixed(1);

const survation = forecast.inputs.survation_forecast_2026_05_15;
const britainElects = forecast.inputs.britain_elects_forecast_2026_05_15;
const scenarioA = forecast.scenarios.burnham_stands;
const scenarioB = forecast.scenarios.burnham_withdraws;

const history = forecast.historical_anchor;
const candidates = forecast.candidates as Array<any>;

const pollingDay = forecast.contest.polling_day;
const headline = forecast.forecast.headline;

// Days-to-polling for the hero clock
const _msPerDay = 86_400_000;
const daysUntil = Math.max(0, Math.ceil((new Date(`${pollingDay}T00:00:00Z`).getTime() - Date.now()) / _msPerDay));
const pollingDayLabel = new Date(`${pollingDay}T00:00:00Z`).toLocaleDateString("en-GB", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

// Sort central shares descending for the race bar
const centralRanked = Object.entries(central)
  .filter(([, p]) => (p as number) > 0.005)
  .sort((a, b) => (b[1] as number) - (a[1] as number))
  .map(([party, pct]) => ({ party, pct: pct as number }));

// Pull candidate names per party for the race-bar legend
const candidateByParty: Record<string, string> = {};
for (const c of candidates as any[]) {
  if (c.candidate && c.candidate !== "to be confirmed") {
    candidateByParty[c.party] = c.candidate;
  }
}
const candidateList = Object.entries(candidateByParty).map(([party, candidate]) => ({
  party,
  candidate,
}));

// Scenario A / B central-share rankings for the side-by-side bars
function sortShares(shares: Record<string, number>) {
  return Object.entries(shares)
    .filter(([, p]) => (p as number) > 0.005)
    .sort((a, b) => (b[1] as number) - (a[1] as number))
    .map(([party, pct]) => ({ party, pct: pct as number }));
}
const scenarioAShares = sortShares(scenarioA.central);
const scenarioBShares = sortShares(scenarioB.central);
const burnhamProb = (forecast.forecast.burnham_on_ballot_probability * 100).toFixed(0);

// ---------------------------------------------------------------------------
// Post-result (the contest has concluded). When `status === "concluded"` the
// page leads with the declared result + a forecast-vs-result scorecard, and
// the pre-election forecast below is reframed as the frozen call we are
// grading. All blocks degrade gracefully if the returning officer's full
// per-candidate breakdown has not yet been backfilled into result.shares.
// ---------------------------------------------------------------------------
const status = (forecast.status as string) || "live";
const isConcluded = status === "concluded";
const result = (forecast.result as any) || null;
const finalPolls = (forecast.final_polls as any) || null;
const fvr = (forecast.forecast_vs_result as any) || null;
const resultShares = (result?.shares as Record<string, number> | null) || null;
const resultRanked = resultShares ? sortShares(resultShares) : [];
const pollAvg = (finalPolls?.poll_of_polls as any) || null;
const pollAvgRanked = (pollAvg?.ranked as Array<{ party: string; pct: number }>) || [];
const marginCmp = (fvr?.margin_comparison as any) || null;
const actualMarginPp = marginCmp ? (marginCmp.actual_labour_margin_pp * 100).toFixed(0) : null;
const benchmarks = ((forecast.benchmarks?.graded as Array<any>) || []);

// Map the margin-comparison contender ids to human labels for the scorecard.
const CONTENDER_LABELS: Record<string, string> = {
  uke_published_forecast: "UKE published forecast (probability-weighted)",
  uke_scenario_a_burnham_stands: "UKE Scenario A: Burnham stands (85% branch)",
  final_poll_of_polls: "Final-polls poll-of-polls (5 polls)",
  most_labour_favourable_poll_convergent: "Best Labour poll (Convergent, 2 to 12 Jun)",
};
function fmtSigned(pp: number): string {
  const v = pp * 100;
  return `${v > 0 ? "+" : ""}${v.toFixed(1)}`;
}

function pct(x: number): string {
  return (x * 100).toFixed(1);
}

function swingFromGe2024(party: string): number {
  return (central[party] || 0) - (ge2024Shares[party] || 0);
}

function classificationLabel(c: string): string {
  switch (c) {
    case "toss-up":
      return "Toss-up";
    case "lean":
      return "Lean";
    case "likely":
      return "Likely";
    case "safe":
      return "Safe";
    default:
      return c;
  }
}
---

<BaseLayout
  title={isConcluded ? "Makerfield by-election 2026. Result vs forecast" : "Makerfield by-election. 18 June 2026 forecast"}
  description={isConcluded
    ? `Andy Burnham (Labour) held Makerfield on 18 June 2026 with a majority of over 9,000 (turnout 58.75%). How the UKE forecast and the final polls compared: the published forecast called Reform; the result was a Labour landslide.`
    : `Forecast for the 18 June 2026 Makerfield parliamentary by-election. Central forecast: ${shortPartyLabel(winner)} ${winnerPct}% vs ${shortPartyLabel(runnerUp)} ${runnerUpPct}%, a ${marginPp}pp ${classification}.`}
>
  {isConcluded ? (
    <section class="hero hero-byelection-v2">
      <div class="hero-byelection-grid">
        <header class="hero-byelection-head">
          <p class="eyebrow">Result · {pollingDayLabel}</p>
          <h1>Makerfield by-election</h1>
          <p class="lede">
            <strong>Labour hold.</strong> Andy Burnham returned to Parliament on
            <strong> 54.8%</strong>, a <strong>9,231-vote majority</strong> (+{actualMarginPp}pp) over
            Reform UK's Robert Kenyon (34.5%), with <strong>Restore Britain third</strong> (6.8%).
            Turnout <strong>58.75%</strong>, up 6.4pp on GE2024. Wigan borough · North West ·
            {forecast.contest.pcon24cd}.
          </p>
        </header>

        <div class="result-badge">
          <span class="result-badge-kicker">Elected MP</span>
          <span class="result-badge-name">Andy Burnham</span>
          <span class="result-badge-party" style={`background:${partyColour("Labour")}`}>Labour</span>
        </div>
      </div>

      {resultRanked.length ? (
        <RaceBar
          shares={resultRanked}
          candidates={candidateList}
          title="Declared result (vote share)"
        />
      ) : (
        <p class="caption result-pending">
          Declared overnight: <strong>Labour hold</strong>, Burnham majority
          <strong> over 9,000</strong>, turnout <strong>45,510 (58.75%)</strong>, finishing order
          Labour › Reform UK › Restore Britain. The full per-candidate vote breakdown appears
          here once the returning officer publishes it.
        </p>
      )}
    </section>
  ) : (
    <section class="hero hero-byelection-v2">
      <div class="hero-byelection-grid">
        <header class="hero-byelection-head">
          <p class="eyebrow">Polling day · {pollingDayLabel}</p>
          <h1>Makerfield by-election</h1>
          <p class="lede">
            A <strong>{marginPp}pp {classificationLabel(classification).toLowerCase()}</strong>
            between <strong>{shortPartyLabel(winner)}</strong> and
            <strong>{shortPartyLabel(runnerUp)}</strong>. Well inside the model's
            confidence interval. Wigan borough · North West · {forecast.contest.pcon24cd}.
          </p>
        </header>

        <HeroClock
          value={daysUntil}
          label={daysUntil === 1 ? "day to polling" : "days to polling"}
          ariaLabel="Days until polling"
        />
      </div>

      <RaceBar
        shares={centralRanked}
        candidates={candidateList}
        title="Central forecast (probability-weighted projected vote share)"
      />
    </section>
  )}

  {isConcluded && resultRanked.length > 0 && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Declared result · 18 June 2026</p>
        <h2>Full result</h2>
      </div>
      <table class="seat-table">
        <thead>
          <tr>
            <th>Party</th>
            <th class="num">Votes</th>
            <th class="num">Share</th>
            <th class="num">Swing vs GE2024</th>
          </tr>
        </thead>
        <tbody>
          {resultRanked.map((row) => {
            const v = result.votes?.[row.party];
            const sw = result.swing_vs_ge2024_pp?.[row.party];
            return (
              <tr>
                <td><span class="party-pill" style={`background:${partyColour(row.party)}`}></span> {shortPartyLabel(row.party)}</td>
                <td class="num">{typeof v === "number" ? v.toLocaleString() : "n/a"}</td>
                <td class="num">{(row.pct * 100).toFixed(1)}%</td>
                <td class="num">
                  {typeof sw === "number" ? (
                    <span class={sw > 0 ? "swing-up" : (sw < 0 ? "swing-down" : "swing-flat")}>
                      {sw > 0 ? "+" : ""}{(sw * 100).toFixed(1)}pp
                    </span>
                  ) : "n/a"}
                </td>
              </tr>
            );
          })}
          <tr>
            <td><strong>Majority</strong></td>
            <td class="num"><strong>{result.majority_votes?.toLocaleString()}</strong></td>
            <td class="num"><strong>{(result.majority_pp * 100).toFixed(1)}pp</strong></td>
            <td class="num">n/a</td>
          </tr>
          <tr>
            <td><strong>Turnout</strong></td>
            <td class="num"><strong>{result.turnout_votes?.toLocaleString()}</strong></td>
            <td class="num"><strong>{(result.turnout_pct * 100).toFixed(2)}%</strong></td>
            <td class="num"><span class="swing-up">+{(result.turnout_change_pp * 100).toFixed(1)}pp</span></td>
          </tr>
        </tbody>
      </table>
      <p class="caption">
        Labour <strong>hold</strong>; Andy Burnham returns to Parliament. "Other" aggregates eight
        minor candidates (Count Binface 95, Monster Raving Loony 45, three Independents, Rejoin EU,
        Libertarian, Climate). Restore Britain's <strong>6.84%</strong> (third, on debut) and the
        Conservative collapse to <strong>2.19%</strong> (−8.7pp) are the two structural surprises.
        Source: returning officer declaration via the
        <a href="https://en.wikipedia.org/wiki/2026_Makerfield_by-election"> Wikipedia result box</a>.
      </p>
    </section>
  )}

  {isConcluded && fvr && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Scorecard · how the forecast did</p>
        <h2>Forecast vs result</h2>
      </div>
      <p>
        The published UKE forecast called this seat for <strong>Reform UK</strong> (a 1.4pp
        toss-up). The result was a <strong>Labour landslide</strong> of roughly
        <strong> +{actualMarginPp}pp</strong>. The winner-call was wrong, and so was the sign of
        the margin. Every fieldwork-based poll, and the 85%-weighted branch of the model's own
        scenario set, had Labour ahead.
      </p>
      <table class="seat-table">
        <thead>
          <tr>
            <th>Estimate</th>
            <th class="num">Lab lead (Lab − Reform)</th>
            <th class="num">Error vs result</th>
            <th>Winner call</th>
          </tr>
        </thead>
        <tbody>
          <tr class="scorecard-actual">
            <td><strong>Actual result</strong></td>
            <td class="num"><strong>+{actualMarginPp}pp</strong></td>
            <td class="num">n/a</td>
            <td><span class="party-pill" style={`background:${partyColour("Labour")}`}></span> <strong>Labour (Burnham)</strong></td>
          </tr>
          {marginCmp.contenders.map((c: any) => (
            <tr>
              <td>{CONTENDER_LABELS[c.id] || c.id}</td>
              <td class="num">{fmtSigned(c.labour_margin_pp)}pp</td>
              <td class="num">
                <span class="scorecard-err">{fmtSigned(c.signed_error_pp)}pp</span>
              </td>
              <td>
                {c.direction_correct
                  ? <span class="call-correct">✓ Labour (correct)</span>
                  : <span class="call-wrong">✗ Reform (wrong)</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="caption">
        "Error vs result" is the signed gap between each estimate's Labour-minus-Reform margin and
        the actual <strong>+{actualMarginPp}pp</strong> (Labour 54.8% to Reform 34.5%). Everyone
        understated Labour, who overshot even the most favourable poll; only the published forecast
        also got the direction wrong. Mean absolute error across the six main parties: published
        forecast <strong>6.5pp</strong>, Scenario A 5.9pp, the final poll-of-polls <strong>2.8pp</strong>.
      </p>
    </section>
  )}

  {isConcluded && benchmarks.length > 0 && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Scorecard · the whole field</p>
        <h2>How every forecaster did</h2>
      </div>
      <p>
        Our forecast was not the only one to get Makerfield wrong, and the constituency polls were not
        the only ones to get it right. Ranked by accuracy against the result (Labour 54.8 / Reform 34.5):
      </p>
      <table class="seat-table">
        <thead>
          <tr>
            <th>Forecaster</th>
            <th class="num">Share MAE</th>
            <th class="num">Margin err</th>
            <th>Called</th>
          </tr>
        </thead>
        <tbody>
          {benchmarks
            .slice()
            .sort((a: any, b: any) => {
              if (a.winner_correct !== b.winner_correct) return a.winner_correct ? -1 : 1;
              return (a.mae_pp ?? 9) - (b.mae_pp ?? 9);
            })
            .map((b: any) => (
              <tr>
                <td>
                  {b.winner_correct ? <span class="call-correct">✓</span> : <span class="call-wrong">✗</span>}{" "}
                  {b.forecaster}<span class="muted"> · {b.date}</span>
                </td>
                <td class="num">{b.mae_pp != null ? (b.mae_pp * 100).toFixed(1) + "pp" : <span class="muted">n/a</span>}{b.partial ? <span class="muted">*</span> : null}</td>
                <td class="num">{b.margin_err_pp != null ? <span class="scorecard-err">{(b.margin_err_pp * 100).toFixed(1)}pp</span> : <span class="muted">n/a</span>}</td>
                <td>{shortPartyLabel(b.called)}{b.prob ? <span class="muted"> ({Math.round(b.prob * 100)}%)</span> : null}</td>
              </tr>
            ))}
        </tbody>
      </table>
      <p class="caption">
        Share MAE = mean absolute error across each forecaster's reported parties (<span class="muted">*partial: headline parties only</span>).
        Margin err = signed Labour-minus-Reform vs the actual +20.3pp; every forecaster understated Labour, because
        Burnham's 54.8% overshot even the best poll. The two seat models that ignore constituency polls (our
        published forecast and Electoral Calculus) were the only ones to call the wrong winner. Electoral Calculus's
        figure is its standard general-election seat model from 9 May, not a bespoke by-election forecast.
      </p>
    </section>
  )}

  {isConcluded && fvr && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Why the published forecast missed</p>
        <h2>Four methodology failures</h2>
      </div>
      <ol class="numbered-list">
        {fvr.miss_attribution.map((m: string) => (<li>{m}</li>))}
      </ol>
      <p class="caption">
        None of these are exotic. The model even flagged the bimodality in its own confidence
        note, then published the blended point estimate anyway. The fix is to report scenarios and
        P(win) separately, decay dead scenarios to zero once they are settled, and re-fit on real
        constituency polls the moment they land.
      </p>
    </section>
  )}

  {isConcluded && finalPolls && pollAvg && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Final polls · the prediction that should have been published</p>
        <h2>Five constituency polls, all pointing the same way</h2>
      </div>
      <p>
        {finalPolls.note}
      </p>
      <RaceBar
        shares={pollAvgRanked}
        title={`Final-polls poll-of-polls: ${pollAvg.headline}`}
      />
      <table class="seat-table">
        <thead>
          <tr>
            <th>Pollster</th>
            <th>Fieldwork</th>
            <th class="num">n</th>
            <th class="num">Lab</th>
            <th class="num">Reform</th>
            <th class="num">Restore</th>
            <th class="num">Grn</th>
            <th class="num">Lab lead</th>
          </tr>
        </thead>
        <tbody>
          {finalPolls.polls.map((p: any) => (
            <tr>
              <td>{p.pollster}{p.client ? <span class="muted"> · {p.client}</span> : null}</td>
              <td class="muted">{p.fieldwork.replace("/", " to ")}</td>
              <td class="num">{p.sample}</td>
              <td class="num">{(p.shares["Labour"] * 100).toFixed(0)}</td>
              <td class="num">{(p.shares["Reform UK"] * 100).toFixed(0)}</td>
              <td class="num">{(p.shares["Restore Britain"] * 100).toFixed(0)}</td>
              <td class="num">{(p.shares["Green Party"] * 100).toFixed(0)}</td>
              <td class="num"><span class="swing-up">+{(p.lead_pp * 100).toFixed(0)}</span></td>
            </tr>
          ))}
          <tr>
            <td><strong>Poll-of-polls (mean)</strong></td>
            <td class="muted">5 polls</td>
            <td class="num">n/a</td>
            <td class="num"><strong>{(pollAvg.shares["Labour"] * 100).toFixed(1)}</strong></td>
            <td class="num"><strong>{(pollAvg.shares["Reform UK"] * 100).toFixed(1)}</strong></td>
            <td class="num"><strong>{(pollAvg.shares["Restore Britain"] * 100).toFixed(1)}</strong></td>
            <td class="num"><strong>{(pollAvg.shares["Green Party"] * 100).toFixed(1)}</strong></td>
            <td class="num"><strong><span class="swing-up">+{(pollAvg.labour_lead_pp * 100).toFixed(1)}</span></strong></td>
          </tr>
        </tbody>
      </table>
      <p class="caption">
        {finalPolls.no_exit_poll_note} A poll-of-polls of these five (Labour +7) would have called
        the seat correctly; the most recent poll (Convergent, to 12 Jun) had Labour +12. Even so,
        all five understated the eventual ≈+{actualMarginPp}pp margin, and all five over-stated
        Reform, because the high 58.75% turnout broke for Burnham harder than likely-voter models assumed.
      </p>
    </section>
  )}

  {isConcluded && (
    <section class="section frozen-divider">
      <div class="section-head">
        <p class="eyebrow">For the record · the pre-election forecast we are grading</p>
        <h2>What UKE forecast beforehand (frozen 26 May 2026)</h2>
      </div>
      <p>
        Everything below is the original pre-election forecast and analysis, preserved unchanged.
        It is the call the scorecard above grades: a 1.4pp Reform-leaning toss-up built from the
        15 May Survation/Britain Elects pre-poll <em>forecasts</em> (not fieldwork polls), a
        probability blend of a Burnham-stands and a Burnham-withdraws scenario, and the 1 May 2026
        ward signal.
      </p>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Trigger</p>
      <h2>Why this seat is being contested</h2>
    </div>
    <p>
      Josh Simons (Labour, MP for Makerfield since GE2024) announced his resignation on
      <strong>14 May 2026</strong> so that Greater Manchester mayor <strong>Andy Burnham</strong>
      could seek a return to Parliament. Labour's National Executive Committee cleared Burnham
      to stand on <strong>15 May 2026</strong>. The Prime Minister has indicated Downing Street
      will not block the candidacy.
    </p>
    <p>
      It is the first Westminster by-election since <strong>1965 (Leyton, Patrick Gordon Walker)</strong>
      to be triggered specifically to seat a political figure from outside Parliament. Bookmakers
      and commentators frame the result as a precursor to a Labour leadership challenge to
      Sir Keir Starmer.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Swing from GE2024</p>
      <h2>How the model expects each party to move on 18 June</h2>
    </div>
    <PartyBars
      large={true}
      rows={ranked.map((row) => {
        const swing = swingFromGe2024(row.party);
        const ge24 = ge2024Shares[row.party] || 0;
        return {
          party: row.party,
          pct: row.pct,
          annotation: ge24 > 0
            ? `${swing > 0 ? "+" : ""}${(swing * 100).toFixed(1)}pp`
            : null,
          annotationDirection: swing > 0 ? "up" : swing < 0 ? "down" : "flat",
        };
      })}
    />
    <p class="caption">
      Coloured number is the swing vs the 4 July 2024 general election result.
      Blend = {burnhamProb}% Scenario A (Burnham stands) + {(100 - parseInt(burnhamProb))}% Scenario B
      (Burnham withdraws).
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Two scenarios</p>
      <h2>The Burnham-on-the-ballot question</h2>
    </div>
    <p>
      The headline forecast hinges almost entirely on whether Burnham appears on the ballot.
      Two independent forecasts were published on 15 May 2026: Survation and Britain Elects
      (Ben Walker). <strong>Neither is a fieldwork-based constituency poll.</strong> Survation
      transfers the Burnham effect from their Gorton &amp; Denton post-by-election poll
      (n=501, 9 Mar 2026) re-weighted for Makerfield demographics, while Britain Elects
      applies a North West regional Burnham favourability adjustment to the GE2024 baseline.
      Both agree Labour leads by 3pp with Burnham as candidate; they disagree on absolute
      levels (Survation Lab 45 / Ref 42; Britain Elects Lab 39 / Ref 36).
    </p>
    <div class="scenario-grid">
      <div class="scenario-panel">
        <div class="scenario-head">
          <span class="scenario-letter">A</span>
          <h3>Burnham stands</h3>
          <span class="scenario-prob">P = {burnhamProb}%</span>
        </div>
        <RaceBar
          shares={scenarioAShares}
          height={56}
          showLegend={true}
          title={null}
          ariaLabel="Scenario A: vote shares with Burnham on the ballot"
        />
      </div>
      <div class="scenario-panel">
        <div class="scenario-head">
          <span class="scenario-letter scenario-letter--b">B</span>
          <h3>Burnham withdraws</h3>
          <span class="scenario-prob">P = {(100 - parseInt(burnhamProb))}%</span>
        </div>
        <RaceBar
          shares={scenarioBShares}
          height={56}
          showLegend={true}
          title={null}
          ariaLabel="Scenario B: vote shares without Burnham on the ballot"
        />
      </div>
    </div>
    <p class="caption">
      Scenario A blends both forecasts: 50/50 mean of Survation (Lab 45 / Ref 42) and
      Britain Elects (Lab 39 / Ref 36) for the major parties, with Survation's minor-party
      splits scaled to the residual. Scenario B is Survation's non-Burnham scenario verbatim
      (Britain Elects didn't publish one).
    </p>
    <p class="caption">
      <strong>Probability framing.</strong> Our model uses
      <strong>{(forecast.forecast.burnham_on_ballot_probability * 100).toFixed(0)}%</strong>
      as P[Burnham appears on the ballot], reflecting NEC clearance + Burnham's same-day
      acceptance + Downing Street's confirmation of no block. Note this is a different
      quantity to Survation's published <strong>67%</strong>, which is P[Labour wins |
      Burnham stands] from their 10,000-simulation run.
    </p>
  </section>

  <section class="section">
