---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ByElectionResult from "../../../components/ByElectionResult.astro";
import { readFileSync } from "node:fs";
import path from "node:path";

const data = JSON.parse(
  readFileSync(
    path.join(process.cwd(), "data/predictions/by-elections/aberdeen-south-2026-06-18.json"),
    "utf8",
  ),
);
---

<BaseLayout
  breadcrumbs={[{name:"By-elections",href:"/by-elections/"},{name:"Aberdeen South",href:"/by-elections/aberdeen-south/"}]}
  title="Aberdeen South by-election 2026. Result"
  description="Aberdeen South result, 18 June 2026: Douglas Lumsden wins for the Conservatives with a 6,050-vote majority. Results and pre-election comparisons."
>
  <ByElectionResult data={data} />
</BaseLayout>
