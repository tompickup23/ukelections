---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ByElectionResult from "../../../components/ByElectionResult.astro";
import { readFileSync } from "node:fs";
import path from "node:path";

const data = JSON.parse(
  readFileSync(
    path.join(process.cwd(), "data/predictions/by-elections/aberdeen-south-2026-06-18.json"),
    "utf8",
  ),
);
---

<BaseLayout
  title="Aberdeen South by-election 2026. Result"
  description="The Conservatives gained Aberdeen South from the SNP at the 18 June 2026 by-election (Douglas Lumsden, majority 6,050). An upset: every area signal pointed to an SNP hold. Result, swing and signal-vs-result scorecard."
>
  <ByElectionResult data={data} />
</BaseLayout>
