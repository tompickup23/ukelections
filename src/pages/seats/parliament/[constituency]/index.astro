---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { externalHref, type Crumb } from "../../../../lib/seo";
import MiniMap from "../../../../components/MiniMap.astro";
import PartyBars from "../../../../components/PartyBars.astro";
import ExploreNext from "../../../../components/ExploreNext.astro";
import { loadGePredictions, loadGeBacktestForSeat, partyColour } from "../../../../lib/predictions";
import { shortPartyLabel, forecastStamp } from "../../../../lib/siteData";
import { constituencySummary, seatSwings } from "../../../../lib/pageSummaries";
import { regionForSeat, seatsByRegion } from "../../../../lib/parliamentRegions";
import { inHundred, loadGeWinProbability } from "../../../../lib/geWinProbability.js";
import { buildParliamentaryJourneyLinks } from "../../../../lib/electionJourneys";

export async function getStaticPaths() {
  const ge = loadGePredictions();
  const out = [] as any[];
  for (const [slug, p] of Object.entries(ge.predictions || {})) {
    if (!(p as any)?.prediction) continue;
    out.push({
      params: { constituency: slug },
      props: { record: p, backtest: loadGeBacktestForSeat(slug) },
    });
  }
  return out;
}

const { record, backtest } = Astro.props as { record: any; backtest: any };

// Compute per-seat backtest stats (model's predicted shares vs actual on
// 4 July 2024). Falls back to null where no backtest row exists. e.g.
// new boundary-change constituencies.
type BtRow = {
  party: string;
  predicted: number;
  actual: number;
  delta: number;
};
let backtestRows: BtRow[] = [];
let backtestPredictedWinner: string | null = null;
let backtestActualWinner: string | null = null;
let backtestWinnerCorrect = false;
let backtestMae = 0;
if (backtest?.predicted && backtest?.actual) {
  const parties = new Set<string>([
    ...Object.keys(backtest.predicted),
    ...Object.keys(backtest.actual),
  ]);
  const tracked = Array.from(parties).filter(
    (p) => (backtest.predicted[p] || 0) > 0.005 || (backtest.actual[p] || 0) > 0.005,
  );
  backtestRows = tracked
    .map((p) => ({
      party: p,
      predicted: backtest.predicted[p] || 0,
      actual: backtest.actual[p] || 0,
      delta: (backtest.predicted[p] || 0) - (backtest.actual[p] || 0),
    }))
    .sort((a, b) => b.actual - a.actual);
  const winnerOf = (m: Record<string, number>) =>
    Object.entries(m).sort((a, b) => (b[1] as number) - (a[1] as number))[0]?.[0] || null;
  backtestPredictedWinner = winnerOf(backtest.predicted);
  backtestActualWinner = winnerOf(backtest.actual);
  backtestWinnerCorrect = backtestPredictedWinner === backtestActualWinner;
  // MAE over the four major parties (Lab/Con/LD/Reform/Green) that are
  // present in either predicted or actual.
  const major = ["Labour", "Conservative", "Reform UK", "Liberal Democrats", "Green Party"];
  const maeRows = major.filter(
    (p) => (backtest.predicted[p] || 0) > 0 || (backtest.actual[p] || 0) > 0,
  );
  const maeSum = maeRows.reduce(
    (s, p) => s + Math.abs((backtest.predicted[p] || 0) - (backtest.actual[p] || 0)),
    0,
  );
  backtestMae = maeRows.length ? maeSum / maeRows.length : 0;
}
const ranked = Object.entries(record.prediction || {})
  .sort((a: any, b: any) => (b[1].pct || 0) - (a[1].pct || 0));
const ge2024Ranked = (record.ge2024?.candidates || [])
  .sort((a: any, b: any) => (b.pct || 0) - (a.pct || 0));

const mp = record.mp;
const slug = record.slug;
// Off-site cross-links. only public, party-neutral references.
const sisterLinks = [
  { label: "TheyWorkForYou", href: `https://www.theyworkforyou.com/mp/?p=${encodeURIComponent(slug.replace(/-/g, " "))}` },
].filter(Boolean) as Array<{ label: string; href: string }>;

const winnerShare = ((record.prediction[record.winner]?.pct || 0) * 100).toFixed(1);
const margin = ((record.majority_pct || 0) * 100).toFixed(1);
const winProb: number | null = typeof record.win_probability === "number" ? record.win_probability : null;
const winProbText = winProb !== null ? inHundred(winProb) : null;
const bin = record.win_probability_bin;
const intervals = (record.share_intervals || {}) as Record<string, { p10: number; p90: number }>;
const leaderRange = intervals[record.winner];
const runnerRange = intervals[record.runner_up];
const pct1 = (x: number) => (x * 100).toFixed(1);
const coverageInHundred = Math.round((loadGeWinProbability()?.interval_coverage?.overall ?? 0) * 100);
// The slug is unslugged but was never cased, so the page printed
// "england · north west" under the headline.
const titleCase = (s?: string | null) =>
  s ? s.replace(/_/g, " ").replace(/\b[a-z]/g, (c) => c.toUpperCase()) : s;
const countryLabel = titleCase(record.country);
const regionLabel = titleCase(record.region);
const geBundle = loadGePredictions();
const allSeatRecords = Object.values(geBundle.predictions || {}) as any[];
const exploreLinks = buildParliamentaryJourneyLinks(record, allSeatRecords);
if (slug === "makerfield") {
  exploreLinks.unshift(
    {
      href: "/by-elections/makerfield/",
      label: "Makerfield by-election result",
      description: "Read the 18 June 2026 result, historic results and forecast scorecard.",
      trackingId: "makerfield-seat-to-byelection",
    },
    {
      href: "https://ukdemographics.co.uk/constituencies/makerfield/",
      label: "Makerfield population and demographics",
      description: "See the ONS-sourced population and demographic profile on UK Demographics.",
      trackingId: "makerfield-seat-to-demographics",
    },
  );
}
const region = regionForSeat(record);
const regionSeatCount = region ? seatsByRegion(allSeatRecords).get(region.slug)?.length ?? 0 : 0;
const summary = constituencySummary(
  record,
  backtestRows.length
    ? { predictedWinner: backtestPredictedWinner, actualWinner: backtestActualWinner, winnerCorrect: backtestWinnerCorrect, mae: backtestMae }
    : null,
);
const swings = seatSwings(record);
const breadcrumbs: Crumb[] = [
  { name: "Constituencies", href: "/seats/parliament/" },
  ...(region ? [{ name: region.name, href: `/seats/parliament/${region.slug}/` }] : []),
  { name: record.name, href: `/seats/parliament/${Astro.params.constituency}/` }
];
// No Dataset structured data here: it stays on the forecast hub, which is the
// page that offers the download. 650 near-identical Dataset nodes describe one
// file 650 times.
// Answer first, plain name first, under 60 characters. BaseLayout owns the
// brand (normalisePageTitle strips a " | UK Elections" suffix).
const pageTitle = slug === "makerfield" || slug === "colchester"
  ? `${record.name} constituency map and forecast`
  : [`${record.name} general election forecast`, `${record.name} election forecast`, `${record.name} forecast`]
      .find((t) => t.length <= 60) ?? record.name;
const answer = `${shortPartyLabel(record.winner)} ahead${winProbText ? `, ${winProbText}` : ""}, ${margin}pp over ${shortPartyLabel(record.runner_up)}`;
const pageDescription = [
  `${record.name} general election forecast: ${answer}. Map, sitting MP and 2024 result.`,
  `${record.name} general election forecast: ${answer}.`,
  `${record.name} forecast: ${answer}.`,
].find((d) => d.length <= 155) ?? `${record.name} forecast: ${answer}.`.slice(0, 155);
const ge2024Top = ge2024Ranked.slice(0, 3);
const ge2024Majority = record.ge2024?.majority;
---

<BaseLayout
  breadcrumbs={breadcrumbs}
  title={pageTitle}
  description={pageDescription}
>
  <section class="page-hero seat-hero">
    <p class="eyebrow">General election forecast</p>
    <h1>{record.name} constituency map and forecast</h1>
    <p class="lede">
      <strong><span class="party-pill" style={`background:${partyColour(record.winner)}`}></span> {shortPartyLabel(record.winner)} ahead{winProbText ? <>, {winProbText}</> : null}</strong>,
      on <strong>{winnerShare}%</strong>, {margin}pp over {shortPartyLabel(record.runner_up)}.
    </p>
    {winProb !== null && (
      <p class="probability-note">
        {winProbText} is how often the projected leader went on to win in our 2024 rerun, across
        {" "}{bin?.n ?? "the"} seats where the predicted margin was between {bin?.from_pp} and {bin && bin.to_pp > 100 ? "100" : bin?.to_pp} points.
        {leaderRange && runnerRange && <>{" "}{`Likely share range: ${shortPartyLabel(record.winner)} ${pct1(leaderRange.p10)} to ${pct1(leaderRange.p90)}%, ${shortPartyLabel(record.runner_up)} ${pct1(runnerRange.p10)} to ${pct1(runnerRange.p90)}%.`}</>}
        {" "}It measures how far the model missed in 2024 using polls taken about nine weeks out, not how much opinion may change before the next election.
        {" "}<a href="/methodology/general-election/#uncertainty">How this is calculated</a>.
      </p>
    )}
    <div class="seat-glance">
      {record.pcon24cd && (
        <div class="seat-glance-map">
          <MiniMap
            focalCode={record.pcon24cd}
            focalKind="pcon"
            detail="full"
            focalColour={partyColour(record.winner)}
            width={320}
            height={240}
            ariaLabel={`Map of ${record.name} constituency and its neighbours`}
          />
        </div>
      )}
      <div class="seat-glance-card">
        <p class="card-eyebrow">Sitting MP</p>
        {mp ? (
          <p class="card-lead"><strong>{mp.name}</strong>, {shortPartyLabel(mp.party)}{mp.since ? <>, since {mp.since}</> : null}{mp.status && mp.status !== "standing_again" ? <> ({mp.status.replace(/_/g, " ")})</> : null}</p>
        ) : (
          <p class="card-lead">No sitting MP record on file.</p>
        )}
        <p class="card-eyebrow">2024 result</p>
        <ol class="card-result">
          {ge2024Top.map((c: any) => (
            <li>
              <span class="party-pill" style={`background:${partyColour(c.party_name)}`}></span>
              {shortPartyLabel(c.party_name)} <span class="card-num">{((c.pct || 0) * 100).toFixed(1)}%</span>
            </li>
          ))}
        </ol>
        {typeof ge2024Majority === "number" && <p class="card-foot">Majority {ge2024Majority.toLocaleString()} votes. <a href="#ge2024-result">Full result</a>.</p>}
        {sisterLinks.length > 0 && (
          <p class="card-foot">
            {sisterLinks.map((l, i) => (
              <span>{i > 0 && " · "}<a href={l.href}>{l.label}</a></span>
            ))}
          </p>
        )}
      </div>
    </div>
    <p class="meta-row">
      {countryLabel}{regionLabel ? ` · ${regionLabel}` : ""}{record.pcon24cd ? ` · official code ${record.pcon24cd}` : ""}
      <span data-discovery-ignore>{geBundle.snapshot?.generated_at ? ` · forecast generated ${forecastStamp(geBundle.snapshot.generated_at)}` : ""}</span>
    </p>
    {slug === "makerfield" && (
      <p class="meta-row">
        Related: <a href="/by-elections/makerfield/">18 June 2026 Makerfield by-election result and historic record</a>
        {" "}· <a href="https://ukdemographics.co.uk/constituencies/makerfield/">ONS-sourced Makerfield population and demographics</a>.
      </p>
    )}
  </section>

  {summary.length > 0 && (
    <section class="section seat-summary">
      <p>
        {summary.join(" ")}
        {region && <>{" "}{record.name} is one of {regionSeatCount} constituencies in {region.prose}; <a href={`/seats/parliament/${region.slug}/`}>see the projection for each of them</a>.</>}
      </p>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Predicted vote share</p>
      <h2>How the model expects this constituency to vote</h2>
    </div>
    <div class="party-bars party-bars-large">
      {ranked.map(([party, payload]: any) => {
        const pct = (payload.pct || 0);
        // Against the model's own 2024 baseline, which uses the same party
        // names as the projection. Matching ballot descriptions instead showed
        // Labour and Co-operative seats as a Labour gain of the whole share.
        const swing = swings[party] ?? 0;
        return (
          <div class="bar-row">
            <span class="bar-label">{shortPartyLabel(party)}</span>
            <div class="bar-track">
              <div class="bar-fill" style={`width:${(pct * 100).toFixed(1)}%; background:${partyColour(party)}`}></div>
            </div>
            <span class="bar-value">{(pct * 100).toFixed(1)}% <span class={swing > 0 ? "swing-up" : (swing < 0 ? "swing-down" : "swing-flat")}>{swing > 0 ? "+" : ""}{(swing * 100).toFixed(1)}pp</span>{intervals[party] && <span class="bar-range">{pct1(intervals[party].p10)} to {pct1(intervals[party].p90)}%</span>}</span>
          </div>
        );
      })}
    </div>
    <p class="caption">Coloured number is the swing from the 2024 general election result. The grey range is the low (p10) and high (p90) share from the 2024 rerun's errors; {coverageInHundred > 0 && <>on held-out regions the actual share fell inside it {coverageInHundred} times in 100.</>}</p>
  </section>

  <section class="section" id="ge2024-result">
    <div class="section-head">
      <p class="eyebrow">2024 general election result</p>
      <h2>What happened on 4 July 2024</h2>
    </div>
    <table class="seat-table">
      <thead><tr><th>Candidate</th><th>Party</th><th class="num">Votes</th><th class="num">Share</th></tr></thead>
      <tbody>
        {ge2024Ranked.slice(0, 8).map((c: any) => (
          <tr>
            <td>{c.name || "n/a"}</td>
            <td><span class="party-pill" style={`background:${partyColour(c.party_name)}`}></span> {shortPartyLabel(c.party_name)}</td>
            <td class="num">{(c.votes || 0).toLocaleString()}</td>
            <td class="num">{((c.pct || 0) * 100).toFixed(1)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
    {record.ge2024?.source_url && (
      <p class="caption">Source: {externalHref(record.ge2024.source_url)
        ? <a href={externalHref(record.ge2024.source_url)} rel="nofollow">Returning officer declaration</a>
        : <>Returning officer declaration{record.ge2024.source_url ? <> ({record.ge2024.source_url})</> : null}</>}</p>
    )}
  </section>

  {backtestRows.length > 0 && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">How accurate is the model here?</p>
        <h2>Our 2024 backtest for this constituency</h2>
      </div>
      <p>
        We replayed the model on the 4 July 2024 general election from the 2019 result, feeding it the actual 2024
        national vote shares and the anti-attenuation step, so this tests how the model spreads a known national
        result across seats rather than how good the polls were. Here's what it predicted for
        {" "}<strong>{record.name}</strong>, and what actually happened.
      </p>
      <div class="backtest-callout">
        <strong>
          {backtestWinnerCorrect ? "✓ Winner called correctly" : "✗ Winner missed"}
        </strong>
       , predicted <span class="party-pill" style={`background:${partyColour(backtestPredictedWinner ?? "")}`}></span> {shortPartyLabel(backtestPredictedWinner ?? "")},
        actual <span class="party-pill" style={`background:${partyColour(backtestActualWinner ?? "")}`}></span> {shortPartyLabel(backtestActualWinner ?? "")}.
        <span class="backtest-detail">
          Major-party MAE: <strong>{(backtestMae * 100).toFixed(2)}pp</strong>, the average gap between our predicted vote share and the actual share, per major party.
        </span>
      </div>
      <div class="backtest-compare-grid">
        <div class="backtest-compare-panel">
          <p class="backtest-compare-label">Predicted</p>
          <PartyBars
            rows={backtestRows.map((r) => ({ party: r.party, pct: r.predicted }))}
          />
        </div>
        <div class="backtest-compare-panel">
          <p class="backtest-compare-label">Actual on 4 July 2024</p>
          <PartyBars
            rows={backtestRows.map((r) => ({
              party: r.party,
              pct: r.actual,
              annotation: `${r.delta > 0 ? "+" : ""}${(r.delta * 100).toFixed(1)}pp`,
              annotationDirection: r.delta > 0 ? "up" : r.delta < 0 ? "down" : "flat",
            }))}
          />
        </div>
      </div>
      <p class="caption">
        Positive gap = we predicted that party would win more share than they did. See the {" "}
        <a href="/data-quality/ge-backtest/">full GE backtest across all 650 seats</a> for the model's national accuracy.
      </p>
    </section>
  )}

  <ExploreNext links={exploreLinks} title={`Explore beyond ${record.name}`} />

  <details class="section method-details">
    <summary>How this forecast was built</summary>
    <ol class="numbered-list">
      {record.methodology?.map((m: any) => (
        <li><strong>{m.name}</strong>{m.description ? <>. {m.description}</> : null}</li>
      ))}
    </ol>
    <p class="muted-row">
      <a href="/methodology/general-election/">Read the full general election methodology →</a>
    </p>
  </details>
</BaseLayout>

<style>
  .seat-hero .lede { margin-bottom: var(--space-sm); }
  .probability-note {
    margin: 0 0 var(--space-md);
    color: var(--ink-soft);
    font-size: var(--text-small);
  }
  .seat-glance {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
  }
  .seat-glance-card {
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-muted);
  }
  .card-eyebrow {
    margin: 0 0 var(--space-2xs);
    color: var(--ink-soft);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
  }
  .card-lead { margin: 0 0 var(--space-md); }
  .card-result {
    margin: 0 0 var(--space-sm);
    padding: 0;
    list-style: none;
  }
  .card-result li { display: flex; align-items: center; gap: var(--space-xs); }
  .card-num { margin-left: auto; font-variant-numeric: tabular-nums; }
  .card-foot { margin: 0; color: var(--ink-soft); font-size: var(--text-small); }
  .bar-range {
    display: block;
    color: var(--ink-soft);
    font-size: var(--text-eyebrow);
    font-weight: 400;
  }
  @media (max-width: 40rem) {
    .seat-glance { grid-template-columns: minmax(0, 1fr); }
  }
</style>
