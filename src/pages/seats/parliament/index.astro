---
/**
 * Index of all 650 parliamentary constituencies, by nation and region.
 *
 * This page exists because the constituency pages had no internal links
 * pointing at them. Only two pages on the whole site linked to any of them (a
 * top-50 table on the general election forecast and ten more on the backtest),
 * so 590 of the 650 were reachable only from sitemap.xml. Google had discovered
 * them and declined to index most: they arrived with no signal that anything on
 * the site considered them worth reaching.
 *
 * Since October 2026 it links the twelve region hubs rather than all 650 seats
 * in one list: each hub lists its seats with the 2024 and projected winners, and
 * the home page links the hubs directly, so every seat is two clicks from home
 * through a page of at most 91 links.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadGePredictions, partyColour } from "../../../lib/predictions";
import { shortPartyLabel } from "../../../lib/siteData";
import { SITE_URL } from "../../../lib/site";
import { PARLIAMENT_REGIONS, seatsByRegion } from "../../../lib/parliamentRegions";
import { tally } from "../../../lib/pageSummaries";
import type { Crumb } from "../../../lib/seo";

const bundle = loadGePredictions() as { predictions?: Record<string, any> };
const records = Object.values(bundle.predictions || {}).filter((r) => Boolean(r?.prediction));
const byRegion = seatsByRegion(records);
const hubs = PARLIAMENT_REGIONS.map((region) => {
  const seats = byRegion.get(region.slug) || [];
  return { region, count: seats.length, leaders: tally(seats.map((r: any) => r.winner || null)).slice(0, 3) };
});

const breadcrumbs: Crumb[] = [{ name: "Constituencies", href: "/seats/parliament/" }];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `All ${records.length} UK parliamentary constituencies`,
    description: `Every UK parliamentary constituency with its current general election projection, by nation and region.`,
    url: `${SITE_URL}/seats/parliament/`,
    inLanguage: "en-GB",
    isPartOf: { "@id": `${SITE_URL}/#website` }
  }
];
---

<BaseLayout
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
  title="All 650 UK constituencies"
  description={`Every one of the ${records.length} UK parliamentary constituencies, by nation and region, with the projected winner and margin in each seat.`}
>
  <section class="page-hero">
    <p class="eyebrow">Browse</p>
    <h1>All {records.length} UK constituencies</h1>
    <p class="lede">
      Every UK parliamentary seat, grouped by nation and English region. Each region page lists its
      seats with the 2024 winner, the projected winner and the margin; each seat page carries the
      2024 result, the model's forecast, the sitting MP and how the model has scored on that seat before.
    </p>
    <p class="meta-row">
      <a href="/forecasts/general-election/">See the national seat projection</a>
      {" · "}
      <a href="/your-area/">Find my parliamentary constituency</a>
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">By nation and region</p>
      <h2>Twelve regions, {records.length} seats</h2>
    </div>
    <div class="council-grid">
      {hubs.map(({ region, count, leaders }) => (
        <a class="council-card" href={`/seats/parliament/${region.slug}/`}>
          <strong>{region.name}</strong>
          <span class="tier">{count} seats</span>
          <span class="tier">
            Projected: {leaders.map(([party, n], i) => (
              <>{i > 0 && ", "}<span class="party-pill" style={`background:${partyColour(party)}`}></span>{shortPartyLabel(party)} {n}</>
            ))}
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .party-pill {
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    margin-right: 0.35rem;
    vertical-align: baseline;
  }
</style>
