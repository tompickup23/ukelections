---
import CouncilDetail from "../../../components/CouncilDetail.astro";
import CouncilStub from "../../../components/CouncilStub.astro";
import { loadIdentity } from "../../../lib/predictions";
import { uncoveredCouncils } from "../../../lib/nextElections";

export async function getStaticPaths() {
  const identity = loadIdentity();
  const covered = new Set<string>();
  for (const w of identity.wards) {
    if (w.tier !== "local" && w.tier !== "mayor") continue;
    covered.add(w.council_slug);
  }
  // A council with no 7 May 2026 contest still gets a page, so a link or a
  // guessed URL for (say) Ribble Valley lands on its next election date and a
  // plain "no forecast yet" instead of a 404.
  const stubs = uncoveredCouncils(covered).map((record) => ({
    params: { council: record.slug },
    props: { stub: true },
  }));
  return [...[...covered].map((slug) => ({ params: { council: slug }, props: { stub: false } })), ...stubs];
}

const { council } = Astro.params;
const { stub } = Astro.props;
---
{stub ? <CouncilStub council={council!} /> : <CouncilDetail council={council!} />}
