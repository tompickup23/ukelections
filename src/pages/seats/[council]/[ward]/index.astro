---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import MiniMap from "../../../../components/MiniMap.astro";
import {
  loadIdentity,
  loadPredictions,
  loadHistory,
  loadLaProj,
  loadLaImd,
  loadMay7BacktestForWard,
  loadMay7ResultForWard,
  loadMay7CouncilCoverage,
  rankedShares,
  formatPct,
  partyColour,
} from "../../../../lib/predictions";
import { summariseWardResult, seatsWonLabel } from "../../../../lib/may7WardResult";
import { shortPartyLabel } from "../../../../lib/siteData";

export async function getStaticPaths() {
  const identity = loadIdentity();
  const wards = identity.wards.filter((w) => w.tier === "local" || w.tier === "mayor");
  return wards.map((w) => ({
    params: { council: w.council_slug, ward: w.ward_slug || w.gss_code || w.ballot_paper_id.split(".").slice(2, -1).join(".") },
    props: { ward: w },
  }));
}

const { ward } = Astro.props;
const predictions = loadPredictions().predictions;
const history = loadHistory();
const laProj = loadLaProj();
const laImd = loadLaImd();
const wp = predictions[ward.ballot_paper_id];

const wardKey = `${ward.tier}::${ward.council_slug}::${ward.ward_slug}`;
const historicBallots = (history.by_ward_slug || {})[wardKey] || [];
const historicResults = historicBallots
  .map((id: string) => history.by_ballot[id])
  .filter(Boolean)
  .sort((a: any, b: any) => b.election_date.localeCompare(a.election_date))
  .slice(0, 5);

const lad24 = wp?.lad24cd || null;
const ladProj = lad24 ? laProj.projections[lad24] : null;
const ladImd = lad24 ? laImd.imd[lad24] : null;

const ranked = rankedShares(wp?.prediction || null);
const top = ranked[0];

// The declared 7 May 2026 result. This is what a reader searching
// "<ward> election result" in August 2026 came for, so it leads the page
// and the forecast below it is framed as a retrospective.
const resultRow = ward.ballot_paper_id ? loadMay7ResultForWard(ward.ballot_paper_id) : null;
const result = summariseWardResult(resultRow, ward.candidate_count ?? null);
// Only consulted when this ward has no result, to say why rather than to
// leave the reader staring at a page that skips 7 May entirely.
const councilCoverage = result ? null : loadMay7CouncilCoverage(ward.council_slug);

const seatsWon = result ? seatsWonLabel(result, shortPartyLabel) : null;
// Actual shares are drawn with the same bars as the forecast so the two
// are directly comparable. Suppressed on an incomplete candidate field,
// where the denominator is wrong and the percentages would be invented.
const actualShares: Array<[string, number]> = result && !result.incomplete && resultRow?.vote_shares
  ? Object.entries(resultRow.vote_shares as Record<string, number>).sort((a, b) => b[1] - a[1])
  : [];

const tierLabel = { local: "Local council", mayor: "Mayoralty" }[ward.tier] || ward.tier;
// Titles carry the words people actually search ("<ward> <council> election
// result"). The bare "Bank Hall. Burnley" form matched no query intent, which
// cost click-through on pages that were already ranking.
const title = `${ward.ward_name}${ward.council_name ? `, ${ward.council_name}` : ""}. Election results and 2026 forecast`;
// Lead the snippet with the declared result where we have one. A forecast
// snippet on a result query reads as stale and loses the click.
const description = result
  ? `${ward.ward_name} (${ward.council_name}) result, Thursday 7 May 2026: ${seatsWon}.` +
    (result.turnoutPct != null ? ` Turnout ${formatPct(result.turnoutPct)}.` : "")
  : wp?.cancelled
    ? `${ward.ward_name} (${ward.council_name}). The 7 May 2026 election here was cancelled and postponed to a by-election.`
    : wp?.prediction
      ? `${ward.ward_name} (${ward.council_name}) on Thursday 7 May 2026. No declared result captured yet. Our forecast had ${shortPartyLabel(top[0])} on ${formatPct(top[1].pct)}.`
      : `${ward.ward_name} (${ward.council_name}) on Thursday 7 May 2026. No declared result captured yet.`;

const confidenceLabel = { high: "High", medium: "Medium", low: "Low", none: "Not available" }[wp?.confidence || "none"];

// Build neighbour Reform-share map for the mini-map delta overlay.
// Only show the overlay when we have at least 3 mapped neighbours so
// the diverging palette has something to compare. We key the map by both
// ONS code AND normalised name (with a `name:` prefix) so MiniMap can
// fall through name-based when identity-vs-WD25CD codes diverge. which
// happens for councils whose ward boundary hasn't changed since 2018
// (their WD25CD entries keep the older E05000xxx code even though
// Democracy Club's identity table assigns a newer one).
const identity = loadIdentity();
function normWardName(s: string): string {
  return s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase()
    .replace(/[,'’]/g, "").replace(/[-‐‑‒–.]/g, " ")
    .replace(/&/g, "and").replace(/\s+/g, " ").trim();
}
const neighbourSharesMap: Record<string, number> = {};
let neighbourMapSize = 0;
let focalReformShare: number | null = null;
const focalReformPct = wp?.prediction?.["Reform UK"]?.pct;
if (typeof focalReformPct === "number") focalReformShare = focalReformPct;
if (lad24 && ward.gss_code) {
  for (const w of identity.wards) {
    const wpOther = predictions[w.ballot_paper_id];
    if (!wpOther || wpOther.lad24cd !== lad24) continue;
    const sh = wpOther.prediction?.["Reform UK"]?.pct;
    if (typeof sh !== "number") continue;
    if (w.gss_code) neighbourSharesMap[w.gss_code] = sh;
    if (w.ward_name) neighbourSharesMap[`name:${normWardName(w.ward_name)}`] = sh;
    neighbourMapSize++;
  }
}
const showMiniMap = !!ward.gss_code && neighbourMapSize >= 3 && focalReformShare !== null;
const winnerParty = top?.[0];
const focalColour = winnerParty ? partyColour(winnerParty) : "var(--accent-3)";

// Per-ward 7 May 2026 backtest: did we call the winner correctly here?
// Row keys are stable Democracy Club ballot IDs (local.<council>.<ward>.<date>).
const wardBacktest = ward.ballot_paper_id ? loadMay7BacktestForWard(ward.ballot_paper_id) : null;
const btParties: Array<{ party: string; pred: number; actual: number; delta: number }> = wardBacktest
  ? [
      { party: "Reform UK", pred: wardBacktest.reform_pred || 0, actual: wardBacktest.reform_actual || 0, delta: wardBacktest.reform_delta || 0 },
      { party: "Labour", pred: wardBacktest.lab_pred || 0, actual: wardBacktest.lab_actual || 0, delta: wardBacktest.lab_delta || 0 },
      { party: "Conservative", pred: wardBacktest.con_pred || 0, actual: wardBacktest.con_actual || 0, delta: wardBacktest.con_delta || 0 },
    ].filter((r) => r.pred > 0 || r.actual > 0)
  : [];
---

<BaseLayout title={title} description={description}>
  <section class="page-hero ward-hero">
    <div class="ward-hero-text">
      <p class="eyebrow">{tierLabel} · {ward.council_name}</p>
      <h1>{ward.ward_name}</h1>
      <p class="lede">
        {ward.winner_count} {ward.winner_count === 1 ? "seat" : "seats"} contested on Thursday 7 May 2026.
        {ward.candidate_count} candidates from {ward.parties_standing.length} {ward.parties_standing.length === 1 ? "party" : "parties"}.
      </p>
      <p class="meta-row">
        {result ? "Model confidence going in" : "Confidence in the forecast"}: <strong>{confidenceLabel}</strong>
        {ward.sopn_url && (<>{" · "}<a href={ward.sopn_url}>Official Statement of Persons Nominated (PDF)</a></>)}
      </p>
    </div>
    {showMiniMap && (
      <div class="ward-hero-map">
        <MiniMap
          focalCode={ward.gss_code!}
          focalKind="ward"
          focalColour={focalColour}
          width={260}
          height={200}
          neighbourShares={neighbourSharesMap}
          focalShare={focalReformShare}
          ariaLabel={`Ward locator for ${ward.ward_name}; neighbouring wards shaded by Reform UK vote-share difference vs this ward.`}
        />
        <p class="ward-hero-map-caption">
          Neighbours shaded by <strong>Reform UK share vs this ward</strong>, red = higher, blue = lower.
        </p>
      </div>
    )}
  </section>

  {wp?.cancelled && (
    <section class="section prose-block">
      <h2>This election was cancelled</h2>
      <p>The 7 May 2026 election in this ward was cancelled, most likely because of a candidate-death postponement, so no result was declared on the day. A by-election is held on a later date.</p>
    </section>
  )}

  {result && (
    <section class="section" id="result">
      <div class="section-head">
        <p class="eyebrow">Declared result{result.isByElection ? ", by-election" : ""}</p>
        <h2>{ward.ward_name} on Thursday 7 May 2026</h2>
      </div>

      {result.incomplete && (
        <div class="backtest-callout backtest-callout--warn">
          <strong>Partial declaration.</strong>
          We hold {result.recordedCandidates} of the {result.nominatedCandidates} candidates nominated in this ward,
          so vote shares and the majority are withheld rather than calculated from an incomplete field.
          The votes below are the ones we have, not the full count.
        </div>
      )}

      <div class="status-grid result-grid">
        <article>
          <p class="status-label">{result.seats === 1 ? "Seat won by" : `${result.seats} seats won by`}</p>
          <strong>{seatsWon}</strong>
          <p>
            {result.split
              ? "The seats split between parties in this ward."
              : result.seats === 1
                ? "One seat was up for election."
                : `All ${result.seats} seats went the same way.`}
          </p>
        </article>
        {result.majority != null && (
          <article>
            <p class="status-label">Majority</p>
            <strong>{result.majority.toLocaleString("en-GB")}</strong>
            <p>
              {result.seats === 1 ? "Over" : "Last seat held over"}{" "}
              {result.majorityOverParty ? shortPartyLabel(result.majorityOverParty) : "the runner-up"}.
            </p>
          </article>
        )}
        {result.turnoutPct != null && (
          <article>
            <p class="status-label">Turnout</p>
            <strong>{formatPct(result.turnoutPct)}</strong>
            <p>
              {result.totalValidVotes != null
                ? `${result.totalValidVotes.toLocaleString("en-GB")} valid votes counted.`
                : "Share of the electorate that voted."}
            </p>
          </article>
        )}
        {result.turnoutPct == null && result.totalValidVotes != null && (
          <article>
            <p class="status-label">Votes counted</p>
            <strong>{result.totalValidVotes.toLocaleString("en-GB")}</strong>
            <p>Turnout was not published for this ward.</p>
          </article>
        )}
      </div>

      {actualShares.length > 0 && (
        <>
          <h3 class="result-subhead">Vote share on the day</h3>
          <div class="party-bars party-bars-large">
            {actualShares.map(([party, share]) => (
              <div class="bar-row">
                <span class="bar-label">{shortPartyLabel(party)}</span>
                <div class="bar-track">
                  <div class="bar-fill" style={`width:${(share * 100).toFixed(1)}%; background:${partyColour(party)}`}></div>
                </div>
                <span class="bar-value">{formatPct(share)}</span>
              </div>
            ))}
          </div>
        </>
      )}

      <h3 class="result-subhead">Every candidate</h3>
      <table class="seat-table">
        <thead>
          <tr>
            <th scope="col">Candidate</th>
            <th scope="col">Party</th>
            <th scope="col" class="num">Votes</th>
            {!result.incomplete && <th scope="col" class="num">Share</th>}
          </tr>
        </thead>
        <tbody>
          {result.candidates.map((c) => (
            <tr class={c.elected ? "candidate-elected" : undefined}>
              <td>
                {c.name || <span class="muted">Name not recorded</span>}
                {c.elected && <span class="elected-tag">Elected</span>}
              </td>
              <td><span class="party-pill" style={`background:${partyColour(c.party)}`}></span> {shortPartyLabel(c.party)}</td>
              <td class="num">{c.votes.toLocaleString("en-GB")}</td>
              {!result.incomplete && <td class="num">{c.share != null ? formatPct(c.share) : "n/a"}</td>}
            </tr>
          ))}
        </tbody>
      </table>

      <p class="caption">
        {result.spoiltBallots != null && <>{result.spoiltBallots.toLocaleString("en-GB")} ballots were rejected. </>}
        {result.provider === "council-pdf-declaration" && "Source: the returning officer's declaration of result. "}
        {result.provider === "wikipedia" && "Source: a community-maintained Wikipedia mirror, not the council's own declaration. Treat it as provisional. "}
        {result.provider === "dc-api" && "Source: Democracy Club's results database. "}
        {result.sourceUrl && result.sourceUrl.startsWith("http")
          ? <a href={result.sourceUrl}>View the source</a>
          : result.sourceArticle
            ? <a href={result.sourceArticle}>View the source</a>
            : null}
      </p>
    </section>
  )}

  {!result && !wp?.cancelled && (
    <section class="section prose-block">
      <h2>No declared result for 7 May 2026</h2>
      <p>
        This ward went to the polls on Thursday 7 May 2026, but we have not captured a declaration for it.
        {councilCoverage
          ? ` ${ward.council_name} declared ${councilCoverage.declared} of ${councilCoverage.expected} wards into our dataset, and this is one of the ${councilCoverage.missing} still outstanding.`
          : " The returning officer's declaration has not reached our dataset."}
        {" "}The forecast below is what the model expected here, kept on the page so the record stands.
      </p>
      <p class="caption">
        <a href={`/seats/${ward.council_slug}/`}>See the {ward.council_name} results we do hold</a>.
      </p>
    </section>
  )}

  {wp?.prediction && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">{result ? "Model expectation, before the vote" : "Predicted vote share"}</p>
        <h2>{result ? "What the model expected here" : "What the model expects"}</h2>
      </div>
      <div class="party-bars party-bars-large">
        {ranked.map(([party, p]) => (
          <div class="bar-row">
            <span class="bar-label">{shortPartyLabel(party)}</span>
            <div class="bar-track">
              <div class="bar-fill" style={`width:${(p.pct * 100).toFixed(1)}%; background:${partyColour(party)}`}></div>
            </div>
            <span class="bar-value">{formatPct(p.pct)}</span>
          </div>
        ))}
      </div>
      <p class="caption">
        {result
          ? "This is the forecast as it stood before polls opened, published here unedited. It is scored against the declared result above, not quietly replaced by it."
          : "Predictions are point estimates: the model's best guess, not a guarantee."}
        {" "}The "How this prediction was made" section below lists every step that shaped this forecast.
      </p>
    </section>
  )}

  {!wp?.prediction && !wp?.cancelled && (
    <section class="section prose-block">
      <h2>No prediction available</h2>
      <p>{wp?.methodology?.[0]?.description || "We don't yet have enough prior contest results in this ward to produce a forecast, typically because the ward has been redrawn since 2016."}</p>
    </section>
  )}

  {wardBacktest && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Forecast versus result</p>
        <h2>How accurate the model was here</h2>
      </div>
      <div class="backtest-callout">
        <strong>
          {wardBacktest.winner_match ? "✓ Winner called correctly" : "✗ Winner missed"}
        </strong>
       , predicted <span class="party-pill" style={`background:${partyColour(wardBacktest.predicted_winner)}`}></span> {shortPartyLabel(wardBacktest.predicted_winner)},
        actual <span class="party-pill" style={`background:${partyColour(wardBacktest.actual_winner)}`}></span> {shortPartyLabel(wardBacktest.actual_winner)}.
        <span class="backtest-detail">
          Major-party MAE: <strong>{((wardBacktest.major_party_mae || 0) * 100).toFixed(2)}pp</strong>
          across the parties below.
        </span>
      </div>
      {btParties.length > 0 && (
        <table class="seat-table">
          <thead><tr><th>Party</th><th class="num">Predicted</th><th class="num">Actual</th><th class="num">Gap</th></tr></thead>
          <tbody>
            {btParties.map((r) => (
              <tr>
                <td><span class="party-pill" style={`background:${partyColour(r.party)}`}></span> {shortPartyLabel(r.party)}</td>
                <td class="num">{(r.pred * 100).toFixed(1)}%</td>
                <td class="num">{(r.actual * 100).toFixed(1)}%</td>
                <td class="num">
                  <span class={r.delta > 0 ? "swing-up" : (r.delta < 0 ? "swing-down" : "swing-flat")}>
                    {r.delta > 0 ? "+" : ""}{(r.delta * 100).toFixed(1)}pp
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
      <p class="caption">
        Positive gap = we predicted that party would win more share than they did. See the {" "}
        <a href={`/seats/${ward.council_slug}/`}>full {ward.council_name} accuracy summary</a> or{" "}
        <a href="/past-results/">the national audit</a>.
      </p>
    </section>
  )}

  {historicResults.length > 0 && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Recent contests</p>
        <h2>{result ? "How this ward voted before 2026" : "What happened last time"}</h2>
      </div>
      <table class="seat-table">
        <thead>
          <tr><th>Date</th><th>Type</th><th>Winner</th><th>Top share</th><th>Source</th></tr>
        </thead>
        <tbody>
          {historicResults.map((r: any) => {
            const total = (r.candidates || []).reduce((s: number, c: any) => s + (c.votes || 0), 0);
            const top = [...(r.candidates || [])].sort((a, b) => (b.votes || 0) - (a.votes || 0))[0];
            const share = top && total > 0 ? top.votes / total : null;
            return (
              <tr>
                <td>{r.election_date}</td>
                <td class="muted">{r.is_by_election ? "By-election" : "Cycle"}</td>
                <td>{shortPartyLabel(top?.party_name) || "n/a"}</td>
                <td class="num">{share != null ? formatPct(share) : "n/a"}</td>
                <td>{r.source ? <a href={r.source}>declaration</a> : "n/a"}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>
  )}

  {ward.parties_standing.length > 0 && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Candidates 2026</p>
        <h2>Parties on the ballot</h2>
      </div>
      <ul class="party-list">
        {ward.parties_standing.map((p: string) => (
          <li>
            <span class="party-swatch" style={`background:${partyColour(p)}`}></span>
            {shortPartyLabel(p)}
          </li>
        ))}
      </ul>
      {ward.sopn_url && (
        <p class="caption"><a href={ward.sopn_url}>View the official Statement of Persons Nominated (PDF)</a></p>
      )}
    </section>
  )}

  {(ladProj || ladImd) && (
    <section class="section prose-block">
      <h2>How this area looks demographically</h2>
      <p>
        Figures are for {ladProj?.area_name || ward.council_name} as a whole. The same local-authority figures are used
        for every ward in the council, finer ward-level demographics will land in a future release.
      </p>
      <ul>
        {ladProj && (
          <>
            <li>White British (projected May 2026): <strong>{(ladProj.white_british_pct_projected * 100).toFixed(1)}%</strong> (Census 2021: {(ladProj.groups_2021?.white_british ?? 0).toFixed(1)}%)</li>
            <li>Asian heritage (projected May 2026): <strong>{(ladProj.asian_pct_projected * 100).toFixed(1)}%</strong> (Census 2021: {(ladProj.groups_2021?.asian ?? 0).toFixed(1)}%)</li>
          </>
        )}
        {ladImd && (
          <li>Average area deprivation decile: <strong>{ladImd.avg_imd_decile.toFixed(1)}</strong> (1 = most deprived, 10 = least)</li>
        )}
      </ul>
    </section>
  )}

  {wp?.methodology && wp.methodology.length > 0 && (
    <details class="section method-details">
      <summary>How this prediction was made</summary>
      <ol class="numbered-list">
        {wp.methodology.map((step: any) => (
          <li>
            <strong>{step.name}</strong>
            {step.description && <>. {step.description}</>}
          </li>
        ))}
      </ol>
      <p class="muted-row">
        <a href="/methodology/national-model/">Read the full local-elections methodology →</a>
      </p>
    </details>
  )}

  <section class="section">
    <p><a href={`/seats/${ward.council_slug}/`}>← Back to {ward.council_name}</a></p>
  </section>
</BaseLayout>

<style>
/* Declared-result block. Sits above the forecast, so it reuses the shared
   status-grid + party-bars language rather than inventing a second one. */
.result-grid { margin-top: var(--space-md, 1rem); }
.result-subhead {
  margin: var(--space-lg, 1.75rem) 0 var(--space-xs, 0.5rem);
  font-size: var(--text-small, 0.95rem);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted);
}
.candidate-elected { font-weight: 700; }
.elected-tag {
  display: inline-block;
  margin-left: 0.45rem;
  padding: 0.05rem 0.4rem;
  border-radius: 999px;
  background: color-mix(in oklab, var(--status-good-text) 16%, transparent);
  color: var(--status-good-text);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  vertical-align: middle;
}

.party-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.5rem; }
.party-list li { background: var(--surface); padding: 0.5rem 0.75rem; border-radius: 6px; border: 1px solid var(--border); }

.ward-hero {
  max-width: 64rem;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: var(--space-xl, 2rem);
  align-items: center;
}
.ward-hero-text { min-width: 0; }
.ward-hero-map { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-xs, 0.5rem); }
.ward-hero-map :global(.mini-map) {
  margin: 0;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--surface);
  padding: 0.5rem;
  box-shadow: var(--shadow);
}
.ward-hero-map-caption {
  margin: 0;
  max-width: 17rem;
  color: var(--muted);
  font-size: var(--text-small, 0.88rem);
  text-align: right;
  line-height: 1.4;
}
@media (max-width: 820px) {
  .ward-hero { grid-template-columns: 1fr; }
  .ward-hero-map { align-items: flex-start; }
  .ward-hero-map-caption { text-align: left; max-width: 100%; }
}
</style>
