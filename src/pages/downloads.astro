---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadDownloads, OUTPUT_LICENCE } from "../lib/downloads";
import { prettyElectionDate } from "../lib/byElections";
const files = loadDownloads();
---
<BaseLayout title="Election data downloads" description={`Download ${files.length} published UK Elections data files, with recorded dates, formats and reuse terms.`} breadcrumbs={[{ name: "Downloads", href: "/downloads/" }]}>
  <section class="page-hero">
    <p class="eyebrow">Open data</p>
    <h1>Election data downloads</h1>
    <p class="lede">{files.length} published files covering polling inputs, forecasts and historical audits. Dates below are the timestamps recorded in the files, not today's date or a promise that every input is current.</p>
  </section>
  <section class="section">
    <h2>Dates and licence</h2>
    <p>UK Elections' original outputs use <a href={OUTPUT_LICENCE}>Creative Commons Attribution 4.0 (CC BY 4.0)</a>, the licence declared in our Dataset metadata. Credit UK Elections, link to the file and retain its date, source notes and uncertainty. Third party source material retains its original rights and attribution requirements; see <a href="/sources/">Sources</a>. A download does not extend a source's reuse permissions.</p>
    <p>For CSV and Markdown exports, the date comes from the companion JSON. If a file has no recorded timestamp, its date is left blank with a note. A forecast's generation date is separate from the date of any later result recorded in it.</p>
    <div class="table-scroll" role="region" aria-label="Published data downloads" tabindex="0">
      <table class="seat-table">
        <thead><tr><th>File</th><th>Format</th><th>Recorded date</th><th>Licence for original output</th></tr></thead>
        <tbody>{files.map(file => <tr>
          <td><a href={file.href}>{file.label}</a><br /><small>{file.path}</small></td>
          <td>{file.format}</td>
          <td>{file.date ? <><time datetime={file.date}>{prettyElectionDate(file.date.slice(0, 10))}</time><br /><small>{file.dateBasis}</small></> : <span>Date not recorded in file</span>}</td>
          <td><a href={file.licence}>CC BY 4.0</a><br /><small>Upstream rights retained</small></td>
        </tr>)}</tbody>
      </table>
    </div>
  </section>
</BaseLayout>
