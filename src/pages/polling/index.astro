---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildDataset, type Crumb } from "../../lib/seo";
import { SITE_URL } from "../../lib/site";
import PartyBars from "../../components/PartyBars.astro";
import PartyTrendChart from "../../components/PartyTrendChart.astro";
import { partyColour } from "../../lib/predictions";
import { shortPartyLabel } from "../../lib/siteData";
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
import {
  UK_WESTMINSTER_2026_APRIL_AVERAGE,
  WELSH_2026_APRIL_AVERAGE,
  SCOTTISH_2026_APRIL_AVERAGE,
  UK_WESTMINSTER_2024_GE_RESULT,
} from "../../lib/nationalPolling.js";
import { countOverrides, listOverrides } from "../../lib/restoreBritain";

// Live polling override + ledger. Both written by scripts/refresh-polling.mjs.
function readJsonIfExists(rel: string): any | null {
  const p = resolve(process.cwd(), rel);
  if (!existsSync(p)) return null;
  try {
    return JSON.parse(readFileSync(p, "utf8"));
  } catch {
    return null;
  }
}

const overrideFile = readJsonIfExists("data/polling/override.json");
const ledger: any[] = readJsonIfExists("data/polling/ledger.json") || [];

const ukSnapshot = UK_WESTMINSTER_2026_APRIL_AVERAGE;
const welshSnapshot = WELSH_2026_APRIL_AVERAGE;
const scottishSnapshot = SCOTTISH_2026_APRIL_AVERAGE;
const ge2024 = UK_WESTMINSTER_2024_GE_RESULT;

type ShareRow = { party: string; share: number; vsGe2024?: number };
function rankShares(shares: Record<string, number>, baseline?: Record<string, number>): ShareRow[] {
  return Object.entries(shares)
    .filter(([, s]) => s > 0.001)
    .sort((a, b) => b[1] - a[1])
    .map(([party, share]) => ({
      party,
      share,
      vsGe2024: baseline ? share - (baseline[party] || 0) : undefined,
    }));
}

const ukRows = rankShares(ukSnapshot.shares, ge2024.shares);
const welshRows = rankShares(welshSnapshot.shares);
const scottishRows = rankShares(scottishSnapshot.shares);

// Ledger trend: show every refresh snapshot in reverse-chronological order.
type LedgerRow = { date: string; polls_used: number; shares: Record<string, number> };
const ledgerRows: LedgerRow[] = (ledger || [])
  .map((e: any) => {
    const uk = e?.sources?.uk_westminster;
    return uk?.shares
      ? {
          date: e.generated_at,
          polls_used: uk.polls_used || 0,
          shares: uk.shares,
        }
      : null;
  })
  .filter((r): r is LedgerRow => r != null)
  .reverse();

const ledgerParties = ["Reform UK", "Labour", "Conservative", "Green Party", "Liberal Democrats"];

function pct(x: number | undefined | null): string {
  if (x == null) return "n/a";
  return `${(x * 100).toFixed(1)}%`;
}

const ukMeta = ukSnapshot._meta || {};
const overlay = ukMeta.restore_britain_overlay || null;
const ukSourceSummary = overlay
  ? `${ukMeta.source || ukMeta.label || "Wikipedia 14-day rolling average"} · plus Restore Britain overlay (${pct(overlay.share)}, ${overlay.source?.split(".")[0]?.trim()})`
  : ukMeta.source || ukMeta.label || "Wikipedia 14-day rolling average";
const breadcrumbs: Crumb[] = [{ name: "Polling", href: "/polling/" }];
const structuredData = [
  buildDataset({
    name: "UK Westminster voting intention, rolling polling average",
    description:
      "The named-pollster Westminster voting-intention average that feeds the UK Elections forecast, with every poll, its fieldwork window and the pollster behind it.",
    url: `${SITE_URL}/polling/`,
    spatialCoverage: "United Kingdom",
    variableMeasured: ["Vote intention share by party", "Fieldwork dates", "Pollster", "Sample size"],
    keywords: ["opinion polls", "voting intention", "Westminster polling", "poll of polls"]
  })
];
---
<BaseLayout
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
  title="UK polling. Current Westminster average and how we use it"
  description={`Where our forecast's national polling input comes from. Current Westminster rolling average, the Restore Britain overlay, plus every refresh on the ledger.`}
>
  <section class="page-hero">
    <p class="eyebrow">Polling transparency</p>
    <h1>The numbers driving the forecast</h1>
    <p class="lede">
      Every UK Elections forecast applies a swing from the 2024 general-election result toward
      the latest Westminster polling. This page shows exactly what polling we're using right now,
      where it comes from, and how often it refreshes.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">UK Westminster vote intention, current</p>
      <h2>What the polls say today</h2>
    </div>
    <PartyBars
      large={true}
      rows={ukRows.slice(0, 8).map((r) => ({
        party: r.party,
        pct: r.share,
        annotation: r.vsGe2024 !== undefined
          ? `${r.vsGe2024 > 0 ? "+" : ""}${(r.vsGe2024 * 100).toFixed(1)}pp`
          : null,
        annotationDirection: r.vsGe2024 == null ? "flat" : r.vsGe2024 > 0 ? "up" : r.vsGe2024 < 0 ? "down" : "flat",
      }))}
    />
    <p class="caption">
      Coloured number is the change from the 4 July 2024 general-election result.
      Source: <strong>{ukSourceSummary}</strong>{ukMeta.fieldwork ? <>, fieldwork {ukMeta.fieldwork}</> : null}.
      {ukMeta.source_url && (
        <>{" "}· <a href={ukMeta.source_url} rel="external">Wikipedia source page</a>.</>
      )}
    </p>
  </section>

  {overlay && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Restore Britain overlay</p>
        <h2>How Restore Britain enters the numbers</h2>
      </div>
      <div class="backtest-callout">
        <strong>Restore Britain {pct(overlay.share)}, applied as a national overlay.</strong>
        <span class="backtest-detail">
          Since June 2026 Wikipedia's polling table carries a dedicated Restore Britain column,
          but only some pollsters prompt for the party; the rest leave it inside "Others". Our
          overlay is the mean of the polls that report RB separately, subtracted from "Other" so
          the total still sums to 100%. The per-seat parser at
          <code>scripts/fetch-rb-annotations.mjs</code> scans Wikipedia constituency pages for
          tabulated RB results; where it finds one, the per-seat share replaces the national
          overlay for that constituency.
        </span>
      </div>
      <p class="caption">
        Overlay source: {overlay.source}. Retrieved {overlay.retrieved_at}.
        {countOverrides() > 0 ? (
          <> · Per-seat overrides currently active for <strong>{countOverrides()}</strong> constituencies.</>
        ) : (
          <> · No per-seat overrides yet; run <code>node scripts/fetch-rb-annotations.mjs</code> to refresh.</>
        )}
      </p>
      {countOverrides() > 0 && (
        <table class="seat-table" style="margin-top:var(--space-md)">
          <thead><tr><th>PCON</th><th class="num">RB share</th><th>Source</th></tr></thead>
          <tbody>
            {listOverrides().map((o) => (
              <tr>
                <td><code>{o.pcon24cd}</code></td>
                <td class="num">{(o.share * 100).toFixed(1)}%</td>
                <td>
                  {o.wikipedia
                    ? <a href={o.wikipedia} rel="external">{o.source}</a>
                    : <span>{o.source}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  )}

  {ledgerRows.length > 1 && (
    <section class="section">
      <div class="section-head">
        <p class="eyebrow">Refresh history</p>
        <h2>What the rolling average has done</h2>
      </div>
      <PartyTrendChart
        snapshots={ledgerRows.slice().reverse().map((r) => ({
          date: r.date,
          shares: r.shares,
          polls: r.polls_used,
        }))}
        parties={ledgerParties}
      />
      <p>
        Every successful refresh of the polling parser writes a snapshot to the ledger. The line
        chart above shows each party's share over time; the table below has the exact numbers.
        For the full picture, <a href="/polling/trends/">every individual poll plotted over time, with
        pollster house effects →</a>
      </p>
      <table class="seat-table">
        <thead>
          <tr>
            <th>Refresh</th>
            <th class="num">Polls used</th>
            {ledgerParties.map((p) => <th class="num">{shortPartyLabel(p)}</th>)}
          </tr>
        </thead>
        <tbody>
          {ledgerRows.map((row) => (
            <tr>
              <td>{row.date.split("T")[0]}</td>
              <td class="num">{row.polls_used}</td>
              {ledgerParties.map((p) => (
                <td class="num">{pct(row.shares[p])}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      <p class="caption">
        Movement between rows is real polling drift, not model noise. The parser averages every UK
        Westminster poll within a 14-day window per snapshot.
      </p>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Devolved snapshots · elections concluded</p>
      <h2>Welsh + Scottish: final pre-election snapshots</h2>
    </div>
    <p>
      The <a href="/forecasts/senedd-2026/">Senedd</a> and
      <a href="/forecasts/holyrood-2026/">Holyrood</a> elections were held on 7 May 2026:
      Plaid Cymru now leads a minority Welsh government under Rhun ap Iorwerth with Green support,
      and the SNP won a fifth consecutive Scottish term with John Swinney continuing as First
      Minister. No pollster has published voting intention for the next devolved elections yet,
      so the table below is frozen at the final pre-election averages our forecasts used. It will
      pick up again when post-election fieldwork appears.
    </p>
    <table class="seat-table">
      <thead>
        <tr>
          <th>Country</th>
          <th>Source</th>
          <th>Fieldwork</th>
          <th>Top party</th>
          <th class="num">Top share</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Wales</td>
          <td class="muted">{welshSnapshot._meta?.source || welshSnapshot._meta?.label || "n/a"}</td>
          <td class="muted">{welshSnapshot._meta?.fieldwork || "n/a"}</td>
          <td>
            <span class="party-pill" style={`background:${partyColour(welshRows[0]?.party || "")}`}></span>
            {shortPartyLabel(welshRows[0]?.party || "n/a")}
          </td>
          <td class="num">{pct(welshRows[0]?.share)}</td>
        </tr>
        <tr>
          <td>Scotland</td>
          <td class="muted">{scottishSnapshot._meta?.source || scottishSnapshot._meta?.label || "n/a"}</td>
          <td class="muted">{scottishSnapshot._meta?.fieldwork || "n/a"}</td>
          <td>
            <span class="party-pill" style={`background:${partyColour(scottishRows[0]?.party || "")}`}></span>
            {shortPartyLabel(scottishRows[0]?.party || "n/a")}
          </td>
          <td class="num">{pct(scottishRows[0]?.share)}</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">How it works</p>
      <h2>From poll table to seat forecast</h2>
    </div>
    <ol class="numbered-list">
      <li>
        <strong>Scrape.</strong> Daily, <code>scripts/refresh-polling.mjs</code> pulls the first
        wikitable from Wikipedia's UK Westminster polling page and parses every poll published in
        the last 14 days. The Welsh and Scottish sources are frozen at their final pre-election
        snapshots since the 7 May 2026 devolved elections.
      </li>
      <li>
        <strong>Average.</strong> Each party's share is the mean across those polls. The snapshot
        is written to <code>data/polling/override.json</code>; a copy lands in <code>ledger.json</code>.
      </li>
      <li>
        <strong>Overlay.</strong> Restore Britain is averaged over the polls that report it as a
        separate column and subtracted from "Other", so the total still sums to 100%.
      </li>
      <li>
        <strong>Swing.</strong> The seat forecast computes (current share − 2024 share) per party
        and applies a dampened version of that swing on top of each constituency's 2024 result.
      </li>
      <li>
        <strong>Allocate.</strong> The party with the most predicted votes in each constituency
        wins it. Seat tallies + national share roll up into <code>summary.json</code>.
      </li>
    </ol>
    <p class="muted-row">
      <a href="/methodology/">Full methodology →</a>
      · <a href="/forecasts/general-election/">Current general-election forecast →</a>
      {overrideFile?.generated_at && (
        <>{" "}· Polling last refreshed <strong>{overrideFile.generated_at.split("T")[0]}</strong>.</>
      )}
    </p>
  </section>
</BaseLayout>
