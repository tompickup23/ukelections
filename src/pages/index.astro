---
import BaseLayout from "../layouts/BaseLayout.astro";
import CommonsHorseshoe from "../components/CommonsHorseshoe.astro";
import HeroClock from "../components/HeroClock.astro";
import PartyBars from "../components/PartyBars.astro";
import RaceBar from "../components/RaceBar.astro";
import { loadGeSummary } from "../lib/predictions";
import {
  loadGeHeadline,
  loadMay7Headline,
  loadHomepageContest,
  loadDeclarationCheckedCount,
  shortPartyLabel,
} from "../lib/siteData";
import { PARLIAMENT_REGIONS } from "../lib/parliamentRegions";
import { councilByElectionWeek, isDeclared, loadLocalContests } from "../lib/byElections";
import { partyColour } from "../lib/predictions";

const nextContest = loadHomepageContest();
const ge = loadGeHeadline();
const geSummary = loadGeSummary();
const may7 = loadMay7Headline();

// The same week the /by-elections/this-week/ page reports: polled in the seven
// days to the build, and polling in the seven after.
const week = councilByElectionWeek(loadLocalContests());
const weekDeclared = week.held.filter(isDeclared).length;
// A "too close to call" forecast named nobody, so it is not counted either way.
const weekGraded = week.held.filter((c) => c.forecast && !c.forecast.too_close_to_call
  && typeof c.result?.grading?.call_correct === "boolean"
  && c.result.grading.graded_against === "forecast_as_published");
const weekRight = weekGraded.filter((c) => c.result.grading.call_correct).length;
const WEEK_ROWS = 6;
const dayMonth = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" });
const winnerLabel = (r: any) =>
  r.winner_party === "Other" && r.winner_party_name ? r.winner_party_name : shortPartyLabel(r.winner_party);
const declarationChecked = loadDeclarationCheckedCount();

const topNationalShares = ge.national_vote_share.slice(0, 6);
const HALFWAY = 326;
const leader = ge.seat_tallies[0];
const seatTallies = (geSummary.seat_tallies_by_party || {}) as Record<string, number>;

const localPollingDay = nextContest?.kind === "local_by_elections" ? nextContest : null;
const heroContest = nextContest && nextContest.kind !== "local_by_elections" ? nextContest : null;
const heroClassification = heroContest?.classification ?? null;

function classificationLabel(c: string | null | undefined): string {
  switch (c) {
    case "toss-up": return "Toss-up";
    case "lean": return "Lean";
    case "likely": return "Likely";
    case "safe": return "Safe";
    default: return c || "TBC";
  }
}

// Names whichever contest is actually next. The previous version hardcoded
// "the Makerfield parliamentary by-election" in the branch that fires for ANY
// upcoming contest, so it would have described the wrong election the moment
// one appeared.
const description = localPollingDay
  ? `${localPollingDay.headline}. Forecasts, results and backtests for UK elections.`
  : heroContest
  ? `${heroContest.short_name} on ${heroContest.polling_day_label}, the rolling general-election forecast for every one of the 650 UK constituencies, and an honest backtest of every prediction we've ever published.`
  : "The rolling general-election forecast for every one of the 650 UK constituencies, plus an honest backtest of every prediction we've ever published.";
---

<BaseLayout
  title="UK Elections. Every constituency, every forecast, every backtest"
  description={description}
>
  <div class="home-hero">
    <section class="home-masthead">
      <h1>UK election forecasts, results and backtests</h1>
      <p class="lede">
        Every constituency, every council and every by-election, each with the model's
        record for that place published alongside the forecast.
      </p>
      <form id="home-lookup" class="home-lookup" action="/your-area/" autocomplete="off">
        <label for="home-lookup-input">Is there an election where you live?</label>
        <div class="home-lookup-row">
          <input id="home-lookup-input" type="search" placeholder="Postcode, e.g. BB12 6PG" autocapitalize="characters" />
          <button type="submit">Find my elections</button>
        </div>
        <p class="home-lookup-note">
          Your postcode goes from your browser to <a href="https://postcodes.io/">Postcodes.io</a> to find your ward and constituency. UK Elections does not receive or store it. <a href="/privacy/">Privacy details</a>.
        </p>
      </form>
    </section>

    <section class="home-week" aria-labelledby="home-week-title">
      <p class="eyebrow">Council by-elections this week</p>
      <h2 id="home-week-title">
        {localPollingDay
          ? localPollingDay.headline
          : week.held.length > 0
            ? `${week.held.length} council by-election${week.held.length === 1 ? "" : "s"} polled in the last seven days`
            : "No council by-elections this week"}
      </h2>
      {week.held.length > 0 && (
        <>
          <p class="home-week-summary">
            Polled in the last seven days: {week.held.length}, {weekDeclared} declared.
            {weekGraded.length > 0 && ` Our pre-poll forecasts named the winner in ${weekRight} of ${weekGraded.length}.`}
          </p>
          <ul class="home-week-list">
            {week.held.slice(0, WEEK_ROWS).map((c) => {
              const r = c.result || c.declaration;
              const g = c.result?.grading;
              const f = c.forecast;
              return (
                <li>
                  <a href={`/by-elections/local/${c.slug}/`}>
                    <span class="ward">{c.contest.ward_name}</span>
                    <span class="council">{c.contest.council_name}</span>
                  </a>
                  <span class="status">
                    {isDeclared(c) && r ? (
                      <span class="party-chip" style={`--chip:${partyColour(r.winner_party)}`}>{winnerLabel(r)}</span>
                    ) : (
                      <span class="muted">Result awaited</span>
                    )}
                    {f && !f.too_close_to_call && typeof g?.call_correct === "boolean" && g.graded_against === "forecast_as_published"
                      ? <span class="call">{g.call_correct ? "Forecast called it" : "Forecast missed"}</span>
                      : f?.too_close_to_call ? <span class="call">Forecast: too close to call</span> : null}
                  </span>
                </li>
              );
            })}
          </ul>
        </>
      )}
      {week.next.length > 0 && (
        <>
          <p class="home-week-summary">Polling in the next seven days: {week.next.length}.</p>
          <ul class="home-week-list">
            {week.next.slice(0, WEEK_ROWS).map((c) => (
              <li>
                <a href={`/by-elections/local/${c.slug}/`}>
                  <span class="ward">{c.contest.ward_name}</span>
                  <span class="council">{c.contest.council_name}</span>
                </a>
                <span class="status">
                  <span>{dayMonth(c.contest.polling_day)}</span>
                  <span class="call">{c.field.candidate_count} candidate{c.field.candidate_count === 1 ? "" : "s"}</span>
                </span>
              </li>
            ))}
          </ul>
        </>
      )}
      <p><a href="/by-elections/this-week/">Every result and forecast this week →</a></p>
      <p class="caption">Sources: each council's declaration where we have read it, Democracy Club contest records otherwise.</p>
    </section>

    {heroContest && (
      <section class="hero hero-byelection-v2">
        <div class="hero-byelection-grid">
          <header class="hero-byelection-head">
            <p class="eyebrow">Polling day · {heroContest.polling_day_label}</p>
            <h2 class="hero-byelection-title">{heroContest.short_name}</h2>
            <p class="lede">
              {heroClassification === "toss-up" && heroContest.headline_winner && heroContest.headline_runner_up && heroContest.margin_pp != null
                ? <><strong>{heroContest.margin_pp.toFixed(1)}pp {classificationLabel(heroClassification).toLowerCase()}</strong> between {shortPartyLabel(heroContest.headline_winner)} and {shortPartyLabel(heroContest.headline_runner_up)}. Well inside the model's confidence interval.</>
                : heroContest.headline_summary}
            </p>
          </header>

          <HeroClock
            value={heroContest.days_until}
            label={heroContest.days_until === 1 ? "day to polling" : "days to polling"}
            ariaLabel="Days until polling"
          />
        </div>

        {heroContest.central_shares.length > 0 && (
          <RaceBar
            shares={heroContest.central_shares}
            candidates={heroContest.key_candidates}
          />
        )}

        <div class="action-row" aria-label="Primary actions">
          <a class="button primary" href={heroContest.href}>Read the full {heroContest.short_name}</a>
          <a class="button" href="/forecasts/general-election/">UK general election forecast</a>
          <a class="button" href="/polling/">Track the polls</a>
        </div>
      </section>
    )}

    <section class="home-projection-copy">
      <div class="section-head">
        <p class="eyebrow">If a UK general election were held today</p>
        <h2>{leader ? `${shortPartyLabel(leader.party)} projected to win ${leader.seats} of ${ge.total_seats} seats` : "Seat-by-seat forecast for every UK constituency"}</h2>
      </div>
      <p class="lede">
        All <strong>{ge.total_seats.toLocaleString()}</strong> UK parliamentary constituencies, refreshed from the latest
        named-pollster Westminster polling average. A majority needs <strong>{HALFWAY}</strong> seats.
        {leader && leader.seats >= HALFWAY
          ? ` ${shortPartyLabel(leader.party)} clears the line with ${(leader.seats - HALFWAY).toLocaleString()} seats to spare.`
          : leader ? ` ${shortPartyLabel(leader.party)} is ${Math.abs(HALFWAY - leader.seats).toLocaleString()} seats short of an overall majority.` : ""}
      </p>
    </section>
    <div class="home-hero-chart">
      <CommonsHorseshoe seats={seatTallies} total={650} majority={HALFWAY} />
    </div>
  </div>

  <section class="section">

    <h3 style="margin-top:var(--space-lg)">Projected national vote share</h3>
    <PartyBars rows={topNationalShares.map(s => ({ party: s.party, pct: s.share }))} />

    <p class="caption">
      This is our own output, not the polling. It is the turnout-weighted average of all 650 constituency
      projections, so it differs from the raw polling average that feeds the model. For the polling itself,
      including the fieldwork window and the pollsters used, see <a href="/polling/">polling transparency</a>.
    </p>
    <p class="muted-row">
      <a href="/forecasts/general-election/">See every constituency →</a>
      · <a href="/your-area/">Look up my constituency →</a>
    </p>
    <nav class="region-list" aria-label="Constituencies by region">
      <h3>Constituencies by region</h3>
      <ul>
        {PARLIAMENT_REGIONS.map((r) => (
          <li><a href={`/seats/parliament/${r.slug}/`}>{r.name}</a></li>
        ))}
      </ul>
    </nav>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">Our record</p>
      <h2>Every forecast is locked before polling day and scored afterwards, misses included</h2>
    </div>
    <p class="lede">
      On 7 May 2026 we scored <strong>{may7.ballots_evaluated.toLocaleString("en-GB")}</strong> ward forecasts against the count.
      The forecast locked 11 days before polling named the leading party in
      <strong>{(may7.prereg_winner_accuracy * 100).toFixed(1)}%</strong> of them; the version on the site on polling day,
      <strong>{(may7.live_winner_accuracy * 100).toFixed(1)}%</strong>.
      {declarationChecked > 0 && <> Since then, <strong>{declarationChecked}</strong> council by-election results have been read from the returning officer's own declaration.</>}
    </p>
    <p class="muted-row">
      Each constituency and council page carries its own forecast-vs-actual record so you can see exactly how the model behaved <em>for that place</em>, not just on average.
    </p>
    <p class="muted-row">
      <a href="/data-quality/">The full record, with definitions →</a>
      · <a href="/by-elections/post-mortem/">By-election forecasts scored →</a>
      · <a href="/data-quality/ge-backtest/">2024 general election backtest →</a>
      · <a href="/data-quality/2024-backtest/">2024 local backtest →</a>
    </p>
    <p class="caption">
      Sources: May 2026 scorecard (<a href="/data/transparency/may-2026-postaudit-2026-05-10.json">data file</a>, generated 10 May 2026);
      by-election results ledger, rows marked as read from a council declaration.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="eyebrow">What you can do here</p>
      <h2>Built for voters, journalists, and campaigners alike.</h2>
    </div>
    <div class="feature-list">
      <article>
        <h3>Find your constituency or ward</h3>
        <p>Type a UK postcode, town, or council. We'll show your specific contest: candidates, parties, our prediction, and our track record for that place.</p>
        <p><a href="/your-area/">Find my elections →</a></p>
      </article>
      <article>
        <h3>The councils that voted on 7 May 2026</h3>
        <p>Each council's 7 May 2026 result, who controls it now, and its next election date where we have verified it from the council's electoral change order or notices.</p>
        <p><a href="/councils/">All councils →</a></p>
      </article>
      <article>
        <h3>When is the next election?</h3>
        <p>Council by-elections, the 6 May 2027 council and mayoral elections, the general election deadline, the Senedd and Holyrood, each with its legal source, and what we do not cover.</p>
        <p><a href="/elections/">Election calendar →</a></p>
      </article>
      <article>
        <h3>Check our working</h3>
        <p>Every forecast carries the model steps that produced it. The full method, every backtest, the source data, and open downloads sit on <a href="/methodology/">the about page</a>.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  // The postcode travels in the URL fragment, which a browser never sends to
  // the server, so it reaches no log. Without JavaScript the form opens the
  // lookup page with nothing attached.
  const form = document.getElementById("home-lookup") as HTMLFormElement | null;
  const input = document.getElementById("home-lookup-input") as HTMLInputElement | null;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const value = (input?.value || "").trim();
    window.location.assign(value ? `/your-area/#q=${encodeURIComponent(value)}` : "/your-area/");
  });
</script>

<style>
  .home-lookup { margin-top: var(--space-lg); max-width: 56ch; }
  .home-lookup label { display: block; font-weight: 700; color: var(--ink); }
  .home-lookup-row { display: flex; gap: var(--space-sm); margin-top: var(--space-sm); }
  .home-lookup-row input {
    flex: 1; min-width: 0; padding: var(--space-md); font-size: var(--text-body);
    border: 1px solid var(--border); border-radius: 6px; background: var(--surface); color: var(--ink);
  }
  .home-lookup-row button {
    padding: var(--space-md) var(--space-lg); font-weight: 600; background: var(--accent-3); color: var(--bg);
    border: 0; border-radius: 6px; cursor: pointer;
  }
  .home-lookup-note { margin: var(--space-sm) 0 0; color: var(--ink-soft); font-size: var(--text-small); line-height: 1.5; }
  .home-week { border-left: 3px solid var(--border); padding-left: var(--space-lg); }
  .home-week h2 { font-family: var(--font-display); font-size: var(--text-h2); line-height: 1.2; margin: 0; }
  .home-week p { margin: var(--space-sm) 0 0; }
  .home-week-summary { color: var(--muted); font-size: var(--text-small); }
  .home-week-list { list-style: none; padding: 0; margin: var(--space-sm) 0 0; }
  .home-week-list li {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-md); align-items: start;
    padding-block: var(--space-xs); border-top: 1px solid var(--border);
  }
  .home-week-list .council, .home-week-list .call, .home-week-list .muted { color: var(--muted); font-size: var(--text-small); }
  .home-week-list .council, .home-week-list .call { display: block; }
  .home-week-list .status { text-align: right; }
  .home-week-list .ward { font-weight: 600; }
  .home-week-list .party-chip { border-left: 4px solid var(--chip, var(--border)); padding-left: var(--space-xs); font-weight: 600; }
  @media (max-width: 40rem) {
    .home-lookup-row { flex-direction: column; }
    .home-lookup-row button { width: 100%; }
  }
  @media (min-width: 1100px) {
    .home-week { grid-column: 1; }
  }
  .region-list ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
