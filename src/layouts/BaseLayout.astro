---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_SOCIAL_IMAGE_PATH,
  SITE_NAME,
  SITE_URL,
  normalisePageTitle,
  type StructuredDataNode
} from "../lib/site";
import { hasOgCard, ogSlugForPathname } from "../lib/ogEntries";
import { buildBreadcrumbList, type Crumb } from "../lib/seo";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  structuredData?: StructuredDataNode[];
  mainClass?: string;
  /**
   * Trail below the site root, last item being this page. Renders the visible
   * breadcrumb nav and the BreadcrumbList that Google shows in place of the raw
   * URL in a result. Omit on the homepage and on top-level pages, where a trail
   * would be a single self-referential crumb.
   */
  breadcrumbs?: Crumb[];
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_SOCIAL_IMAGE_PATH,
  noIndex = false,
  structuredData: pageStructuredData = [],
  mainClass,
  breadcrumbs = []
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(SITE_URL);
const pathname = Astro.url.pathname || "/";
const pageTitle = normalisePageTitle(title);
const canonicalUrl = new URL(pathname, siteOrigin).toString();
// Per-page dynamic OG image (Satori-rendered at build time when
// BUILD_OG=1). Map the page path → /og/<path>.png, with the homepage
// mapping to /og/index.png — but ONLY for pages this build actually
// rendered a card for. hasOgCard() reads the same entry list the
// endpoint enumerates, so the two can't drift.
//
// Anything else (the ~3,000 ward pages, and every page at all when
// BUILD_OG is unset) gets the static PNG card. There is no
// client-side fallback for og:image — a crawler fetches the URL once
// and takes what it gets — and Cloudflare Pages answers a missing
// path with the HTML 404 body under a 200, so advertising a card that
// was never rendered hands crawlers text/html and breaks the preview
// outright. Only advertise what exists.
const dynamicOgPath = hasOgCard(pathname) ? `/og/${ogSlugForPathname(pathname)}.png` : null;
const explicitImage = image && image !== DEFAULT_SOCIAL_IMAGE_PATH;
const socialImageRaw = explicitImage ? image : (dynamicOgPath ?? DEFAULT_SOCIAL_IMAGE_PATH);
const socialImageUrl = /^https?:\/\//.test(socialImageRaw) ? socialImageRaw : new URL(socialImageRaw, siteOrigin).toString();
const robotsContent = noIndex ? "noindex,follow,max-image-preview:large" : "index,follow,max-image-preview:large";
const socialImageMime = socialImageUrl.endsWith(".svg") ? "image/svg+xml" : socialImageUrl.endsWith(".png") ? "image/png" : undefined;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: pageTitle,
    description,
    url: canonicalUrl,
    inLanguage: "en-GB",
    isPartOf: {
      "@id": `${SITE_URL}/#website`
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: socialImageUrl
    }
  },
  ...(pathname === "/"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": `${SITE_URL}/#website`,
          url: SITE_URL,
          name: SITE_NAME,
          description: DEFAULT_DESCRIPTION,
          inLanguage: "en-GB",
          publisher: {
            "@id": `${SITE_URL}/#organization`
          }
        },
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "@id": `${SITE_URL}/#organization`,
          name: SITE_NAME,
          url: SITE_URL,
          logo: {
            "@type": "ImageObject",
            url: new URL("/favicon.svg", siteOrigin).toString()
          }
        }
      ]
    : []),
  ...(breadcrumbs.length ? [buildBreadcrumbList(breadcrumbs)] : []),
  ...pageStructuredData
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script is:inline>
      // Sync theme before paint to avoid FOUC. Saved preference (localStorage)
      // wins; otherwise default to system preference.
      (function () {
        try {
          var saved = localStorage.getItem("uke-theme");
          var theme =
            saved === "dark" || saved === "light"
              ? saved
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (_) {
          /* localStorage disabled. leave CSS media query to handle it */
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1317" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    {socialImageMime && <meta property="og:image:type" content={socialImageMime} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${pageTitle} - ukelections.co.uk`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="UK Elections updates" href="/rss.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {structuredData.map((item) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
    ))}
    <!-- Cloudflare Web Analytics (cookieless, no consent banner required) -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "35a3e43f8c8346e19b0e7f04b149f0c6"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" class:list={["site-main", mainClass]} tabindex="-1" data-pagefind-body>
      {breadcrumbs.length > 0 && (
        <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
          <ol>
            <li><a href="/">Home</a></li>
            {breadcrumbs.map((crumb, index) => (
              <li>
                {index === breadcrumbs.length - 1 ? (
                  <span aria-current="page">{crumb.name}</span>
                ) : (
                  <a href={crumb.href}>{crumb.name}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner footer-inner--stacked">
        <div class="footer-meta">
          <p>
            UK Elections covers all 650 UK parliamentary constituencies and publishes
            forecasts, results and boundaries for the councils, wards and contests in its coverage. An independent research project by Tom Pickup,
            a Lancashire county councillor and Reform UK member; no party, council, candidate or
            election authority has any say over what appears here. Every input is public data,
            the same model rules apply to every party, the assumptions and code are published in
            full, and each forecast is published with its backtest against the actual result.
          </p>
          <nav aria-label="Footer">
            <a href="/sources/">Sources</a>
            <a href="/methodology/">Methodology</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/accessibility/">Accessibility</a>
            <a href="https://www.facebook.com/ukelectionspredictions" rel="me noopener">Facebook</a>
          </nav>
        </div>
        <!--email_off-->
        <p class="footer-contact">
          Contact: <a href="mailto:info@ukelections.co.uk">info@ukelections.co.uk</a>, or use the
          <a href="/contact/">contact page</a>. Corrections are applied to the page and noted.
        </p>
        <!--/email_off-->
      </div>
    </footer>

    <style is:global>
      /* Breadcrumbs. Visible trail and the crawl path back up from the ~3,900
         ward, council and seat pages, which previously linked upward only from
         a line at the very bottom of the page (or, on seat pages, not at all). */
      .breadcrumbs {
        margin: 0 0 1.25rem;
        font-size: 0.82rem;
        line-height: 1.4;
      }
      .breadcrumbs ol {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.3rem 0.5rem;
        margin: 0;
        padding: 0;
      }
      .breadcrumbs li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
      }
      .breadcrumbs li + li::before {
        content: "/";
        color: var(--muted, #5b6b80);
        opacity: 0.6;
      }
      .breadcrumbs a {
        color: var(--muted, #5b6b80);
        text-decoration: none;
      }
      .breadcrumbs a:hover {
        color: var(--accent);
        text-decoration: underline;
      }
      .breadcrumbs [aria-current="page"] {
        color: var(--ink, #111827);
        font-weight: 600;
      }
      .footer-inner--stacked {
        display: block !important;
      }
      .footer-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .footer-meta p { max-width: 48rem; margin: 0; color: var(--muted); line-height: 1.5; }
      .footer-meta nav { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .footer-meta nav a { color: var(--ink); font-weight: 600; text-decoration: none; }
      .footer-contact {
        margin: 1.25rem 0 0;
        color: var(--muted);
        line-height: 1.5;
      }
      .footer-contact a {
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
      }
      .footer-contact a:hover {
        text-decoration: underline;
      }
    </style>
  </body>
</html>
