---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_SOCIAL_IMAGE_PATH,
  SITE_NAME,
  SITE_URL,
  normalisePageTitle,
  type StructuredDataNode
} from "../lib/site";
import { hasOgCard, ogSlugForPathname } from "../lib/ogEntries";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  structuredData?: StructuredDataNode[];
  mainClass?: string;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_SOCIAL_IMAGE_PATH,
  noIndex = false,
  structuredData: pageStructuredData = [],
  mainClass
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(SITE_URL);
const pathname = Astro.url.pathname || "/";
const pageTitle = normalisePageTitle(title);
const canonicalUrl = new URL(pathname, siteOrigin).toString();
// Per-page dynamic OG image (Satori-rendered at build time when
// BUILD_OG=1). Map the page path → /og/<path>.png, with the homepage
// mapping to /og/index.png — but ONLY for pages this build actually
// rendered a card for. hasOgCard() reads the same entry list the
// endpoint enumerates, so the two can't drift.
//
// Anything else (the ~3,000 ward pages, and every page at all when
// BUILD_OG is unset) gets the static PNG card. There is no
// client-side fallback for og:image — a crawler fetches the URL once
// and takes what it gets — and Cloudflare Pages answers a missing
// path with the HTML 404 body under a 200, so advertising a card that
// was never rendered hands crawlers text/html and breaks the preview
// outright. Only advertise what exists.
const dynamicOgPath = hasOgCard(pathname) ? `/og/${ogSlugForPathname(pathname)}.png` : null;
const explicitImage = image && image !== DEFAULT_SOCIAL_IMAGE_PATH;
const socialImageRaw = explicitImage ? image : (dynamicOgPath ?? DEFAULT_SOCIAL_IMAGE_PATH);
const socialImageUrl = /^https?:\/\//.test(socialImageRaw) ? socialImageRaw : new URL(socialImageRaw, siteOrigin).toString();
const robotsContent = noIndex ? "noindex,follow,max-image-preview:large" : "index,follow,max-image-preview:large";
const socialImageMime = socialImageUrl.endsWith(".svg") ? "image/svg+xml" : socialImageUrl.endsWith(".png") ? "image/png" : undefined;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: pageTitle,
    description,
    url: canonicalUrl,
    inLanguage: "en-GB",
    isPartOf: {
      "@id": `${SITE_URL}/#website`
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: socialImageUrl
    }
  },
  ...(pathname === "/"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": `${SITE_URL}/#website`,
          url: SITE_URL,
          name: SITE_NAME,
          description: DEFAULT_DESCRIPTION,
          inLanguage: "en-GB",
          publisher: {
            "@id": `${SITE_URL}/#organization`
          }
        },
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "@id": `${SITE_URL}/#organization`,
          name: SITE_NAME,
          url: SITE_URL,
          logo: {
            "@type": "ImageObject",
            url: new URL("/favicon.svg", siteOrigin).toString()
          }
        }
      ]
    : []),
  ...pageStructuredData
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script is:inline>
      // Sync theme before paint to avoid FOUC. Saved preference (localStorage)
      // wins; otherwise default to system preference.
      (function () {
        try {
          var saved = localStorage.getItem("uke-theme");
          var theme =
            saved === "dark" || saved === "light"
              ? saved
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (_) {
          /* localStorage disabled. leave CSS media query to handle it */
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1317" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    {socialImageMime && <meta property="og:image:type" content={socialImageMime} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${pageTitle} - ukelections.co.uk`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="UK Elections updates" href="/rss.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {structuredData.map((item) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
    ))}
    <!-- Cloudflare Web Analytics (cookieless, no consent banner required) -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "35a3e43f8c8346e19b0e7f04b149f0c6"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content" class:list={["site-main", mainClass]} tabindex="-1" data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner footer-inner--stacked">
        <section class="footer-sisters" aria-labelledby="footer-sisters-heading">
          <h2 id="footer-sisters-heading" class="footer-sisters-eyebrow">Sister sites</h2>
          <div class="footer-sisters-grid">
            <a class="footer-sister-card footer-sister-card--ukd" href="https://ukdemographics.co.uk" rel="noopener">
              <span class="footer-sister-tile" aria-hidden="true">UKD</span>
              <span class="footer-sister-body">
                <span class="footer-sister-name">ukdemographics.co.uk</span>
                <span class="footer-sister-tagline">Population projections for every UK community</span>
              </span>
              <span class="footer-sister-arrow" aria-hidden="true">&#8599;</span>
            </a>
            <a class="footer-sister-card footer-sister-card--as" href="https://asylumstats.co.uk" rel="noopener">
              <span class="footer-sister-tile" aria-hidden="true">AS</span>
              <span class="footer-sister-body">
                <span class="footer-sister-name">asylumstats.co.uk</span>
                <span class="footer-sister-tagline">Asylum spending, dispersal &amp; route data</span>
              </span>
              <span class="footer-sister-arrow" aria-hidden="true">&#8599;</span>
            </a>
            <a class="footer-sister-card footer-sister-card--ukfh" href="https://ukfoodhygiene.co.uk" rel="noopener">
              <span class="footer-sister-tile" aria-hidden="true">FH</span>
              <span class="footer-sister-body">
                <span class="footer-sister-name">ukfoodhygiene.co.uk</span>
                <span class="footer-sister-tagline">Food hygiene ratings for every UK establishment</span>
              </span>
              <span class="footer-sister-arrow" aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </section>
        <div class="footer-meta">
          <p>
            UK Elections is an independent election intelligence project. It is not affiliated
            with any political party, council, candidate, or election authority.
          </p>
          <nav aria-label="Footer">
            <a href="/sources/">Sources</a>
            <a href="/methodology/">Methodology</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/accessibility/">Accessibility</a>
            <a href="https://www.facebook.com/ukelectionspredictions" rel="me noopener">Facebook</a>
          </nav>
        </div>
        <p class="footer-contact">
          Contact: <a href="mailto:info@ukelections.co.uk">info@ukelections.co.uk</a>, or use the
          <a href="/contact/">contact page</a>. Corrections are applied to the page and noted.
        </p>
      </div>
    </footer>

    <style is:global>
      .footer-inner--stacked {
        display: block !important;
      }
      .footer-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .footer-meta p { max-width: 48rem; margin: 0; color: var(--muted); line-height: 1.5; }
      .footer-meta nav { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .footer-meta nav a { color: var(--ink); font-weight: 600; text-decoration: none; }
      .footer-sisters {
        margin: 0 0 1.5rem;
      }
      .footer-sisters-eyebrow {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted, #5b6b80);
        margin: 0 0 0.65rem;
      }
      .footer-sisters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
        gap: 0.85rem;
      }
      .footer-contact {
        margin: 1.25rem 0 0;
        color: var(--muted);
        line-height: 1.5;
      }
      .footer-contact a {
        color: var(--accent);
        font-weight: 600;
        text-decoration: none;
      }
      .footer-contact a:hover {
        text-decoration: underline;
      }
      .footer-sister-card {
        display: grid;
        grid-template-columns: 44px 1fr auto;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem 1rem;
        border-radius: 14px;
        text-decoration: none;
        border: 1px solid var(--card-border-soft, var(--border, #d4dce6));
        background: var(--card-bg-soft, var(--surface, #ffffff));
        transition: transform 180ms, border-color 180ms, box-shadow 180ms;
      }
      .footer-sister-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
      }
      .footer-sister-tile {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        color: #ffffff;
      }
      .footer-sister-body {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        min-width: 0;
      }
      .footer-sister-name {
        font-weight: 600;
        font-size: 0.92rem;
        color: var(--ink, #111827);
        line-height: 1.2;
      }
      .footer-sister-tagline {
        font-size: 0.78rem;
        color: var(--muted, #5b6b80);
        line-height: 1.3;
      }
      .footer-sister-arrow {
        font-size: 1rem;
        color: var(--muted, #5b6b80);
        align-self: start;
        margin-top: 2px;
      }
      /* Tile colours are each sister's estate accent-deep, from
         BRAND-SYSTEM-2026-08-23.md, solid fill, no glow. White on each tile
         computes over 4.5:1 (UKD 7.90, AS 7.69, UKFH 7.81). */
      .footer-sister-card--ukd .footer-sister-tile {
        background: #4338ca;
      }
      .footer-sister-card--ukd:hover {
        border-color: #4338ca;
      }
      .footer-sister-card--as .footer-sister-tile {
        background: #2f5773;
      }
      .footer-sister-card--as:hover {
        border-color: #2f5773;
      }
      .footer-sister-card--ukfh .footer-sister-tile {
        background: #1f5c4a;
      }
      .footer-sister-card--ukfh:hover {
        border-color: #1f5c4a;
      }
      :root[data-theme="dark"] .footer-sister-card:hover {
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .footer-sister-card:hover {
          box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }
      }
      @media (max-width: 640px) {
        .footer-sisters-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
